---
import SectionHeading from './SectionHeading.astro';

interface Pregunta {
  pregunta: string;
  respuesta: string;
}
interface Props {
  titulo?: string;
  eyebrow?: string;
  items: Pregunta[];
}
const { titulo = 'Preguntas frecuentes', eyebrow = 'FAQ', items } = Astro.props;
---

<section class="superficie-papel py-24 md:py-32" id="faq">
  <div class="container-carta">
    <SectionHeading eyebrow={eyebrow} titulo={titulo} centrado ornamento />
    <div class="mt-12 space-y-3" data-reveal-group>
      {items.map((item) => (
        <details class="group rounded-card border border-hairline bg-white/60 transition-colors open:bg-white open:shadow-[0_18px_45px_-32px_rgb(27_31_19/0.5)]">
          <summary class="font-display flex cursor-pointer list-none items-center justify-between gap-4 px-7 py-5 text-base font-semibold text-brand-950 [&::-webkit-details-marker]:hidden">
            {item.pregunta}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="shrink-0 text-accent-600 transition-transform group-open:rotate-45" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </summary>
          <p class="px-7 pb-6 text-sm leading-relaxed text-brand-600 text-pretty">{item.respuesta}</p>
        </details>
      ))}
    </div>
  </div>
</section>
