---
/**
 * Reserva de mesa: personas + fecha + hora (+ nombre) → mensaje de WhatsApp.
 * Sin backend: el restaurante confirma la reserva respondiendo el chat.
 */
const HORAS = [
  '11:30', '12:00', '12:30', '13:00', '13:30', '14:00',
  '18:00', '18:30', '19:00', '19:30', '20:00', '20:30',
];

function formatoHora(hhmm: string): string {
  const [h, m] = hhmm.split(':').map(Number);
  const sufijo = h >= 12 ? 'p. m.' : 'a. m.';
  const hora12 = h % 12 === 0 ? 12 : h % 12;
  return `${hora12}:${String(m).padStart(2, '0')} ${sufijo}`;
}
---

<section class="bg-brand-950 py-20" id="reservas">
  <div class="container-site grid items-center gap-12 lg:grid-cols-2">
    <div data-reveal>
      <span class="eyebrow text-accent-400">Reservas</span>
      <h2 class="mt-2 text-3xl font-bold text-white md:text-4xl">Aparta tu mesa en la terraza</h2>
      <p class="mt-4 max-w-md leading-relaxed text-brand-200">
        Elige cuántos son, el día y la hora. Te confirmamos la disponibilidad
        por WhatsApp en minutos — sin llamadas ni apps.
      </p>
      <ul class="mt-6 space-y-3 text-sm text-brand-200">
        <li class="flex items-center gap-3">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-500/15 text-accent-400">✓</span>
          Mesas en terraza y salón interior
        </li>
        <li class="flex items-center gap-3">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-500/15 text-accent-400">✓</span>
          Grupos grandes: escríbenos y armamos tu espacio
        </li>
        <li class="flex items-center gap-3">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-500/15 text-accent-400">✓</span>
          Confirmación por WhatsApp, sin anticipos
        </li>
      </ul>
    </div>

    <form id="form-reserva" class="rounded-card space-y-4 bg-white p-7 shadow-xl md:p-8" data-reveal>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="reserva-personas" class="mb-1.5 block text-sm font-semibold text-brand-800">Personas</label>
          <select id="reserva-personas" class="w-full rounded-md border border-brand-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-accent-500">
            {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (
              <option value={String(n)} selected={n === 2}>{n} {n === 1 ? 'persona' : 'personas'}</option>
            ))}
            <option value="Más de 8">Más de 8</option>
          </select>
        </div>
        <div>
          <label for="reserva-fecha" class="mb-1.5 block text-sm font-semibold text-brand-800">Fecha</label>
          <input id="reserva-fecha" type="date" required class="w-full rounded-md border border-brand-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-accent-500" />
        </div>
      </div>
      <div>
        <label for="reserva-hora" class="mb-1.5 block text-sm font-semibold text-brand-800">Hora</label>
        <select id="reserva-hora" class="w-full rounded-md border border-brand-200 bg-white px-3 py-2.5 text-sm outline-none focus:border-accent-500">
          {HORAS.map((h) => (
            <option value={formatoHora(h)}>{formatoHora(h)}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="reserva-nombre" class="mb-1.5 block text-sm font-semibold text-brand-800">A nombre de</label>
        <input id="reserva-nombre" type="text" required placeholder="Tu nombre" class="w-full rounded-md border border-brand-200 px-3 py-2.5 text-sm outline-none focus:border-accent-500" />
      </div>
      <button type="submit" class="btn btn-whatsapp w-full">Reservar por WhatsApp</button>
      <p class="text-center text-xs text-brand-400">Tu reserva queda confirmada cuando te respondamos por WhatsApp.</p>
    </form>
  </div>
</section>

<script>
  import { NEGOCIO, waLink } from '../scripts/site';

  const form = document.getElementById('form-reserva') as HTMLFormElement | null;
  const fecha = document.getElementById('reserva-fecha') as HTMLInputElement | null;

  // No permitir fechas pasadas
  if (fecha) {
    const hoy = new Date();
    const yyyy = hoy.getFullYear();
    const mm = String(hoy.getMonth() + 1).padStart(2, '0');
    const dd = String(hoy.getDate()).padStart(2, '0');
    fecha.min = `${yyyy}-${mm}-${dd}`;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const personas = (document.getElementById('reserva-personas') as HTMLSelectElement).value;
    const hora = (document.getElementById('reserva-hora') as HTMLSelectElement).value;
    const nombre = (document.getElementById('reserva-nombre') as HTMLInputElement).value.trim();

    // "2026-07-25" → "sábado, 25 de julio" (T12:00 evita saltos de zona horaria)
    const fechaLegible = new Date(`${fecha?.value}T12:00:00`).toLocaleDateString('es-CO', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
    });

    const mensaje = [
      `Hola ${NEGOCIO.nombre} 👋, quiero reservar una mesa:`,
      '',
      `👥 Personas: ${personas}`,
      `📅 Fecha: ${fechaLegible}`,
      `🕐 Hora: ${hora}`,
      `A nombre de: ${nombre}`,
    ].join('\n');

    window.open(waLink(mensaje), '_blank', 'noopener');
  });
</script>
