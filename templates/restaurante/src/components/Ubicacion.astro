---
/**
 * Ubicación + horarios + mapa. Los horarios salen de src/data/horarios.json
 * (editables desde /admin) y la dirección de negocio.json.
 */
import SectionHeading from './SectionHeading.astro';
import EstadoAbierto from './EstadoAbierto.astro';
import { NEGOCIO } from '../scripts/site';
import { HORARIOS, formatoHora, type DiaHorario } from '../scripts/horario';

const ORDEN: { clave: keyof typeof HORARIOS; nombre: string }[] = [
  { clave: 'lunes', nombre: 'Lunes' },
  { clave: 'martes', nombre: 'Martes' },
  { clave: 'miercoles', nombre: 'Miércoles' },
  { clave: 'jueves', nombre: 'Jueves' },
  { clave: 'viernes', nombre: 'Viernes' },
  { clave: 'sabado', nombre: 'Sábado' },
  { clave: 'domingo', nombre: 'Domingo' },
];

const rango = (h: DiaHorario) => `${formatoHora(h.apertura)} – ${formatoHora(h.cierre)}`;
const mapaSrc = `https://maps.google.com/maps?q=${encodeURIComponent(`${NEGOCIO.direccion}, ${NEGOCIO.ciudad}`)}&z=16&output=embed`;
---

<section class="superficie-crema textura-papel py-24 md:py-32" id="ubicacion">
  <div class="container-site">
    <SectionHeading
      eyebrow="Visítanos"
      titulo="Dónde estamos y cuándo abrimos"
      descripcion="Estamos en el corazón de Cabecera. Ven por tu mesa o pide a domicilio."
      centrado
      ornamento
    />

    <div class="mt-14 grid gap-8 lg:grid-cols-2">
      <div class="marco-foto border border-hairline bg-white p-2" data-reveal>
        <iframe
          src={mapaSrc}
          title={`Mapa: cómo llegar a ${NEGOCIO.nombre}`}
          class="h-full min-h-80 w-full rounded-xl border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <div
        class="rounded-card space-y-6 border border-hairline bg-white/85 p-8 shadow-[0_18px_45px_-32px_rgb(27_31_19/0.5)] md:p-9"
        data-reveal
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="titular-wonk text-2xl font-semibold text-brand-950">Horario de atención</h3>
          <EstadoAbierto variante="claro" />
        </div>

        <table class="w-full text-sm">
          <tbody>
            {ORDEN.map(({ clave, nombre }) => {
              const h = HORARIOS[clave];
              return (
                <tr class="border-b border-hairline/70 last:border-0">
                  <th scope="row" class="py-3 text-left font-semibold text-brand-800">{nombre}</th>
                  <td class={`py-3 text-right tabular-nums ${h.abierto ? 'text-brand-600' : 'font-semibold text-red-600'}`}>
                    {h.abierto ? rango(h) : 'Cerrado'}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>

        <div class="space-y-1 border-t border-hairline pt-6 text-sm">
          <p class="font-display text-lg font-semibold text-brand-950">
            {NEGOCIO.direccion}, {NEGOCIO.ciudad}
          </p>
          <p class="text-brand-600">
            <a href={`tel:${NEGOCIO.telefono.replace(/\s/g, '')}`} class="hover:text-accent-600">{NEGOCIO.telefono}</a>
            · <a href={`mailto:${NEGOCIO.correo}`} class="hover:text-accent-600">{NEGOCIO.correo}</a>
          </p>
        </div>
        <a href={NEGOCIO.mapsUrl} target="_blank" rel="noopener" class="btn btn-outline w-full">
          Cómo llegar (Google Maps)
        </a>
      </div>
    </div>
  </div>
</section>
