---
/**
 * Tarjeta de plato en dos variantes visuales (misma funcionalidad):
 *
 *   variante="grid"  → la foto manda: retrato alto, nombre y precio sobre
 *                      papel. Se usa en los destacados de la portada.
 *   variante="carta" → fila de carta impresa: foto cuadrada, nombre unido al
 *                      precio con línea de puntos y filete inferior. Se usa
 *                      en la página /menu.
 *
 * En ambas, el botón lleva [data-agregar] + data-id/nombre/precio/foto, que es
 * lo que escucha el script de CarritoDrawer. Los platos con disponible=false
 * se muestran agotados (no desaparecen del menú).
 */
import { precioCOP } from '../scripts/site';

type Etiqueta = 'vegetariano' | 'picante' | 'nuevo';

interface Props {
  id: string;
  nombre: string;
  descripcion: string;
  precio: number;
  foto: string;
  etiquetas?: Etiqueta[];
  disponible?: boolean;
  /** true en las primeras tarjetas visibles (carga la foto con prioridad). */
  prioridad?: boolean;
  /** Presentación: retrato para portada, fila de carta para el menú. */
  variante?: 'grid' | 'carta';
}

const {
  id,
  nombre,
  descripcion,
  precio,
  foto,
  etiquetas = [],
  disponible = true,
  prioridad = false,
  variante = 'grid',
} = Astro.props;

const ETIQUETAS: Record<Etiqueta, { texto: string; clase: string }> = {
  vegetariano: { texto: '🌱 Vegetariano', clase: 'text-green-800' },
  picante: { texto: '🌶 Picante', clase: 'text-red-700' },
  nuevo: { texto: '✨ Nuevo', clase: 'text-accent-700' },
};

const datosBoton = {
  'data-agregar': true,
  'data-id': id,
  'data-nombre': nombre,
  'data-precio': precio,
  'data-foto': foto,
};
---

{variante === 'carta' ? (
  /* ───────── Fila de carta impresa ───────── */
  <article
    class={`group relative flex gap-5 py-7 sm:gap-7 ${disponible ? '' : 'opacity-70'}`}
    data-plato
  >
    <div class="marco-foto relative size-24 shrink-0 overflow-hidden bg-brand-100 sm:size-32 md:size-36">
      <img
        src={foto}
        alt={nombre}
        loading={prioridad ? 'eager' : 'lazy'}
        decoding="async"
        class={`zoom-apetito h-full w-full object-cover ${disponible ? '' : 'grayscale'}`}
      />
      {!disponible && (
        <span class="absolute inset-0 flex items-center justify-center bg-brand-950/55 px-1 text-center text-[0.6rem] font-bold tracking-[0.16em] text-white uppercase">
          Agotado
        </span>
      )}
    </div>

    <div class="flex min-w-0 flex-1 flex-col">
      <div class="flex flex-wrap items-end gap-x-2 gap-y-1">
        <h3 class="font-display text-lg leading-tight font-semibold text-brand-950 sm:text-xl">
          {nombre}
        </h3>
        <span class="guia-puntos hidden sm:block" aria-hidden="true"></span>
        <p class="precio-carta ml-auto text-lg sm:ml-0 sm:text-xl">{precioCOP(precio)}</p>
      </div>

      <p class="mt-2 max-w-prose text-sm leading-relaxed text-brand-600">{descripcion}</p>

      <div class="mt-3.5 flex flex-wrap items-center gap-x-3 gap-y-2">
        {etiquetas.map((e) => (
          <span class={`etiqueta-plato ${ETIQUETAS[e].clase}`}>{ETIQUETAS[e].texto}</span>
        ))}
        <div class="ml-auto">
          {disponible ? (
            <button
              type="button"
              {...datosBoton}
              class="btn btn-primary min-w-[8.5rem] !px-4 !py-2 text-sm"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Agregar
            </button>
          ) : (
            <span class="inline-flex min-w-[8.5rem] items-center justify-center gap-1.5 rounded-btn border border-hairline bg-paper-warm px-4 py-2 text-sm font-semibold text-brand-400 italic">
              Agotado hoy
            </span>
          )}
        </div>
      </div>
    </div>
  </article>
) : (
  /* ───────── Retrato con la foto de protagonista ───────── */
  <article
    class={`group flex flex-col overflow-hidden rounded-card bg-white shadow-[0_18px_45px_-28px_rgb(27_31_19/0.55)] ring-1 ring-hairline/70 transition-shadow duration-500 hover:shadow-[0_28px_60px_-25px_rgb(27_31_19/0.5)] ${disponible ? '' : 'opacity-75'}`}
    data-plato
  >
    <div class="relative aspect-[4/5] overflow-hidden bg-brand-100">
      <img
        src={foto}
        alt={nombre}
        loading={prioridad ? 'eager' : 'lazy'}
        decoding="async"
        class={`zoom-apetito h-full w-full object-cover ${disponible ? '' : 'grayscale'}`}
      />
      <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-brand-950/70 to-transparent"></div>

      {!disponible && (
        <span class="absolute top-4 left-4 rounded-full bg-brand-950/85 px-3.5 py-1.5 text-[0.65rem] font-bold tracking-[0.16em] text-white uppercase backdrop-blur-sm">
          Agotado hoy
        </span>
      )}
      {etiquetas.length > 0 && (
        <div class="absolute bottom-4 left-4 flex flex-wrap gap-1.5">
          {etiquetas.map((e) => (
            <span class={`etiqueta-plato bg-white/95 backdrop-blur-sm ${ETIQUETAS[e].clase}`}>
              {ETIQUETAS[e].texto}
            </span>
          ))}
        </div>
      )}
    </div>

    <div class="flex flex-1 flex-col p-6">
      <div class="flex items-end gap-2">
        <h3 class="font-display text-xl leading-tight font-semibold text-brand-950">{nombre}</h3>
        <span class="guia-puntos" aria-hidden="true"></span>
        <p class="precio-carta text-xl">{precioCOP(precio)}</p>
      </div>
      <p class="mt-2.5 text-sm leading-relaxed text-brand-600">{descripcion}</p>

      <div class="mt-5 pt-1">
        {disponible ? (
          <button type="button" {...datosBoton} class="btn btn-primary w-full !py-2.5 text-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Agregar al pedido
          </button>
        ) : (
          <button
            type="button"
            disabled
            class="btn w-full cursor-not-allowed border border-hairline bg-paper-warm !py-2.5 text-sm text-brand-400 italic"
          >
            Agotado hoy
          </button>
        )}
      </div>
    </div>
  </article>
)}
