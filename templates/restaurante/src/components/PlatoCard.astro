---
/**
 * Tarjeta de plato: foto, nombre, descripción, precio, etiquetas y botón
 * "Agregar al pedido" (lo escucha el script de CarritoDrawer vía [data-agregar]).
 * Los platos con disponible=false se muestran deshabilitados ("Agotado"),
 * no desaparecen del menú.
 */
import { precioCOP } from '../scripts/site';

type Etiqueta = 'vegetariano' | 'picante' | 'nuevo';

interface Props {
  id: string;
  nombre: string;
  descripcion: string;
  precio: number;
  foto: string;
  etiquetas?: Etiqueta[];
  disponible?: boolean;
  /** true en las primeras tarjetas visibles (carga la foto con prioridad). */
  prioridad?: boolean;
}

const {
  id,
  nombre,
  descripcion,
  precio,
  foto,
  etiquetas = [],
  disponible = true,
  prioridad = false,
} = Astro.props;

const ETIQUETAS: Record<Etiqueta, { texto: string; clase: string }> = {
  vegetariano: { texto: '🌱 Vegetariano', clase: 'bg-green-100 text-green-800' },
  picante: { texto: '🌶 Picante', clase: 'bg-red-100 text-red-700' },
  nuevo: { texto: '✨ Nuevo', clase: 'bg-accent-100 text-accent-800' },
};
---

<article
  class={`rounded-card group flex flex-col overflow-hidden bg-white shadow-sm ring-1 ring-brand-100 ${disponible ? '' : 'opacity-75'}`}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-brand-100">
    <img
      src={foto}
      alt={nombre}
      loading={prioridad ? 'eager' : 'lazy'}
      decoding="async"
      class={`h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 ${disponible ? '' : 'grayscale'}`}
    />
    {!disponible && (
      <span class="absolute top-3 left-3 rounded-full bg-brand-950/85 px-3 py-1 text-xs font-bold text-white">
        Agotado hoy
      </span>
    )}
    {etiquetas.length > 0 && (
      <div class="absolute top-3 right-3 flex flex-wrap justify-end gap-1.5">
        {etiquetas.map((e) => (
          <span class={`rounded-full px-2.5 py-1 text-[0.68rem] font-bold ${ETIQUETAS[e].clase}`}>
            {ETIQUETAS[e].texto}
          </span>
        ))}
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-lg leading-snug font-semibold text-brand-950">{nombre}</h3>
      <p class="font-display shrink-0 text-lg font-bold text-accent-600">{precioCOP(precio)}</p>
    </div>
    <p class="mt-1.5 text-sm leading-relaxed text-brand-600">{descripcion}</p>

    <div class="mt-4 pt-1">
      {disponible ? (
        <button
          type="button"
          data-agregar
          data-id={id}
          data-nombre={nombre}
          data-precio={precio}
          class="btn btn-primary w-full !py-2.5 text-sm"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Agregar al pedido
        </button>
      ) : (
        <button
          type="button"
          disabled
          class="btn w-full cursor-not-allowed bg-brand-100 !py-2.5 text-sm text-brand-400"
        >
          Agotado
        </button>
      )}
    </div>
  </div>
</article>
