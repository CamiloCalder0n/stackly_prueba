---
import SectionHeading from './SectionHeading.astro';
import { NEGOCIO, waLink } from '../scripts/site';

interface Props {
  titulo?: string;
  descripcion?: string;
}
const {
  titulo = 'Visítanos o escríbenos',
  descripcion = 'Estamos para atenderte. Encuéntranos o déjanos un mensaje.',
} = Astro.props;
---

<section class="bg-brand-50 py-20" id="contacto">
  <div class="container-site">
    <SectionHeading eyebrow="Contacto" titulo={titulo} descripcion={descripcion} centrado />

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      <!-- Datos del negocio -->
      <div class="rounded-card space-y-5 bg-white p-8 ring-1 ring-brand-100" data-reveal>
        {[
          { label: 'Dirección', valor: `${NEGOCIO.direccion}, ${NEGOCIO.ciudad}`, href: NEGOCIO.mapsUrl },
          { label: 'Horario', valor: NEGOCIO.horario },
          { label: 'Teléfono', valor: NEGOCIO.telefono, href: `tel:${NEGOCIO.telefono.replace(/\s/g, '')}` },
          { label: 'Correo', valor: NEGOCIO.correo, href: `mailto:${NEGOCIO.correo}` },
        ].map((fila) => (
          <div>
            <p class="text-xs font-bold tracking-widest text-brand-400 uppercase">{fila.label}</p>
            {fila.href ? (
              <a href={fila.href} target={fila.href.startsWith('http') ? '_blank' : undefined} class="mt-1 block text-sm font-medium text-brand-800 hover:text-accent-600">
                {fila.valor}
              </a>
            ) : (
              <p class="mt-1 text-sm font-medium text-brand-800">{fila.valor}</p>
            )}
          </div>
        ))}
        <a href={waLink(`Hola, vengo de la página de ${NEGOCIO.nombre} y quiero más información.`)} target="_blank" rel="noopener" class="btn btn-whatsapp w-full">
          Escribir por WhatsApp
        </a>
      </div>

      <!-- Formulario (listo para Netlify Forms; ver README) -->
      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="rounded-card space-y-4 bg-white p-8 ring-1 ring-brand-100"
        data-reveal
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hidden"><label>No llenar: <input name="bot-field" /></label></p>

        <div>
          <label for="nombre" class="mb-1.5 block text-sm font-semibold text-brand-800">Nombre</label>
          <input id="nombre" name="nombre" type="text" required class="w-full rounded-md border border-brand-200 px-4 py-2.5 text-sm outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-100" placeholder="Tu nombre" />
        </div>
        <div>
          <label for="correo" class="mb-1.5 block text-sm font-semibold text-brand-800">Correo</label>
          <input id="correo" name="correo" type="email" required class="w-full rounded-md border border-brand-200 px-4 py-2.5 text-sm outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-100" placeholder="tu@correo.com" />
        </div>
        <div>
          <label for="mensaje" class="mb-1.5 block text-sm font-semibold text-brand-800">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="4" required class="w-full resize-none rounded-md border border-brand-200 px-4 py-2.5 text-sm outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-100" placeholder="Cuéntanos qué necesitas"></textarea>
        </div>
        <button type="submit" class="btn btn-primary w-full">Enviar mensaje</button>
        <p class="text-center text-xs text-brand-400">El formulario funciona automáticamente al desplegar en Netlify.</p>
      </form>
    </div>
  </div>
</section>
