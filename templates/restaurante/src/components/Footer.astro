---
import { NEGOCIO } from '../scripts/site';

interface Props {
  links?: { label: string; href: string }[];
}
const { links = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="superficie-noche text-brand-300">
  <div class="container-site grid gap-10 py-16 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2.5 text-accent-400" aria-hidden="true">
        <svg width="15" height="15" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 7.6 4.4 12 6 7.6 7.6 6 12 4.4 7.6 0 6l4.4-1.6z"/></svg>
      </div>
      <p class="titular-wonk mt-3 text-xl font-semibold text-white">{NEGOCIO.nombre}</p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed italic">{NEGOCIO.eslogan}</p>
      <div class="mt-4 flex gap-4">
        {NEGOCIO.instagram && (
          <a href={NEGOCIO.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="transition-colors hover:text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        )}
        {NEGOCIO.facebook && (
          <a href={NEGOCIO.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="transition-colors hover:text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        )}
      </div>
    </div>

    {links.length > 0 && (
      <nav aria-label="Enlaces del pie de página">
        <p class="text-[0.65rem] font-bold tracking-[0.18em] text-brand-400 uppercase">Enlaces</p>
        <ul class="mt-3 space-y-2">
          {links.map((l) => (
            <li>
              <a href={l.href} class="text-sm transition-colors hover:text-white">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div>
      <p class="text-[0.65rem] font-bold tracking-[0.18em] text-brand-400 uppercase">Contacto</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>{NEGOCIO.direccion}, {NEGOCIO.ciudad}</li>
        <li>{NEGOCIO.horario}</li>
        <li><a href={`tel:${NEGOCIO.telefono.replace(/\s/g, '')}`} class="transition-colors hover:text-white">{NEGOCIO.telefono}</a></li>
        <li><a href={`mailto:${NEGOCIO.correo}`} class="transition-colors hover:text-white">{NEGOCIO.correo}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col items-center justify-between gap-2 py-5 text-xs text-brand-400 sm:flex-row">
      <p>© {year} {NEGOCIO.nombre}. Todos los derechos reservados.</p>
      <p>Hecho por <a href="https://stackly.co" class="font-semibold transition-colors hover:text-white">Stackly</a></p>
    </div>
  </div>
</footer>
