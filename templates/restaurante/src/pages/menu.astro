---
// Menú digital completo en HTML (indexable, nada de PDF).
// Sirve también como carta QR en mesa: liviana, por categorías y con
// botón "Agregar" en cada plato para pedir por WhatsApp.
//
// Dirección de arte: se lee como una carta impresa — portada fotográfica,
// encabezados de sección numerados, platos a dos columnas con guía de puntos
// hacia el precio y filetes finos en vez de tarjetas de e-commerce.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import EstadoAbierto from '../components/EstadoAbierto.astro';
import PlatoCard from '../components/PlatoCard.astro';
import Footer from '../components/Footer.astro';
import CarritoDrawer from '../components/CarritoDrawer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import { NEGOCIO } from '../scripts/site';

const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Reservas', href: '/#reservas' },
  { label: 'Ubicación', href: '/#ubicacion' },
];

const categorias = (await getCollection('categorias')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const platos = await getCollection('platos');

const secciones = categorias.map((cat) => ({
  id: cat.id,
  nombre: cat.data.nombre,
  platos: platos.filter((p) => p.data.categoria.id === cat.id),
}));

// Datos estructurados: schema.org Menu → MenuSection → MenuItem
const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `Menú de ${NEGOCIO.nombre}`,
  inLanguage: 'es-CO',
  hasMenuSection: secciones.map((s) => ({
    '@type': 'MenuSection',
    name: s.nombre,
    hasMenuItem: s.platos.map((p) => ({
      '@type': 'MenuItem',
      name: p.data.nombre,
      description: p.data.descripcion,
      image: p.data.foto,
      offers: {
        '@type': 'Offer',
        price: p.data.precio,
        priceCurrency: 'COP',
        availability: p.data.disponible
          ? 'https://schema.org/InStock'
          : 'https://schema.org/OutOfStock',
      },
    })),
  })),
};
---

<BaseLayout
  title="Menú"
  description={`Menú de ${NEGOCIO.nombre}: entradas, platos fuertes, parrilla, bebidas y postres. Precios actualizados y pedidos a domicilio por WhatsApp en ${NEGOCIO.ciudad}.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(menuSchema)} />

  <Header
    links={navLinks}
    cta="Pedir ahora"
    ctaMensaje={`Hola ${NEGOCIO.nombre} 👋, quiero hacer un pedido.`}
  />

  <!-- ══ PORTADA DE LA CARTA ══ -->
  <section class="relative flex min-h-[52vh] items-end overflow-hidden bg-brand-950">
    <div class="absolute inset-0" data-parallax="0.1">
      <img
        src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1800&q=85"
        alt="Mesa servida con varios platos de La Terraza"
        class="h-[118%] w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="absolute inset-0 bg-brand-950/55"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-brand-950 via-brand-950/60 to-brand-950/20"></div>
    <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-paper to-transparent"></div>

    <div class="container-site relative pt-28 pb-20">
      <div class="max-w-2xl" data-hero-title>
        <EstadoAbierto variante="linea" />
        <span class="eyebrow mt-7 block text-accent-300">Nuestra carta</span>
        <h1 class="titular-wonk mt-3 text-display font-semibold text-white">El menú</h1>
        <p class="mt-6 max-w-lg leading-relaxed text-brand-100/90 text-pretty">
          Todo lo que sale de nuestra cocina, con precios al día. Agrega tus
          platos y envía el pedido por WhatsApp — a domicilio o para recoger.
        </p>
      </div>
    </div>
  </section>

  <!-- ══ NAVEGACIÓN DE CATEGORÍAS (sticky + scrollspy) ══ -->
  <nav
    aria-label="Categorías del menú"
    class="sticky top-16 z-30 border-b border-hairline bg-paper/92 backdrop-blur-md"
  >
    <div class="container-site sin-barra flex gap-8 overflow-x-auto py-4" data-chips>
      {secciones.map((s, i) => (
        <a
          href={`#${s.id}`}
          data-chip={s.id}
          aria-current={i === 0 ? 'true' : undefined}
          class="relative shrink-0 pb-1 text-[0.7rem] font-bold tracking-[0.18em] whitespace-nowrap text-brand-500 uppercase transition-colors hover:text-brand-900 after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:origin-left after:scale-x-0 after:bg-accent-500 after:transition-transform after:duration-300 aria-[current]:text-brand-950 aria-[current]:after:scale-x-100"
        >
          {s.nombre}
        </a>
      ))}
    </div>
  </nav>

  <!-- ══ SECCIONES DE LA CARTA ══ -->
  <div class="superficie-papel textura-papel">
    <div class="container-site py-16 pb-32 md:py-24 md:pb-24">
      {secciones.map((s, i) => (
        <section id={s.id} class="scroll-mt-36 pt-12 first:pt-0 md:pt-20 md:first:pt-0" data-seccion-menu>
          <!-- Encabezado ornamentado de categoría -->
          <header class="flex items-end gap-5" data-reveal>
            <span class="numeral-carta text-5xl text-accent-500/35 md:text-6xl">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="min-w-0 flex-1">
              <h2 class="titular-wonk text-3xl font-semibold text-brand-950 md:text-4xl">
                {s.nombre}
              </h2>
              <p class="mt-1 text-[0.7rem] font-bold tracking-[0.18em] text-brand-400 uppercase">
                {s.platos.length} {s.platos.length === 1 ? 'plato' : 'platos'}
              </p>
            </div>
          </header>

          <div class="ornamento mt-6 mb-2" aria-hidden="true">
            <svg width="10" height="10" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 7.6 4.4 12 6 7.6 7.6 6 12 4.4 7.6 0 6l4.4-1.6z"/></svg>
          </div>

          <!-- Platos a dos columnas, separados por filetes finos -->
          <div class="grid gap-x-14 lg:grid-cols-2" data-reveal-group>
            {s.platos.map((p, j) => (
              <div class="border-b border-hairline/70">
                <PlatoCard
                  id={p.id}
                  nombre={p.data.nombre}
                  descripcion={p.data.descripcion}
                  precio={p.data.precio}
                  foto={p.data.foto}
                  etiquetas={p.data.etiquetas}
                  disponible={p.data.disponible}
                  prioridad={i === 0 && j < 2}
                  variante="carta"
                />
              </div>
            ))}
          </div>
        </section>
      ))}

      <!-- Pie de carta: detalle de impresa bien hecha -->
      <footer class="mt-20 text-center" data-reveal>
        <div class="ornamento mx-auto max-w-xs" aria-hidden="true">
          <svg width="10" height="10" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 7.6 4.4 12 6 7.6 7.6 6 12 4.4 7.6 0 6l4.4-1.6z"/></svg>
        </div>
        <p class="mt-6 text-sm leading-relaxed text-brand-500 italic">
          Todos nuestros precios están en pesos colombianos e incluyen impuestos.
          <br class="hidden sm:block" />
          Si tienes alguna alergia o restricción, cuéntanos en la nota de tu pedido.
        </p>
      </footer>
    </div>
  </div>

  <Footer links={navLinks} />
  <WhatsAppFlotante mensaje={`Hola ${NEGOCIO.nombre} 👋, tengo una pregunta sobre el menú.`} />
  <CarritoDrawer />
</BaseLayout>

<script>
  // Scrollspy: resalta el chip de la categoría visible.
  const chips = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-chip]').forEach((chip) => {
    chips.set(chip.dataset.chip || '', chip);
  });

  const tira = document.querySelector<HTMLElement>('[data-chips]');

  function activar(id: string) {
    chips.forEach((chip, clave) => {
      if (clave !== id) {
        chip.removeAttribute('aria-current');
        return;
      }
      chip.setAttribute('aria-current', 'true');
      // Mantiene visible la categoría activa dentro de la tira horizontal.
      if (tira && tira.scrollWidth > tira.clientWidth) {
        const dentro =
          chip.offsetLeft >= tira.scrollLeft &&
          chip.offsetLeft + chip.offsetWidth <= tira.scrollLeft + tira.clientWidth;
        if (!dentro) {
          tira.scrollTo({
            left: chip.offsetLeft - tira.clientWidth / 2 + chip.offsetWidth / 2,
            behavior: 'smooth',
          });
        }
      }
    });
  }

  const secciones = Array.from(document.querySelectorAll<HTMLElement>('[data-seccion-menu]'));
  const visibles = new Set<string>();
  const observer = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((en) => {
        if (en.isIntersecting) visibles.add(en.target.id);
        else visibles.delete(en.target.id);
      });
      // Activa la primera sección (en orden del documento) que esté visible
      const primera = secciones.find((s) => visibles.has(s.id));
      if (primera) activar(primera.id);
    },
    { rootMargin: '-140px 0px -40% 0px' },
  );
  secciones.forEach((s) => observer.observe(s));
</script>
