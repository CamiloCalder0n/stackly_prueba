---
interface Props {
  eyebrow?: string;
  titulo: string;
  descripcion?: string;
  /** Centra el encabezado (por defecto alineado a la izquierda). */
  centrado?: boolean;
}
const { eyebrow, titulo, descripcion, centrado = false } = Astro.props;
---

<div class={`max-w-2xl ${centrado ? 'mx-auto text-center' : ''}`} data-reveal>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="mt-2 text-3xl font-bold text-brand-950 md:text-4xl">{titulo}</h2>
  {descripcion && <p class="mt-4 text-base leading-relaxed text-brand-600">{descripcion}</p>}
</div>
