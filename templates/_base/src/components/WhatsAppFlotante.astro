---
import { waLink, NEGOCIO } from '../scripts/site';
import Icono from './Icono.astro';

interface Props {
  mensaje?: string;
}
const { mensaje = `Hola, vengo de la página de ${NEGOCIO.nombre}.` } = Astro.props;
---

<a
  href={waLink(mensaje)}
  target="_blank"
  rel="noopener"
  aria-label="Escribir por WhatsApp"
  class="fixed right-5 bottom-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-[0_8px_28px_rgba(20,18,15,0.22)] transition-transform duration-500 ease-[cubic-bezier(.22,.61,.36,1)] hover:scale-105 md:right-7 md:bottom-7"
>
  <Icono nombre="whatsapp" tamano={26} />
</a>
