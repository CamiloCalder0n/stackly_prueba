---
import { NEGOCIO } from '../scripts/site';
import Icono from './Icono.astro';

interface Props {
  links?: { label: string; href: string }[];
}
const { links = [] } = Astro.props;
const year = new Date().getFullYear();
const telLimpio = NEGOCIO.telefono.replace(/\s/g, '');
---

<footer class="border-t border-brand-200 bg-paper">
  <div class="container-wide grid gap-14 py-20 md:grid-cols-12 md:py-24">
    <div class="md:col-span-5">
      <p
        class="font-display text-2xl tracking-[0.14em] text-brand-950 uppercase"
      >
        {NEGOCIO.nombre}
      </p>
      <p class="mt-5 max-w-xs text-[0.88rem] leading-[1.9] font-light text-brand-600">
        {NEGOCIO.eslogan}. En {NEGOCIO.ciudad} desde {NEGOCIO.anoFundacion}.
      </p>
      <div class="mt-8 flex gap-4">
        {NEGOCIO.instagram && (
          <a
            href={NEGOCIO.instagram}
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
            class="flex h-10 w-10 items-center justify-center border border-brand-300 text-brand-700 transition-colors duration-500 hover:border-brand-950 hover:bg-brand-950 hover:text-white"
          >
            <Icono nombre="instagram" tamano={17} />
          </a>
        )}
        {NEGOCIO.facebook && (
          <a
            href={NEGOCIO.facebook}
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
            class="flex h-10 w-10 items-center justify-center border border-brand-300 text-brand-700 transition-colors duration-500 hover:border-brand-950 hover:bg-brand-950 hover:text-white"
          >
            <Icono nombre="facebook" tamano={17} />
          </a>
        )}
      </div>
    </div>

    {links.length > 0 && (
      <nav class="md:col-span-3" aria-label="Enlaces del pie de página">
        <p class="micro-sm text-brand-500">Explorar</p>
        <ul class="mt-6 space-y-3.5">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-[0.88rem] font-light text-brand-700 transition-colors duration-500 hover:text-accent-700"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="md:col-span-4">
      <p class="micro-sm text-brand-500">Visítanos</p>
      <ul class="mt-6 space-y-3.5 text-[0.88rem] font-light text-brand-700">
        <li>{NEGOCIO.direccion}, {NEGOCIO.ciudad}</li>
        <li>{NEGOCIO.horario}</li>
        <li>
          <a href={`tel:${telLimpio}`} class="transition-colors duration-500 hover:text-accent-700">
            {NEGOCIO.telefono}
          </a>
        </li>
        <li>
          <a
            href={`mailto:${NEGOCIO.correo}`}
            class="transition-colors duration-500 hover:text-accent-700"
          >
            {NEGOCIO.correo}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-brand-200">
    <div
      class="container-wide flex flex-col items-center justify-between gap-2 py-6 text-[0.72rem] font-light text-brand-500 sm:flex-row"
    >
      <p>© {year} {NEGOCIO.nombre}. Todos los derechos reservados.</p>
      <p>
        Hecho por
        <!-- Subrayado permanente: dentro de un párrafo, distinguir el enlace
             solo por color deja fuera a quien no percibe ese contraste. -->
        <a
          href="https://stackly.co"
          class="text-brand-800 underline underline-offset-2 transition-colors duration-500 hover:text-accent-700"
        >
          Stackly
        </a>
      </p>
    </div>
  </div>
</footer>
