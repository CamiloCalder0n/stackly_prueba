---
import { NEGOCIO, waLink } from '../scripts/site';
import Icono from './Icono.astro';

interface Props {
  links: { label: string; href: string }[];
  /** Texto del botón de acción del header. */
  cta?: string;
  /** Mensaje de WhatsApp que dispara el CTA. */
  ctaMensaje?: string;
}

const {
  links,
  cta = 'Escríbenos',
  ctaMensaje = `Hola, vengo de la página de ${NEGOCIO.nombre} y quiero más información.`,
} = Astro.props;
---

<header
  class="sticky top-0 z-50 border-b border-brand-200 bg-surface/85 backdrop-blur-md"
  id="cabecera"
>
  <div class="container-wide flex h-[4.5rem] items-center justify-between gap-6">
    <a
      href="/"
      class="font-display text-[1.35rem] tracking-[0.14em] text-brand-950 uppercase"
    >
      {NEGOCIO.nombre}
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navegación principal">
      {links.map((l) => (
        <a
          href={l.href}
          class="micro-sm text-brand-600 transition-colors duration-500 hover:text-accent-700"
        >
          {l.label}
        </a>
      ))}
      <a
        href={waLink(ctaMensaje)}
        target="_blank"
        rel="noopener"
        class="btn btn-primary !px-5 !py-2.5"
      >
        <Icono nombre="whatsapp" tamano={14} />
        {cta}
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="-mr-2 flex h-11 w-11 items-center justify-center text-brand-950 lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-movil"
    >
      <Icono nombre="menu" tamano={22} />
    </button>
  </div>
</header>

<!-- Menú móvil a pantalla completa: los enlaces en tipografía de titular,
     que es el gesto de navegación de una maison y además se toca mejor. -->
<div
  id="menu-movil"
  class="fixed inset-0 z-[60] hidden bg-surface lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <div class="container-wide flex h-[4.5rem] items-center justify-between border-b border-brand-200">
    <span class="font-display text-[1.35rem] tracking-[0.14em] text-brand-950 uppercase">
      {NEGOCIO.nombre}
    </span>
    <button
      id="menu-cerrar"
      class="-mr-2 flex h-11 w-11 items-center justify-center text-brand-950"
      aria-label="Cerrar menú"
    >
      <Icono nombre="cerrar" tamano={22} />
    </button>
  </div>

  <nav class="container-wide flex flex-col py-6" aria-label="Navegación móvil">
    {links.map((l, i) => (
      <a
        href={l.href}
        class="type-sub border-b border-brand-200 py-5 text-brand-950 transition-colors duration-500 hover:text-accent-700"
      >
        <span class="section-num mr-4 align-middle">{String(i + 1).padStart(2, '0')}</span>
        {l.label}
      </a>
    ))}
    <a
      href={waLink(ctaMensaje)}
      target="_blank"
      rel="noopener"
      class="btn btn-whatsapp mt-8"
    >
      <Icono nombre="whatsapp" tamano={17} />
      {cta}
    </a>
    <p class="mt-8 text-[0.82rem] leading-relaxed font-light text-brand-500">
      {NEGOCIO.direccion}, {NEGOCIO.ciudad}<br />
      {NEGOCIO.horario}
    </p>
  </nav>
</div>

<script>
  /* Los scripts de componente NO se vuelven a ejecutar tras una navegación
     del ClientRouter, así que el montaje se cuelga de `astro:page-load`,
     que sí dispara en la carga inicial y en cada navegación. */
  function montarMenu(): void {
    const abrir = document.getElementById('menu-toggle');
    const cerrar = document.getElementById('menu-cerrar');
    const menu = document.getElementById('menu-movil');
    if (!abrir || !menu) return;

    const mostrar = (visible: boolean) => {
      menu.classList.toggle('hidden', !visible);
      abrir.setAttribute('aria-expanded', String(visible));
      document.body.style.overflow = visible ? 'hidden' : '';
      if (visible) menu.querySelector<HTMLElement>('a')?.focus();
      else abrir.focus();
    };

    abrir.addEventListener('click', () => mostrar(true));
    cerrar?.addEventListener('click', () => mostrar(false));

    // Al navegar dentro del menú, se cierra solo.
    menu.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => mostrar(false)),
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) mostrar(false);
    });
  }

  document.addEventListener('astro:page-load', montarMenu);
</script>
