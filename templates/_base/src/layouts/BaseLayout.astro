---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { NEGOCIO } from '../scripts/site';

interface Props {
  title?: string;
  description?: string;
  /** URL absoluta de imagen para compartir en redes (og:image). */
  image?: string;
}

const { title = NEGOCIO.nombre, description = NEGOCIO.descripcion, image } = Astro.props;

const fullTitle =
  title === NEGOCIO.nombre
    ? `${NEGOCIO.nombre} — ${NEGOCIO.eslogan}`
    : `${title} | ${NEGOCIO.nombre}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

/* Datos estructurados del negocio local. Cambia `@type` por el que
   corresponda al nicho (JewelryStore, HairSalon, Restaurant…): Google usa
   ese tipo para armar el panel de conocimiento. */
const negocioJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: NEGOCIO.nombre,
  description: NEGOCIO.descripcion,
  telephone: NEGOCIO.telefono,
  email: NEGOCIO.correo,
  url: Astro.site?.href,
  currenciesAccepted: 'COP',
  paymentAccepted: NEGOCIO.pagos.join(', '),
  foundingDate: String(NEGOCIO.anoFundacion),
  address: {
    '@type': 'PostalAddress',
    streetAddress: NEGOCIO.direccion,
    addressLocality: NEGOCIO.ciudad,
    addressCountry: 'CO',
  },
  sameAs: [NEGOCIO.instagram, NEGOCIO.facebook].filter(Boolean),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NEGOCIO.nombre} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Las tipografías son variables y self-hosted: se declaran en
         global.css, sin peticiones bloqueantes a un CDN externo. -->

    <script type="application/ld+json" is:inline set:html={JSON.stringify(negocioJsonLd)} />

    <ClientRouter />
  </head>
  <body>
    <!-- Enlace de salto: obligatorio para navegación por teclado.
         Cada página debe tener un <main id="contenido"> como destino. -->
    <a
      href="#contenido"
      class="micro-sm sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-brand-950 focus:px-5 focus:py-3 focus:text-white"
    >
      Saltar al contenido
    </a>
    <slot />
    <script src="../scripts/animations.ts"></script>
  </body>
</html>
