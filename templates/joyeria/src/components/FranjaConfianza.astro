---
/**
 * Cinta de confianza: los sellos que exige el comprador colombiano, en
 * micro-mayúsculas y en bucle infinito. El script del motor duplica el
 * contenido de `[data-marquee]` solo — nunca lo dupliques aquí.
 */
interface Props {
  items?: string[];
}
const {
  items = [
    'Oro 18k · 750 certificado',
    'Certificado de materiales',
    'Garantía escrita de un año',
    'Primer ajuste de talla sin costo',
    'Envío asegurado a toda Colombia',
    'Taller propio en Bucaramanga',
  ],
} = Astro.props;
---

<section class="overflow-hidden border-y border-brand-200 bg-paper py-5" aria-label="Nuestro compromiso">
  <!-- La cinta se anima solo visualmente; el contenido real para lectores
       de pantalla va una sola vez, sin el bucle duplicado. -->
  <p class="sr-only">{items.join('. ')}.</p>
  <div class="flex w-max items-center gap-10 whitespace-nowrap" data-marquee aria-hidden="true">
    {items.map((item) => (
      <span class="flex items-center gap-10">
        <span class="micro-sm text-brand-700">{item}</span>
        <span class="text-accent-500">·</span>
      </span>
    ))}
  </div>
</section>
