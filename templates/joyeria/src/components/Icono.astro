---
/**
 * Iconografía de la plantilla, en un solo lugar.
 *
 * Todos los trazos son de 1.5 de grosor y sin relleno (salvo WhatsApp, que
 * usa su glifo oficial macizo). Si necesitas un ícono nuevo, agrégalo aquí
 * en vez de pegar un <svg> suelto en una página.
 *
 *   <Icono nombre="flecha" />
 *   <Icono nombre="whatsapp" tamano={18} />
 */
interface Props {
  nombre:
    | 'whatsapp'
    | 'flecha'
    | 'flecha-izq'
    | 'flecha-abajo'
    | 'cerrar'
    | 'menu'
    | 'lupa'
    | 'mas'
    | 'instagram'
    | 'facebook'
    | 'escudo'
    | 'certificado'
    | 'anillo'
    | 'martillo'
    | 'camion'
    | 'tienda'
    | 'calendario'
    | 'regla'
    | 'corazon'
    | 'bolsa'
    | 'usuario'
    | 'estrella';
  tamano?: number;
  class?: string;
}

const { nombre, tamano = 16, class: clase = '' } = Astro.props;

const macizo = nombre === 'whatsapp' || nombre === 'estrella';
---

<svg
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill={macizo ? 'currentColor' : 'none'}
  stroke={macizo ? undefined : 'currentColor'}
  stroke-width={macizo ? undefined : 1.5}
  stroke-linecap={macizo ? undefined : 'round'}
  stroke-linejoin={macizo ? undefined : 'round'}
  class={clase}
  aria-hidden="true"
>
  {nombre === 'whatsapp' && (
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.668-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
  )}

  {nombre === 'flecha' && (
    <>
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </>
  )}

  {nombre === 'flecha-izq' && (
    <>
      <line x1="19" y1="12" x2="5" y2="12" />
      <polyline points="12 19 5 12 12 5" />
    </>
  )}

  {nombre === 'flecha-abajo' && (
    <>
      <line x1="12" y1="5" x2="12" y2="19" />
      <polyline points="19 12 12 19 5 12" />
    </>
  )}

  {nombre === 'cerrar' && (
    <>
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </>
  )}

  {nombre === 'menu' && (
    <>
      <line x1="3" y1="7" x2="21" y2="7" />
      <line x1="3" y1="17" x2="21" y2="17" />
    </>
  )}

  {nombre === 'lupa' && (
    <>
      <circle cx="11" cy="11" r="7" />
      <line x1="21" y1="21" x2="16" y2="16" />
      <line x1="11" y1="8" x2="11" y2="14" />
      <line x1="8" y1="11" x2="14" y2="11" />
    </>
  )}

  {nombre === 'mas' && (
    <>
      <line x1="12" y1="5" x2="12" y2="19" />
      <line x1="5" y1="12" x2="19" y2="12" />
    </>
  )}

  {nombre === 'instagram' && (
    <>
      <rect x="2" y="2" width="20" height="20" rx="5" />
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
    </>
  )}

  {nombre === 'facebook' && (
    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
  )}

  {/* Garantía escrita */}
  {nombre === 'escudo' && (
    <>
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
      <path d="m9 12 2 2 4-4" />
    </>
  )}

  {/* Certificado de materiales */}
  {nombre === 'certificado' && (
    <>
      <path d="M4 3h16v12H4z" />
      <path d="M8 19.5 12 17l4 2.5V15H8z" />
      <line x1="8" y1="7" x2="16" y2="7" />
      <line x1="8" y1="11" x2="13" y2="11" />
    </>
  )}

  {/* Ajuste de talla */}
  {nombre === 'anillo' && (
    <>
      <circle cx="12" cy="14" r="6" />
      <path d="M9 4h6l-1.5 4h-3z" />
    </>
  )}

  {/* Hecho en el taller */}
  {nombre === 'martillo' && (
    <>
      <path d="M14.5 3.5 21 10l-3 3-6.5-6.5z" />
      <path d="m11.5 6.5-8 8a2.12 2.12 0 0 0 3 3l8-8" />
    </>
  )}

  {/* Envío asegurado */}
  {nombre === 'camion' && (
    <>
      <path d="M1 7h13v10H1z" />
      <path d="M14 10h4l3 3v4h-7z" />
      <circle cx="5.5" cy="18.5" r="1.8" />
      <circle cx="17.5" cy="18.5" r="1.8" />
    </>
  )}

  {/* Retiro en tienda */}
  {nombre === 'tienda' && (
    <>
      <path d="M3 9h18l-1.5-5h-15z" />
      <path d="M4.5 9v11h15V9" />
      <path d="M9.5 20v-6h5v6" />
    </>
  )}

  {nombre === 'calendario' && (
    <>
      <rect x="3" y="5" width="18" height="16" rx="1" />
      <line x1="3" y1="10" x2="21" y2="10" />
      <line x1="8" y1="3" x2="8" y2="7" />
      <line x1="16" y1="3" x2="16" y2="7" />
    </>
  )}

  {/* Guía de tallas */}
  {nombre === 'regla' && (
    <>
      <rect x="2" y="8" width="20" height="8" rx="1" />
      <line x1="7" y1="8" x2="7" y2="12" />
      <line x1="12" y1="8" x2="12" y2="13" />
      <line x1="17" y1="8" x2="17" y2="12" />
    </>
  )}

  {/* Favoritos, header */}
  {nombre === 'corazon' && (
    <path d="M12 20.5s-7.5-4.6-9.7-9.1C.7 8.1 2.2 4.8 5.4 4.1c2-.4 3.9.5 5 2.1 1.1-1.6 3-2.5 5-2.1 3.2.7 4.7 4 3.1 7.3-2.2 4.5-9.7 9.1-9.7 9.1z" />
  )}

  {/* Cuenta, header */}
  {nombre === 'usuario' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="10" r="3" />
      <path d="M6 19c1.2-2.6 3.4-4 6-4s4.8 1.4 6 4" />
    </>
  )}

  {/* Bolsa/carrito, header */}
  {nombre === 'bolsa' && (
    <>
      <path d="M6 8h12l1 13H5z" />
      <path d="M9 8V6a3 3 0 0 1 6 0v2" />
    </>
  )}

  {/* Calificación, testimonios */}
  {nombre === 'estrella' && (
    <path d="m12 2.5 2.9 6.3 6.6.7-5 4.7 1.4 6.6L12 17.7l-5.9 3.1 1.4-6.6-5-4.7 6.6-.7z" />
  )}
</svg>
