---
// Contacto: reúne los datos de la tienda, el agendador de citas (el canal
// rápido de verdad para "venir a probármela") y el formulario de Netlify
// como canal lento para todo lo que no necesita respuesta inmediata.
import SectionHeading from './SectionHeading.astro';
import CitaEnTienda from './CitaEnTienda.astro';
import Icono from './Icono.astro';
import { NEGOCIO, waLink } from '../scripts/site';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Numeración editorial de la sección. */
  numero?: string;
}
const {
  titulo = 'Visítanos',
  descripcion = 'Estamos para atenderte. Agenda una visita o escríbenos directo.',
  numero = '07',
} = Astro.props;

const datos = [
  { label: 'Dirección', valor: `${NEGOCIO.direccion}, ${NEGOCIO.ciudad}`, href: NEGOCIO.mapsUrl },
  { label: 'Horario', valor: NEGOCIO.horario },
  { label: 'Teléfono', valor: NEGOCIO.telefono, href: `tel:${NEGOCIO.telefono.replace(/\s/g, '')}` },
  { label: 'Correo', valor: NEGOCIO.correo, href: `mailto:${NEGOCIO.correo}` },
];

const campoClase =
  'w-full border-0 border-b border-brand-300 bg-transparent px-0 py-3 text-sm font-light text-brand-900 outline-none transition-colors duration-500 placeholder:text-brand-400 focus:border-accent-500';
---

<section class="py-24 md:py-32" id="contacto">
  <div class="container-wide">
    <SectionHeading numero={numero} eyebrow="Contacto" titulo={titulo} acento="o agenda tu visita" descripcion={descripcion} />

    <!-- ── Fila 1: datos de la tienda + agendador (el diferencial) ── -->
    <div class="mt-16 grid gap-14 lg:grid-cols-12 lg:gap-20">
      <!-- Datos del negocio: tabla de línea fina -->
      <div class="lg:col-span-5" data-reveal>
        <dl>
          {datos.map((fila) => (
            <div class="grid grid-cols-[5.5rem_1fr] items-baseline gap-5 border-t border-brand-200 py-5 last:border-b sm:grid-cols-[7rem_1fr] sm:gap-6">
              <dt class="micro-sm text-brand-500">{fila.label}</dt>
              <dd>
                {fila.href ? (
                  <a
                    href={fila.href}
                    target={fila.href.startsWith('http') ? '_blank' : undefined}
                    rel={fila.href.startsWith('http') ? 'noopener' : undefined}
                    class="text-[0.9rem] font-light text-brand-800 transition-colors duration-500 hover:text-accent-700"
                  >
                    {fila.valor}
                  </a>
                ) : (
                  <span class="text-[0.9rem] font-light text-brand-800">{fila.valor}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>

        <div class="mt-10 flex items-center gap-3 border-y border-brand-200 py-4">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-whatsapp" aria-hidden="true"></span>
          <p class="micro-sm text-brand-500">Canal rápido — te respondemos en minutos</p>
        </div>
        <a
          href={waLink(`Hola, vengo de la página de ${NEGOCIO.nombre} y quiero más información.`)}
          target="_blank"
          rel="noopener"
          class="btn btn-whatsapp mt-6 w-full sm:w-auto"
        >
          <Icono nombre="whatsapp" tamano={16} />
          Escribir por WhatsApp
        </a>
      </div>

      <!-- Agendador de citas: la herramienta que ninguna joyería del benchmark ofrece -->
      <div class="border border-brand-200 bg-paper p-8 lg:col-span-7 md:p-10" data-reveal>
        <CitaEnTienda />
      </div>
    </div>

    <!-- ── Fila 2: el canal lento, deliberadamente más callado ── -->
    <div class="mt-20 border-t border-brand-200 pt-16" data-reveal>
      <div class="flex items-center gap-3">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400" aria-hidden="true"></span>
        <p class="micro-sm text-brand-500">Canal lento — respondemos en 1 a 2 días hábiles</p>
      </div>
      <p class="mt-3 max-w-lg text-[0.85rem] leading-[1.8] font-light text-brand-600">
        ¿Prefieres dejar tu consulta por escrito y sin apuro? Usa este formulario. Para lo demás
        —talla, disponibilidad, cita— WhatsApp es siempre más rápido.
      </p>

      <!-- Formulario (Netlify Forms) -->
      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-8 max-w-xl"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hidden"><label>No llenar: <input name="bot-field" /></label></p>

        <div class="grid gap-9 sm:grid-cols-2">
          <div>
            <label for="nombre" class="micro-sm mb-1 block text-brand-500">Nombre</label>
            <input id="nombre" name="nombre" type="text" required class={campoClase} placeholder="Tu nombre" />
          </div>
          <div>
            <label for="correo" class="micro-sm mb-1 block text-brand-500">Correo</label>
            <input id="correo" name="correo" type="email" required class={campoClase} placeholder="tu@correo.com" />
          </div>
        </div>
        <div class="mt-9">
          <label for="mensaje" class="micro-sm mb-1 block text-brand-500">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="3" required class={`${campoClase} resize-none`} placeholder="Cuéntanos qué necesitas"></textarea>
        </div>

        <button type="submit" class="btn btn-outline mt-9 w-full sm:w-auto">Enviar mensaje</button>
        <p class="mt-5 text-xs font-light text-brand-500">
          El formulario funciona automáticamente al desplegar en Netlify.
        </p>
      </form>
    </div>
  </div>
</section>
