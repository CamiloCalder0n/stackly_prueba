---
import SectionHeading from './SectionHeading.astro';

interface Testimonio {
  nombre: string;
  texto: string;
  detalle?: string;
}
interface Props {
  titulo?: string;
  eyebrow?: string;
  items: Testimonio[];
}
const { titulo = 'Lo que dicen nuestros clientes', eyebrow = 'Testimonios', items } = Astro.props;
---

<section class="bg-brand-50 py-20" id="testimonios">
  <div class="container-site">
    <SectionHeading eyebrow={eyebrow} titulo={titulo} centrado />
    <div class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group>
      {items.map((t) => (
        <figure class="rounded-card flex flex-col gap-4 bg-white p-7 shadow-sm ring-1 ring-brand-100">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-accent-500" aria-hidden="true"><path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Z"/></svg>
          <blockquote class="text-sm leading-relaxed text-brand-700">{t.texto}</blockquote>
          <figcaption class="mt-auto">
            <p class="text-sm font-bold text-brand-950">{t.nombre}</p>
            {t.detalle && <p class="text-xs text-brand-500">{t.detalle}</p>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
