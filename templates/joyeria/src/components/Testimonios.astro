---
// Testimonios en tarjetas (Figma 1:132). El molde pone esta sección sobre
// la franja gris #f5f5f5 —la única superficie no blanca de la portada— con
// tarjetas blancas de 256×202 a canto vivo y sin filete.
//
// Encabezado: "Nuestros Clientes" en Playfair 40px, TINTA (no oro) y
// centrado, con el párrafo debajo también en Playfair y centrado. Ya no se
// usa `SectionHeading` porque ese componente impone numeral de sección +
// versalita dorada + segunda línea en cursiva, tres adornos que este molde
// no tiene. `SectionHeading` sigue vivo para la guía de tallas.
//
// DESVIACIÓN CONSCIENTE: el Figma no muestra estrellas y en su lugar deja
// un "logo" dorado en la esquina de cada tarjeta. Las estrellas se
// conservan —vienen de datos reales y son señal de confianza del benchmark
// colombiano—, pero se bajan de tamaño y se corren junto a la fecha para
// que no compitan con el nombre. En la esquina va la marca real.
import { NEGOCIO } from '../scripts/site';
import Icono from './Icono.astro';

interface Testimonio {
  nombre: string;
  ciudad: string;
  fecha: string;
  texto: string;
  /** 1 a 5. Por defecto 5. */
  estrellas?: number;
  detalle?: string;
}
interface Props {
  /** Titular completo en una sola línea, como el molde ("Nuestros Clientes"). */
  titulo?: string;
  descripcion?: string;
  items: Testimonio[];
}
const { titulo = 'Nuestros Clientes', descripcion, items } = Astro.props;
---

<section class="bg-paper py-16 md:py-20" id="testimonios">
  <div class="container-wide">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <h2 class="type-section text-brand-950">{titulo}</h2>
      {descripcion && (
        <p class="mx-auto mt-4 max-w-2xl font-display text-base leading-[1.6] text-brand-900">
          {descripcion}
        </p>
      )}
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {items.map((t) => (
        <figure class="flex flex-col bg-surface p-6">
          <div class="flex items-start justify-between gap-3">
            <figcaption class="font-display text-xl font-normal text-brand-950">
              {t.nombre}
            </figcaption>
            <span class="shrink-0 font-display text-sm text-accent-600">{NEGOCIO.nombre}</span>
          </div>

          <div class="mt-1 flex items-center gap-2.5">
            <p class="text-[0.78rem] text-brand-500">{t.ciudad} · {t.fecha}</p>
            <span
              class="flex gap-px"
              aria-label={`${t.estrellas ?? 5} de 5 estrellas`}
            >
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={i < (t.estrellas ?? 5) ? 'text-accent-500' : 'text-brand-300'}>
                  <Icono nombre="estrella" tamano={10} />
                </span>
              ))}
            </span>
          </div>

          <blockquote class="mt-5 text-[0.88rem] leading-[1.6] text-brand-900">
            {t.texto}
          </blockquote>

          {t.detalle && <p class="mt-3 text-[0.78rem] text-brand-500">{t.detalle}</p>}
        </figure>
      ))}
    </div>

    {NEGOCIO.googleReviewsUrl && (
      <div class="mt-10 flex justify-center" data-reveal>
        <a
          href={NEGOCIO.googleReviewsUrl}
          target="_blank"
          rel="noopener"
          class="link-rule font-display text-[1rem] text-brand-900 hover:text-accent-700"
        >
          Ver más reseñas en Google
          <Icono nombre="flecha" tamano={14} />
        </a>
      </div>
    )}
  </div>
</section>
