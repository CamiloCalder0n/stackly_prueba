---
import SectionHeading from './SectionHeading.astro';
import { NEGOCIO } from '../scripts/site';
import Icono from './Icono.astro';

interface Testimonio {
  nombre: string;
  /** El benchmark colombiano pide nombre y ciudad: pesa más que las estrellas genéricas. */
  ciudad: string;
  texto: string;
  detalle?: string;
}
interface Props {
  titulo?: string;
  eyebrow?: string;
  items: Testimonio[];
  /** Numeración editorial de la sección. */
  numero?: string;
}
const {
  titulo = 'Lo que dicen',
  eyebrow = 'Testimonios',
  items,
  numero = '05',
} = Astro.props;
---

<!-- Testimonios: sin cajas ni sombras — solo hairlines y cursiva editorial -->
<section class="py-24 md:py-32" id="testimonios">
  <div class="container-wide">
    <SectionHeading numero={numero} eyebrow={eyebrow} titulo={titulo} acento="nuestros clientes" centrado />

    <div class="mt-16 grid gap-x-10 gap-y-14 border-t border-brand-200 pt-14 md:grid-cols-3" data-reveal-group>
      {items.map((t) => (
        <figure class="flex flex-col">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" class="text-accent-400" aria-hidden="true"><path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 0 1-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179Z"/></svg>

          <blockquote class="mt-6 font-display text-xl leading-[1.5] font-light text-brand-800 italic md:text-2xl">
            {t.texto}
          </blockquote>

          <figcaption class="mt-auto pt-8">
            <span class="rule-hair mb-5 block"></span>
            <p class="micro-sm text-brand-950">{t.nombre} · {t.ciudad}</p>
            {t.detalle && <p class="mt-2 text-[0.82rem] font-light text-brand-500">{t.detalle}</p>}
          </figcaption>
        </figure>
      ))}
    </div>

    {NEGOCIO.googleReviewsUrl && (
      <div class="mt-16 flex justify-center" data-reveal>
        <a
          href={NEGOCIO.googleReviewsUrl}
          target="_blank"
          rel="noopener"
          class="micro link-rule text-brand-700 hover:text-accent-700"
        >
          Ver más reseñas en Google
          <Icono nombre="flecha" tamano={14} />
        </a>
      </div>
    )}
  </div>
</section>
