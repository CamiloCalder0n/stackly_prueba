---
// Hero de portada: maison editorial clara. Nada de foto oscura a pantalla
// completa — el hueso manda, la foto es una pieza más de la composición y
// la trayectoria del taller hace de prueba social bajo el CTA.
import { waLink, NEGOCIO, ANOS_OFICIO } from '../scripts/site';
import Icono from './Icono.astro';
import Foto from './Foto.astro';

interface Props {
  eyebrow?: string;
  titulo: string;
  /** Segunda línea del título, en cursiva dorada: el acento editorial. */
  acento?: string;
  subtitulo?: string;
  /** Foto macro vertical — es la imagen LCP de la página. */
  imagen: ImageMetadata;
  imagenAlt?: string;
  ctaTexto?: string;
  ctaMensaje?: string;
  ctaSecundario?: { label: string; href: string };
}

const {
  eyebrow,
  titulo,
  acento,
  subtitulo,
  imagen,
  imagenAlt = '',
  ctaTexto = 'Consultar por WhatsApp',
  ctaMensaje = `Hola, vengo de la página de ${NEGOCIO.nombre} y quiero más información.`,
  ctaSecundario,
} = Astro.props;

/* Prueba de trayectoria: sale directo de site.ts, nunca a mano, para que
   no se desactualice con el correr de los años. */
const trayectoria = `Oficio desde ${NEGOCIO.anoFundacion} (${ANOS_OFICIO} años) · más de ${NEGOCIO.piezasEntregadas.toLocaleString('es-CO')} piezas entregadas`;
---

<section class="relative bg-surface" aria-label="Presentación">
  <div class="container-wide grid gap-12 pt-32 pb-20 md:gap-16 md:pt-40 md:pb-28 lg:grid-cols-12 lg:items-center lg:gap-10 lg:pt-44 lg:pb-32">
    <!-- Bloque tipográfico: 7 de 12 columnas (asimetría editorial) -->
    <div class="lg:col-span-7">
      {eyebrow && (
        <div class="flex items-center gap-4">
          <span class="h-px w-10 bg-accent-500/70" aria-hidden="true"></span>
          <span class="micro text-accent-700">{eyebrow}</span>
        </div>
      )}

      <h1 class="type-hero mt-7 text-brand-950" data-split="hero">
        {titulo}
        {acento && (
          <>
            <br />
            <em class="font-normal text-accent-600 italic">{acento}</em>
          </>
        )}
      </h1>

      {subtitulo && (
        <p class="mt-8 max-w-lg text-[0.95rem] leading-[1.9] font-light text-brand-600">
          {subtitulo}
        </p>
      )}

      <div class="mt-11 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href={waLink(ctaMensaje)} target="_blank" rel="noopener" class="btn btn-primary">
          <Icono nombre="whatsapp" tamano={15} />
          {ctaTexto}
        </a>
        {ctaSecundario && (
          <a href={ctaSecundario.href} class="link-rule micro text-brand-700 hover:text-accent-700">
            {ctaSecundario.label}
            <Icono nombre="flecha" tamano={14} />
          </a>
        )}
      </div>

      <p class="micro-sm mt-12 text-brand-500">{trayectoria}</p>
    </div>

    <!-- Foto macro vertical: rompe la simetría, sin overlay oscuro -->
    <div class="lg:col-span-4 lg:col-start-9">
      <div class="frame-fine overflow-hidden">
        <Foto
          src={imagen}
          alt={imagenAlt}
          ratio="4/5"
          widths={[500, 700, 900, 1200]}
          sizes="(max-width: 1024px) 70vw, 30vw"
          prioridad
        />
      </div>
    </div>
  </div>
</section>
