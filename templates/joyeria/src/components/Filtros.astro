---
/**
 * Barra de filtros del catálogo.
 *
 * Componente de presentación: solo pinta botones, inputs y `data-*`. Toda la
 * lógica de filtrado/orden/URL vive en el <script> de `catalogo.astro`, que
 * es quien conoce las tarjetas y sabe recomponer la grilla con Flip.
 *
 * Decisión de móvil: a 390px cinco grupos de filtro no caben sin comerse
 * media pantalla, así que el cuerpo (chips de regalo + los cinco grupos)
 * va detrás de un acordeón (`#filtros-cuerpo`, oculto por defecto). El
 * buscador y el orden quedan siempre visibles porque son las herramientas
 * que más se usan. En ≥1024px el acordeón se ignora: `lg:block` lo fuerza
 * visible y el botón que lo abre se esconde con `lg:hidden` (mismo patrón
 * que el menú móvil de Header.astro).
 */
import Icono from './Icono.astro';

interface Opcion {
  valor: string;
  label: string;
}

interface Props {
  categorias: Opcion[];
  materiales: Opcion[];
  leyes: Opcion[];
  ocasiones: Opcion[];
  precios: Opcion[];
}

const { categorias, materiales, leyes, ocasiones, precios } = Astro.props;

const grupos = [
  { nombre: 'categoria', label: 'Pieza', opciones: categorias, aria: 'Filtrar por tipo de pieza' },
  { nombre: 'material', label: 'Material', opciones: materiales, aria: 'Filtrar por material' },
  { nombre: 'ley', label: 'Ley', opciones: leyes, aria: 'Filtrar por ley del metal' },
  { nombre: 'ocasion', label: 'Ocasión', opciones: ocasiones, aria: 'Filtrar por ocasión' },
  { nombre: 'precio', label: 'Precio', opciones: precios, aria: 'Filtrar por precio' },
];

/** Atajos de regalo: rangos propios, pensados para convertir sin obligar
    a leer la grilla de precio completa. Comparten el estado `precio`. */
const regalos = [
  { valor: '0-500000', label: 'Regalos hasta $500.000' },
  { valor: '0-1000000', label: 'Hasta $1.000.000' },
  { valor: '0-2000000', label: 'Hasta $2.000.000' },
];

const ordenes = [
  { valor: 'destacadas', label: 'Destacadas primero' },
  { valor: 'precio-asc', label: 'Precio: menor a mayor' },
  { valor: 'precio-desc', label: 'Precio: mayor a menor' },
  { valor: 'novedades', label: 'Novedades primero' },
];
---

<section
  class="z-30 border-b border-brand-200 bg-surface/95 backdrop-blur-md lg:sticky lg:top-[4.5rem]"
  id="filtros"
>
  <div class="container-wide">
    <!-- ── Fila siempre visible: buscador, orden y el acordeón en móvil ── -->
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 py-3.5">
      <div class="relative min-w-[12rem] flex-1">
        <label for="catalogo-buscar" class="sr-only">
          Buscar por nombre, referencia, material o piedra
        </label>
        <Icono
          nombre="lupa"
          tamano={13}
          class="pointer-events-none absolute top-1/2 left-0 -translate-y-1/2 text-brand-400"
        />
        <input
          type="search"
          id="catalogo-buscar"
          autocomplete="off"
          placeholder="Buscar por nombre, referencia, material o piedra…"
          class="w-full border-0 border-b border-brand-200 bg-transparent py-2 pl-6 text-[0.83rem] font-light text-brand-950 placeholder:text-brand-400 focus:border-accent-500 focus:outline-none"
        />
      </div>

      <div class="flex shrink-0 items-center gap-2.5">
        <label for="catalogo-orden" class="micro-sm text-brand-500">Ordenar</label>
        <select
          id="catalogo-orden"
          class="border-0 border-b border-brand-200 bg-transparent py-2 text-[0.78rem] font-light text-brand-800 focus:border-accent-500 focus:outline-none"
        >
          {ordenes.map((o) => <option value={o.valor}>{o.label}</option>)}
        </select>
      </div>

      <button
        type="button"
        id="filtros-toggle"
        class="micro-sm flex shrink-0 items-center gap-2 text-brand-800 lg:hidden"
        aria-expanded="false"
        aria-controls="filtros-cuerpo"
      >
        Filtros
        <Icono nombre="flecha-abajo" tamano={11} class="transition-transform duration-300" />
      </button>
    </div>

    <!-- ── Cuerpo: chips de regalo + grupos. Acordeón en móvil, siempre visible en desktop ── -->
    <div id="filtros-cuerpo" class="hidden border-t border-brand-100 pb-4 lg:block lg:pb-0">
      <div
        class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-brand-100 py-3.5"
        role="group"
        aria-label="Regalos por presupuesto"
        id="filtros-regalos"
      >
        <span class="micro-sm text-brand-500">Regalo</span>
        {regalos.map((r) => (
          <button type="button" class="chip-filtro" data-regalo data-valor={r.valor} aria-pressed="false">
            {r.label}
          </button>
        ))}
      </div>

      <div class="flex flex-wrap items-center gap-x-8 gap-y-3 py-3.5">
        {grupos.map((grupo, i) => (
          <div
            class={`flex flex-wrap items-center gap-x-5 gap-y-2 ${i > 0 ? 'lg:border-l lg:border-brand-200 lg:pl-8' : ''}`}
            data-filtro={grupo.nombre}
            role="group"
            aria-label={grupo.aria}
          >
            <span class="micro-sm shrink-0 text-brand-500">{grupo.label}</span>
            {grupo.opciones.map((o, i2) => (
              <button
                type="button"
                class="chip-filtro"
                data-valor={o.valor}
                aria-pressed={i2 === 0 ? 'true' : 'false'}
              >
                {o.label}
              </button>
            ))}
          </div>
        ))}

        <button type="button" data-limpiar-filtros class="micro-sm ml-auto text-accent-700 hover:text-accent-900">
          Limpiar filtros
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* El <svg> lo pinta <Icono>, un componente hijo: su elemento no lleva el
     scope de este archivo, así que hace falta `:global()` para alcanzarlo. */
  #filtros-toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
</style>
