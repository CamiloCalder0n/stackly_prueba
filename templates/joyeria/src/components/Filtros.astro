---
/**
 * Barra de filtros del catálogo.
 *
 * Componente de presentación: solo pinta controles y `data-*`. La lógica de
 * filtrado, orden y URL vive en el <script> de `catalogo.astro`, que es quien
 * conoce las tarjetas y sabe recomponer la grilla con Flip.
 *
 * Por qué está así y no como una parrilla de chips siempre visible:
 * con doce piezas en catálogo, la versión anterior mostraba veinticinco
 * chips en una barra fija de unos 250px. Ocupaba un tercio de la pantalla
 * para filtrar una vitrina que se recorre entera de un vistazo, y se leía
 * como un muro de texto suelto. Ahora la barra ocupa una línea —lo puntual:
 * buscar, cuántas piezas hay, ordenar y abrir filtros— y los grupos viven
 * dentro de un panel que se abre cuando de verdad hacen falta.
 *
 * También se cayó el grupo "Ley": en los datos reales cada material tiene
 * una sola ley (oro→18k, oro rosa→18k, plata→950), así que era un filtro
 * que no filtraba nada. La ley sigue visible en cada tarjeta y en la ficha,
 * que es donde el comprador la busca.
 */
import Icono from './Icono.astro';

interface Opcion {
  valor: string;
  label: string;
}

interface Props {
  categorias: Opcion[];
  materiales: Opcion[];
  ocasiones: Opcion[];
  precios: Opcion[];
}

const { categorias, materiales, ocasiones, precios } = Astro.props;

const grupos = [
  { nombre: 'categoria', label: 'Pieza', opciones: categorias, aria: 'Filtrar por tipo de pieza' },
  { nombre: 'material', label: 'Material', opciones: materiales, aria: 'Filtrar por material' },
  { nombre: 'precio', label: 'Presupuesto', opciones: precios, aria: 'Filtrar por presupuesto' },
  { nombre: 'ocasion', label: 'Ocasión', opciones: ocasiones, aria: 'Filtrar por ocasión' },
];

const ordenes = [
  { valor: 'destacadas', label: 'Destacadas primero' },
  { valor: 'precio-asc', label: 'Precio: menor a mayor' },
  { valor: 'precio-desc', label: 'Precio: mayor a menor' },
  { valor: 'novedades', label: 'Novedades primero' },
];
---

<section
  class="z-30 border-b border-brand-200 bg-surface/95 backdrop-blur-md lg:sticky lg:top-[4.5rem]"
  id="filtros"
>
  <div class="container-wide">
    <!-- ── La barra: una sola línea, siempre ── -->
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 py-3.5">
      <div class="relative min-w-[11rem] flex-1">
        <label for="catalogo-buscar" class="sr-only">Buscar por nombre, material o piedra</label>
        <Icono
          nombre="lupa"
          tamano={13}
          class="pointer-events-none absolute top-1/2 left-0 -translate-y-1/2 text-brand-400"
        />
        <input
          type="search"
          id="catalogo-buscar"
          autocomplete="off"
          placeholder="Buscar una pieza…"
          class="w-full border-0 border-b border-brand-200 bg-transparent py-2 pl-6 text-[0.83rem] font-light text-brand-950 placeholder:text-brand-400 focus:border-accent-500 focus:outline-none"
        />
      </div>

      <p class="micro-sm shrink-0 text-brand-500" id="contador-resultados" aria-live="polite"></p>

      <div class="flex shrink-0 items-center gap-2.5">
        <label for="catalogo-orden" class="micro-sm text-brand-500">Ordenar</label>
        <select
          id="catalogo-orden"
          class="border-0 border-b border-brand-200 bg-transparent py-2 text-[0.78rem] font-light text-brand-800 focus:border-accent-500 focus:outline-none"
        >
          {ordenes.map((o) => <option value={o.valor}>{o.label}</option>)}
        </select>
      </div>

      <button
        type="button"
        id="filtros-toggle"
        class="micro-sm flex shrink-0 items-center gap-2 border border-brand-300 px-4 py-2 text-brand-900 transition-colors duration-300 hover:border-accent-500 hover:text-accent-700"
        aria-expanded="false"
        aria-controls="filtros-cuerpo"
      >
        Filtrar
        <span
          id="filtros-cuenta"
          class="hidden min-w-5 bg-accent-500 px-1.5 py-0.5 text-center text-[0.6rem] text-brand-50"
        ></span>
        <Icono nombre="flecha-abajo" tamano={11} class="transition-transform duration-300" />
      </button>
    </div>

    <!-- ── Filtros activos: lo puntual, siempre a la vista y quitables uno a uno ── -->
    <div
      id="filtros-activos"
      class="hidden flex-wrap items-center gap-2 border-t border-brand-200 py-3"
      aria-label="Filtros aplicados"
    >
    </div>

    <!-- ── Panel: los grupos completos, solo cuando se piden ── -->
    <div id="filtros-cuerpo" class="hidden border-t border-brand-200 pb-6" >
      <div class="grid gap-x-10 gap-y-6 py-5 sm:grid-cols-2 lg:grid-cols-4">
        {grupos.map((grupo) => (
          <div data-filtro={grupo.nombre} role="group" aria-label={grupo.aria}>
            <p class="micro-sm mb-3 text-accent-700">{grupo.label}</p>
            <div class="flex flex-col items-start gap-1.5">
              {grupo.opciones.map((o, i) => (
                <button
                  type="button"
                  class="chip-filtro"
                  data-valor={o.valor}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {o.label}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      <button type="button" data-limpiar-filtros class="micro-sm text-accent-700 hover:text-accent-600">
        Limpiar todo
      </button>
    </div>
  </div>
</section>

<style>
  /* El <svg> lo pinta <Icono>, un componente hijo: su elemento no lleva el
     scope de este archivo, así que hace falta `:global()` para alcanzarlo. */
  #filtros-toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
</style>
