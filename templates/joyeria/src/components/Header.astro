---
import { NEGOCIO, waLink } from '../scripts/site';

interface Props {
  links: { label: string; href: string }[];
  /** Texto del botón de acción del header. */
  cta?: string;
  /** Mensaje de WhatsApp que dispara el CTA. */
  ctaMensaje?: string;
}

const { links, cta = 'Escríbenos', ctaMensaje = `Hola, vengo de la página de ${NEGOCIO.nombre} y quiero más información.` } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-brand-950/85 backdrop-blur-md">
  <div class="container-wide flex h-16 items-center justify-between">
    <a href="/" class="font-display text-xl font-normal tracking-[0.08em] text-white">
      {NEGOCIO.nombre}
    </a>

    <nav class="hidden items-center gap-9 md:flex" aria-label="Navegación principal">
      {links.map((l) => (
        <a href={l.href} class="micro-sm text-brand-200 transition-colors duration-500 hover:text-accent-200">
          {l.label}
        </a>
      ))}
      <a href={waLink(ctaMensaje)} target="_blank" rel="noopener" class="btn btn-primary !px-6 !py-2.5">
        {cta}
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="flex h-10 w-10 items-center justify-center rounded-md text-white md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-movil"
    >
      <svg id="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      <svg id="icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <nav id="menu-movil" class="hidden border-t border-white/10 bg-brand-950 md:hidden" aria-label="Navegación móvil">
    <div class="container-wide flex flex-col py-3">
      {links.map((l) => (
        <a href={l.href} class="micro-sm border-b border-white/10 py-4 text-brand-200 transition-colors duration-500 hover:text-accent-200">
          {l.label}
        </a>
      ))}
      <a href={waLink(ctaMensaje)} target="_blank" rel="noopener" class="btn btn-primary mt-5 mb-2">
        {cta}
      </a>
    </div>
  </nav>
</header>

<!-- Separador para que el contenido no quede debajo del header fijo -->
<div class="h-16" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-movil');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const abierto = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(abierto));
    iconOpen?.classList.toggle('hidden', abierto);
    iconClose?.classList.toggle('hidden', !abierto);
  });

  // Cierra el menú al navegar
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    }),
  );
</script>
