---
import type { CollectionEntry } from 'astro:content';
import { precioCOP } from '../scripts/site';

interface Props {
  pieza: CollectionEntry<'piezas'>;
  /**
   * normal    → retrato 4:5 con la ficha debajo (por defecto).
   * destacada → mosaico grande: la foto llena la tarjeta y el texto va encima.
   */
  variante?: 'normal' | 'destacada';
  /** Clases extra para el span en la grilla editorial. */
  class?: string;
}

const { pieza, variante = 'normal', class: clase = '' } = Astro.props;
const d = pieza.data;
const disponible = d.disponibilidad === 'disponible';
const precioVisible = d.precio != null && !d.ocultarPrecio;
const precioTexto = precioVisible ? precioCOP(d.precio!) : 'Consultar precio';

/* IMPORTANTE: los data-* de abajo son el contrato con el filtro del catálogo
   (src/pages/catalogo.astro). No renombrar ni mover fuera del elemento raíz. */
---

{variante === 'destacada' ? (
  <a
    href={`/piezas/${d.slug}/`}
    class={`group relative block aspect-[4/5] overflow-hidden bg-brand-950 lg:aspect-auto lg:h-full ${clase}`}
    data-pieza
    data-categoria={d.categoria}
    data-material={d.material}
    data-precio={precioVisible ? String(d.precio) : ''}
  >
    <img
      src={d.fotos[0]}
      alt={d.nombre}
      class="h-full w-full object-cover opacity-90 transition-all duration-[900ms] ease-[cubic-bezier(.22,.61,.36,1)] group-hover:scale-[1.06] group-hover:opacity-100"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-brand-950/15 to-transparent"></div>

    {!disponible && (
      <span class="micro-sm absolute top-5 left-5 bg-brand-950/70 px-3 py-1.5 text-accent-200 backdrop-blur-sm">
        Por encargo
      </span>
    )}

    <div class="absolute inset-x-0 bottom-0 p-7 md:p-9">
      <span class="micro-sm text-accent-300">{d.categoria} · {d.material}</span>
      <h3 class="mt-3 font-display text-3xl leading-tight font-light text-white md:text-4xl">
        {d.nombre}
      </h3>
      <div class="mt-4 flex items-end justify-between gap-4">
        <p class="precio text-lg text-accent-200">{precioTexto}</p>
        <span class="micro-sm inline-flex translate-y-1 items-center gap-2 text-white/0 transition-all duration-500 ease-[cubic-bezier(.22,.61,.36,1)] group-hover:translate-y-0 group-hover:text-white/80">
          Ver pieza
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </span>
      </div>
    </div>
  </a>
) : (
  <a
    href={`/piezas/${d.slug}/`}
    class={`group block ${clase}`}
    data-pieza
    data-categoria={d.categoria}
    data-material={d.material}
    data-precio={precioVisible ? String(d.precio) : ''}
  >
    <div class="relative overflow-hidden bg-brand-100">
      <img
        src={d.fotos[0]}
        alt={d.nombre}
        class="aspect-[4/5] w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(.22,.61,.36,1)] group-hover:scale-[1.07]"
        loading="lazy"
      />
      <!-- Velo que aparece lento y revela el CTA -->
      <div class="absolute inset-0 bg-gradient-to-t from-brand-950/70 via-transparent to-transparent opacity-0 transition-opacity duration-700 ease-[cubic-bezier(.22,.61,.36,1)] group-hover:opacity-100"></div>
      <span class="micro-sm absolute inset-x-0 bottom-0 flex translate-y-2 items-center justify-center gap-2 pb-6 text-white opacity-0 transition-all duration-700 ease-[cubic-bezier(.22,.61,.36,1)] group-hover:translate-y-0 group-hover:opacity-100">
        Ver pieza
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </span>

      {!disponible && (
        <span class="micro-sm absolute top-4 left-4 bg-brand-950/70 px-2.5 py-1.5 text-accent-200 backdrop-blur-sm">
          Por encargo
        </span>
      )}
    </div>

    <div class="pt-5">
      <span class="micro-sm text-brand-500">{d.categoria} · {d.material}</span>
      <h3 class="mt-2 font-display text-xl leading-snug font-normal text-brand-950 transition-colors duration-500 group-hover:text-accent-700">
        {d.nombre}
      </h3>
      <div class="mt-3 flex items-center gap-3">
        <span class="h-px w-5 bg-accent-500/60 transition-all duration-700 ease-[cubic-bezier(.22,.61,.36,1)] group-hover:w-9" aria-hidden="true"></span>
        <p class="precio text-sm text-brand-800">{precioTexto}</p>
      </div>
    </div>
  </a>
)}
