---
import type { CollectionEntry } from 'astro:content';
import { precioCOP } from '../scripts/site';

interface Props {
  pieza: CollectionEntry<'piezas'>;
}

const { pieza } = Astro.props;
const d = pieza.data;
const disponible = d.disponibilidad === 'disponible';
const precioVisible = d.precio != null && !d.ocultarPrecio;
---

<a
  href={`/piezas/${d.slug}/`}
  class="group rounded-card block overflow-hidden bg-white ring-1 ring-brand-100 transition-shadow hover:shadow-lg"
  data-pieza
  data-categoria={d.categoria}
  data-material={d.material}
  data-precio={precioVisible ? String(d.precio) : ''}
>
  <div class="relative overflow-hidden">
    <img
      src={d.fotos[0]}
      alt={d.nombre}
      class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <span
      class={`absolute top-3 left-3 rounded-full px-3 py-1 text-[0.68rem] font-semibold tracking-wide uppercase ${
        disponible ? 'bg-white/90 text-brand-800' : 'bg-brand-950/85 text-accent-200'
      }`}
    >
      {disponible ? 'Disponible' : 'Por encargo'}
    </span>
  </div>

  <div class="p-5">
    <p class="text-[0.7rem] font-semibold tracking-[0.14em] text-brand-400 uppercase">
      {d.categoria} · {d.material}
    </p>
    <h3 class="mt-1 font-display text-xl font-semibold text-brand-950">{d.nombre}</h3>
    <p class="mt-2 text-sm font-semibold text-accent-600">
      {precioVisible ? precioCOP(d.precio!) : 'Consultar precio'}
    </p>
    <span class="mt-3 inline-flex items-center gap-1.5 text-xs font-medium text-brand-500 transition-colors group-hover:text-accent-600">
      Ver pieza
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </span>
  </div>
</a>
