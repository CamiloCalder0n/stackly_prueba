---
// El taller, paso a paso: el momento de motion más ambicioso de la
// portada. En escritorio (≥1024px) la pista avanza en horizontal mientras
// la sección se ancla; en todo lo demás — móvil, y escritorio con
// "reducir movimiento" activo — se queda como una pila vertical normal.
// Por eso el layout horizontal va detrás de `lg:motion-safe:*` en vez de
// solo `lg:*`: así el fallback estático cubre también el caso que el
// `matchMedia` de animations.ts excluye a propósito.
import SectionHeading from './SectionHeading.astro';
import Foto from './Foto.astro';
import fotoTaller from '../assets/fotos/colgantes-suspendidos.jpg';

interface Paso {
  titulo: string;
  texto: string;
}

interface Props {
  numero?: string;
}

const { numero = '03' } = Astro.props;

const pasos: Paso[] = [
  {
    titulo: 'Fundir',
    texto: 'Se funde el oro de 18k en el crisol a más de 1.060 °C y se lamina hasta el grosor exacto que pide cada pieza.',
  },
  {
    titulo: 'Modelar',
    texto: 'Se corta, se conforma en el banco y se suelda cada parte a mano antes de que la pieza tome su forma final.',
  },
  {
    titulo: 'Engastar',
    texto: 'Se abren los asientos de cada piedra y se cierran las garras una por una, al milímetro, para que no se muevan.',
  },
  {
    titulo: 'Pulir',
    texto: 'Lija progresiva, cepillo y baño final de rodio o acabado espejo, según lo que pida el diseño de la pieza.',
  },
];
---

<section class="bg-surface" id="taller" aria-label="El proceso del taller" data-horizontal>
  <div class="container-wide pt-24 pb-16 md:pt-36 md:pb-20 lg:pt-32 lg:pb-16">
    <SectionHeading
      numero={numero}
      eyebrow="El taller"
      titulo="Cuatro pasos,"
      acento="un mismo banco"
      descripcion="Desde el crisol hasta el brillo final: así se hace cada pieza en nuestro taller de Bucaramanga."
    />
  </div>

  <div class="lg:motion-safe:flex lg:motion-safe:h-screen lg:motion-safe:items-stretch lg:motion-safe:overflow-hidden">
    <div
      class="flex flex-col gap-14 pb-24 md:pb-36 lg:motion-safe:flex-row lg:motion-safe:flex-nowrap lg:motion-safe:items-stretch lg:motion-safe:gap-0 lg:motion-safe:pb-0"
      data-horizontal-pista
    >
      {pasos.map((paso, i) => (
        <div class="flex flex-col justify-center gap-5 border-t border-brand-200 px-6 pt-10 first:border-t-0 sm:px-8 lg:motion-safe:w-[68vw] lg:motion-safe:shrink-0 lg:motion-safe:border-t-0 lg:motion-safe:border-l lg:motion-safe:first:border-l-0 lg:motion-safe:px-14 lg:motion-safe:pt-0 xl:motion-safe:w-[48vw]">
          <span class="paso-num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="type-sub text-brand-950">{paso.titulo}</h3>
          <p class="max-w-md text-[0.92rem] leading-[1.85] font-light text-brand-600">{paso.texto}</p>
        </div>
      ))}

      <!-- Foto de apoyo: solo forma parte del recorrido horizontal real;
           en el resto de los casos ya se contó todo con los cuatro pasos. -->
      <div class="hidden lg:motion-safe:block lg:motion-safe:w-[40vw] lg:motion-safe:shrink-0 xl:motion-safe:w-[32vw]">
        <Foto
          src={fotoTaller}
          alt="Piezas terminadas colgando en el taller de Aurea"
          ratio="auto"
          sizes="(max-width: 1024px) 0px, 40vw"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
