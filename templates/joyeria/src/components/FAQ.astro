---
import SectionHeading from './SectionHeading.astro';

interface Pregunta {
  pregunta: string;
  respuesta: string;
}
interface Props {
  titulo?: string;
  eyebrow?: string;
  items: Pregunta[];
  /** Numeración editorial de la sección. */
  numero?: string;
}
const {
  titulo = 'Preguntas',
  eyebrow = 'FAQ',
  items,
  numero = '06',
} = Astro.props;
---

<!-- FAQ: acordeón de línea fina, encabezado desplazado a la izquierda -->
<section class="bg-paper py-24 md:py-32" id="faq">
  <div class="container-wide grid gap-14 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <SectionHeading numero={numero} eyebrow={eyebrow} titulo={titulo} acento="frecuentes" />
      </div>
    </div>

    <div class="lg:col-span-7 lg:col-start-6" data-reveal-group>
      {items.map((item) => (
        <details class="group border-t border-brand-200 last:border-b">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-8 py-7 text-left [&::-webkit-details-marker]:hidden">
            <span class="font-display text-xl leading-snug font-normal text-brand-950 transition-colors duration-500 group-hover:text-accent-700 md:text-2xl">
              {item.pregunta}
            </span>
            <span class="mt-1.5 shrink-0 text-accent-600 transition-transform duration-500 ease-[cubic-bezier(.22,.61,.36,1)] group-open:rotate-45" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </summary>
          <p class="max-w-2xl pr-8 pb-8 text-[0.9rem] leading-[1.9] font-light text-brand-600">
            {item.respuesta}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
