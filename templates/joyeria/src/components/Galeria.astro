---
import { getImage } from 'astro:assets';
import Foto from './Foto.astro';
import Icono from './Icono.astro';

/**
 * Galería de la ficha de pieza: foto principal (LCP), miniaturas navegables
 * por teclado, lupa de escritorio y lightbox accesible con foco atrapado,
 * flechas y swipe táctil. Sin librerías: todo con `<Foto>`, `<dialog>` nativo
 * y background-position para la lupa.
 */
interface Props {
  fotos: ImageMetadata[];
  nombre: string;
  slug: string;
}

const { fotos, nombre, slug } = Astro.props;

/* Versión grande PROCESADA de cada foto (AVIF, 1400px).
   `foto.src` apunta al archivo original —2000px de JPEG— así que usarlo
   para la lupa, el lightbox o el cambio de miniatura anulaba todo el
   trabajo de optimización y competía con el LCP de la página. */
const rutas = await Promise.all(
  fotos.map(async (foto) => {
    const grande = await getImage({ src: foto, width: 1400, format: 'avif', quality: 72 });
    return grande.src;
  }),
);

/* Mismo valor que usa PiezaCard (`view-transition-name: pieza-${slug}`,
   como estilo inline, no la directiva `transition:name`) para que el
   navegador la reconozca como el MISMO elemento al ir del catálogo a la
   ficha y anime la transición como un elemento compartido. */
const nombreTransicion = `pieza-${slug}`;
---

<div id="galeria" data-fotos={JSON.stringify(rutas)}>
  <!-- ── Foto principal: LCP de la página ── -->
  <div
    class="galeria-principal group relative overflow-hidden bg-brand-100"
    style={`view-transition-name: ${nombreTransicion}`}
  >
    <Foto
      src={fotos[0]}
      alt={nombre}
      ratio="4/5"
      sizes="(max-width: 1024px) 100vw, 58vw"
      prioridad
      class="pointer-events-none select-none"
    />
    <!-- Capa de la lupa: background-position en vez de mover la foto real,
         así no pelea con el srcset de <Foto> ni dispara reflow. La imagen NO
         se declara aquí: aunque la capa esté a opacidad 0 el navegador la
         descargaría igual, robándole ancho de banda al LCP. El script la
         asigna la primera vez que el cursor entra, y solo con mouse fino. -->
    <div
      id="galeria-lupa-capa"
      class="pointer-events-none absolute inset-0 bg-no-repeat opacity-0"
      style="background-size: 235%;"
      aria-hidden="true"
    >
    </div>
    <button
      type="button"
      id="galeria-abrir"
      class="absolute inset-0 cursor-zoom-in"
      aria-label={`Ampliar foto de ${nombre}`}
    >
      <span class="micro-sm absolute right-5 bottom-5 inline-flex items-center gap-2 bg-noche/70 px-3 py-2 text-white opacity-0 backdrop-blur-sm transition-opacity duration-500 group-hover:opacity-100">
        <Icono nombre="lupa" tamano={14} />
        Ampliar
      </span>
    </button>
  </div>

  {fotos.length > 1 && (
    <div
      class="mt-4 grid grid-cols-4 gap-3 sm:grid-cols-5 sm:gap-4"
      role="group"
      aria-label={`Fotos de ${nombre}`}
      id="galeria-miniaturas"
    >
      {fotos.map((foto, i) => (
        <button
          type="button"
          class="galeria-miniatura overflow-hidden border transition-all duration-500 ease-[cubic-bezier(.22,.61,.36,1)] data-[activa=true]:border-accent-500 data-[activa=false]:border-brand-200 data-[activa=false]:opacity-55 hover:opacity-100"
          data-index={i}
          data-activa={i === 0 ? 'true' : 'false'}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={`Ver foto ${i + 1} de ${nombre}`}
          tabindex={i === 0 ? 0 : -1}
        >
          <Foto src={foto} alt="" ratio="4/5" widths={[120, 240]} sizes="120px" />
        </button>
      ))}
    </div>
  )}
</div>

<!-- ── Lightbox: <dialog> nativo.
     showModal() vuelve inert todo lo de fuera del diálogo, así que el foco
     queda encerrado dentro sin tener que reimplementar un focus trap a
     mano. Solo hay que devolver el foco al botón que abrió al cerrar
     (evento 'close', que dispara tanto al pulsar "cerrar" como con Escape,
     que el propio <dialog> ya entiende sin código nuestro). ── -->
<dialog id="galeria-lightbox" aria-label={`Fotos de ${nombre}`} class="galeria-dialogo">
  <button
    type="button"
    id="lightbox-cerrar"
    class="absolute top-4 right-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
    aria-label="Cerrar"
  >
    <Icono nombre="cerrar" tamano={20} class="text-white" />
  </button>
  <button
    type="button"
    id="lightbox-prev"
    class="absolute left-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 md:left-6"
    aria-label="Foto anterior"
  >
    <Icono nombre="flecha-izq" tamano={20} class="text-white" />
  </button>
  <!-- Sin `src` inicial a propósito: el lightbox solo se abre por JS, y una
       imagen declarada aquí se descargaría en cada carga de la ficha sin que
       nadie la vea. El script la asigna al abrir. -->
  <img
    id="lightbox-img"
    alt={nombre}
    loading="lazy"
    decoding="async"
    class="max-h-[85vh] max-w-full object-contain"
  />
  <button
    type="button"
    id="lightbox-next"
    class="absolute right-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 md:right-6"
    aria-label="Foto siguiente"
  >
    <Icono nombre="flecha" tamano={20} class="text-white" />
  </button>
  <p id="lightbox-contador" class="micro-sm absolute bottom-6 left-1/2 -translate-x-1/2 text-white/70" aria-live="polite"></p>
</dialog>

<style>
  /* El <dialog> nativo trae su propio recuadro blanco centrado con borde:
     se reemplaza por un lienzo oscuro a pantalla completa a mano. La lógica
     de apertura/cierre y el trap de foco los sigue dando el navegador.

     OJO: el `display: flex` va condicionado a `[open]`. La hoja de estilos
     del navegador ya trae `dialog:not([open]) { display: none }`, pero si
     aquí se pone `display: flex` sin condición, esta regla de autor le gana
     por especificidad y el diálogo CERRADO queda igual en el layout (fixed,
     inset: 0) tapando clics de toda la página. */
  .galeria-dialogo[open] {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: transparent;
    touch-action: pan-y;
  }
  .galeria-dialogo::backdrop {
    background: color-mix(in srgb, var(--color-noche) 96%, transparent);
  }
</style>

<script>
  // ── Galería + lupa + lightbox (vanilla, sin dependencias) ──
  // Se monta en cada navegación del ClientRouter: ver nota en CONTRATO.md
  // sobre `astro:page-load`.
  function montarGaleria(): void {
    const galeria = document.getElementById('galeria');
    if (!galeria) return; // esta página no tiene galería

    const fotos: string[] = JSON.parse(galeria.dataset.fotos || '[]');
    const zonaPrincipal = galeria.querySelector<HTMLDivElement>('.galeria-principal');
    // La foto principal la renderiza <Foto>, que no reenvía `id`: se toma
    // el <img> que produce en vez de intentar engancharse a uno inventado.
    const imagenPrincipal = zonaPrincipal?.querySelector<HTMLImageElement>('img') ?? null;
    const capaLupa = document.getElementById('galeria-lupa-capa');
    const grupoMiniaturas = document.getElementById('galeria-miniaturas');
    const miniaturas = Array.from(galeria.querySelectorAll<HTMLButtonElement>('.galeria-miniatura'));

    const dialogo = document.getElementById('galeria-lightbox') as HTMLDialogElement | null;
    const botonAbrir = document.getElementById('galeria-abrir');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxContador = document.getElementById('lightbox-contador');

    let actual = 0;
    let invocador: HTMLElement | null = null;

    function mostrar(indice: number): void {
      if (fotos.length === 0) return;
      actual = (indice + fotos.length) % fotos.length;
      const url = fotos[actual];

      if (imagenPrincipal) {
        // El srcset/sizes que generó <Foto> corresponden a la foto 0: si se
        // dejan puestos al cambiar de foto, el navegador puede seguir
        // resolviendo contra un srcset que ya no es el de esta imagen.
        imagenPrincipal.removeAttribute('srcset');
        imagenPrincipal.removeAttribute('sizes');
        imagenPrincipal.src = url;
      }
      if (capaLupa) capaLupa.style.backgroundImage = `url(${url})`;

      miniaturas.forEach((m) => {
        const activa = Number(m.dataset.index) === actual;
        m.dataset.activa = String(activa);
        m.setAttribute('aria-pressed', String(activa));
        m.tabIndex = activa ? 0 : -1;
      });

      if (lightboxImg) lightboxImg.src = url;
      if (lightboxContador) lightboxContador.textContent = `${actual + 1} / ${fotos.length}`;
    }

    // ── Miniaturas: click + roving tabindex con flechas ──
    miniaturas.forEach((m, i) => m.addEventListener('click', () => mostrar(i)));
    grupoMiniaturas?.addEventListener('keydown', (e: KeyboardEvent) => {
      const paso = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!paso) return;
      e.preventDefault();
      mostrar(actual + paso);
      miniaturas[actual]?.focus();
    });

    // ── Lupa: solo con mouse fino y sin "reducir movimiento" activo ──
    const admiteLupa =
      window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
      window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    if (admiteLupa && zonaPrincipal && capaLupa) {
      /* La imagen de la lupa se pide al primer movimiento del cursor sobre la
         foto, no en la carga: así no compite con el LCP y quien nunca use la
         lupa no la descarga jamás. */
      zonaPrincipal.addEventListener('mousemove', (e: MouseEvent) => {
        if (!capaLupa.style.backgroundImage) {
          capaLupa.style.backgroundImage = `url(${fotos[actual]})`;
        }
        const r = zonaPrincipal.getBoundingClientRect();
        const x = Math.min(100, Math.max(0, ((e.clientX - r.left) / r.width) * 100));
        const y = Math.min(100, Math.max(0, ((e.clientY - r.top) / r.height) * 100));
        capaLupa.style.backgroundPosition = `${x}% ${y}%`;
        capaLupa.style.opacity = '1';
      });
      zonaPrincipal.addEventListener('mouseleave', () => {
        capaLupa.style.opacity = '0';
      });
    }

    // ── Lightbox ──
    function abrir(): void {
      invocador = document.activeElement as HTMLElement;
      mostrar(actual);
      dialogo?.showModal();
    }
    function cerrar(): void {
      dialogo?.close();
    }

    botonAbrir?.addEventListener('click', abrir);
    document.getElementById('lightbox-cerrar')?.addEventListener('click', cerrar);
    document.getElementById('lightbox-prev')?.addEventListener('click', () => mostrar(actual - 1));
    document.getElementById('lightbox-next')?.addEventListener('click', () => mostrar(actual + 1));

    // Clic en el fondo (no en el contenido) cierra, como cualquier lightbox.
    dialogo?.addEventListener('click', (e) => {
      if (e.target === dialogo) cerrar();
    });

    // 'close' dispara tanto al llamar cerrar() como al pulsar Escape
    // (comportamiento nativo de <dialog>): un solo sitio para devolver el foco.
    dialogo?.addEventListener('close', () => {
      invocador?.focus();
      invocador = null;
    });

    dialogo?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') mostrar(actual - 1);
      if (e.key === 'ArrowRight') mostrar(actual + 1);

      // showModal() ya deja inert todo lo de fuera del diálogo (por eso el
      // foco nunca llega a la página de atrás), pero Chromium tiene un caso
      // raro: al tabular más allá del último elemento enfocable, el foco
      // pasa un instante por <body> antes de volver a entrar. Se fuerza el
      // ciclo a mano para que Tab/Shift+Tab se queden siempre dentro.
      if (e.key === 'Tab') {
        const focosables = Array.from(
          dialogo.querySelectorAll<HTMLElement>(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
          ),
        ).filter((el) => !el.hasAttribute('disabled'));
        if (focosables.length === 0) return;
        const primero = focosables[0];
        const ultimo = focosables[focosables.length - 1];
        if (e.shiftKey && document.activeElement === primero) {
          e.preventDefault();
          ultimo.focus();
        } else if (!e.shiftKey && document.activeElement === ultimo) {
          e.preventDefault();
          primero.focus();
        }
      }
    });

    // ── Swipe táctil dentro del lightbox ──
    let inicioX = 0;
    let inicioY = 0;
    dialogo?.addEventListener(
      'touchstart',
      (e: TouchEvent) => {
        inicioX = e.changedTouches[0].clientX;
        inicioY = e.changedTouches[0].clientY;
      },
      { passive: true },
    );
    dialogo?.addEventListener(
      'touchend',
      (e: TouchEvent) => {
        const dx = e.changedTouches[0].clientX - inicioX;
        const dy = e.changedTouches[0].clientY - inicioY;
        // Umbral horizontal claro para no confundir con un scroll vertical.
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          mostrar(actual + (dx < 0 ? 1 : -1));
        }
      },
      { passive: true },
    );
  }

  document.addEventListener('astro:page-load', montarGaleria);
</script>
