---
import { waLink, NEGOCIO } from '../scripts/site';

interface Props {
  titulo?: string;
  descripcion?: string;
  botonTexto?: string;
  mensaje?: string;
  /** Imagen de fondo opcional para el cierre editorial. */
  imagen?: string;
}
const {
  titulo = '¿Listo para empezar?',
  descripcion = 'Escríbenos por WhatsApp y te respondemos en minutos.',
  botonTexto = 'Hablar por WhatsApp',
  mensaje = `Hola, vengo de la página de ${NEGOCIO.nombre} y quiero más información.`,
  imagen = 'https://images.unsplash.com/photo-1573408301185-9146fe634ad0?w=1600&q=80',
} = Astro.props;
---

<!-- Cierre full-bleed: tipografía grande sobre fotografía oscurecida -->
<section class="relative overflow-hidden bg-brand-950 py-28 md:py-40" id="cta">
  {imagen && (
    <div class="absolute inset-0" data-parallax="0.08">
      <img src={imagen} alt="" class="h-[118%] w-full object-cover opacity-25" loading="lazy" />
    </div>
  )}
  <div class="absolute inset-0 bg-gradient-to-b from-brand-950/85 via-brand-950/70 to-brand-950/95"></div>

  <div class="container-wide relative text-center" data-reveal>
    <span class="micro text-accent-300">{NEGOCIO.nombre}</span>
    <h2 class="type-section mx-auto mt-7 max-w-3xl text-white">{titulo}</h2>
    <p class="mx-auto mt-7 max-w-xl text-[0.95rem] leading-[1.9] font-light text-brand-300">
      {descripcion}
    </p>
    <div class="mt-12 flex justify-center">
      <a href={waLink(mensaje)} target="_blank" rel="noopener" class="btn btn-whatsapp">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.668-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        {botonTexto}
      </a>
    </div>
  </div>
</section>
