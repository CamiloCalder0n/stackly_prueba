---
// Cierre editorial en claro. Antes este bloque era full-bleed oscuro con
// una foto de stock externa (Unsplash) de fondo — eso rompía la regla de
// "un solo momento oscuro" (que es el bloque de historia/taller) y además
// dependía de una imagen fuera del control de la plantilla. Ahora es una
// franja hueso con filete dorado: el contraste lo pone la tipografía, no
// el fondo.
import { waLink, NEGOCIO } from '../scripts/site';
import Icono from './Icono.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  botonTexto?: string;
  mensaje?: string;
}
const {
  titulo = '¿Listo para empezar?',
  descripcion = 'Escríbenos por WhatsApp y te respondemos en minutos.',
  botonTexto = 'Hablar por WhatsApp',
  mensaje = `Hola, vengo de la página de ${NEGOCIO.nombre} y quiero más información.`,
} = Astro.props;
---

<section class="bg-paper py-24 md:py-36" id="cta">
  <div class="container-wide text-center" data-reveal>
    <span class="rule-gold mx-auto max-w-14" data-rule></span>
    <span class="micro mt-10 block text-accent-700">{NEGOCIO.nombre}</span>
    <h2 class="type-section mx-auto mt-7 max-w-3xl text-brand-950">{titulo}</h2>
    <p class="mx-auto mt-7 max-w-xl text-[0.95rem] leading-[1.9] font-light text-brand-600">
      {descripcion}
    </p>
    <div class="mt-12 flex justify-center">
      <a href={waLink(mensaje)} target="_blank" rel="noopener" class="btn btn-whatsapp">
        <Icono nombre="whatsapp" tamano={17} />
        {botonTexto}
      </a>
    </div>
  </div>
</section>
