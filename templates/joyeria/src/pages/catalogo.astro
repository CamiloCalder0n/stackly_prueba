---
// Catálogo completo con filtros client-side (categoría, material y precio).
// El filtrado es TS vanilla sobre data-attributes de las cards — sin frameworks.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PiezaCard from '../components/PiezaCard.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import { NEGOCIO } from '../scripts/site';
import Foto from '../components/Foto.astro';
import fotoPortada from '../assets/fotos/pulsera-oro-revista.jpg';

const piezas = (await getCollection('piezas')).sort((a, b) =>
  a.data.nombre.localeCompare(b.data.nombre, 'es'),
);

const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Colecciones', href: '/#colecciones' },
  { label: 'Nosotros', href: '/#historia' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Contacto', href: '/#contacto' },
];

/**
 * Pieza que se muestra como mosaico grande en la grilla editorial.
 * Es determinista (no depende del orden tras filtrar): si el filtro la
 * oculta, la grilla simplemente se recompone con `grid-flow-dense`.
 */
const piezaMosaico = piezas.find((p) => p.data.destacada)?.data.slug;

const categorias = [
  { valor: 'todas', label: 'Todas' },
  { valor: 'anillos', label: 'Anillos' },
  { valor: 'collares', label: 'Collares' },
  { valor: 'aretes', label: 'Aretes' },
  { valor: 'pulseras', label: 'Pulseras' },
];

const materiales = [
  { valor: 'todos', label: 'Todos' },
  { valor: 'oro', label: 'Oro' },
  { valor: 'plata', label: 'Plata' },
  { valor: 'oro rosa', label: 'Oro rosa' },
];

const precios = [
  { valor: 'todos', label: 'Todos' },
  { valor: '0-800000', label: 'Menos de $800.000' },
  { valor: '800000-2000000', label: '$800.000 a $2.000.000' },
  { valor: '2000000-', label: 'Más de $2.000.000' },
];
---

<BaseLayout
  title="Catálogo"
  description={`Catálogo de ${NEGOCIO.nombre}: anillos, collares, aretes y pulseras en oro, plata y oro rosa, con precios visibles. Filtra y consulta por WhatsApp.`}
>
  <Header links={navLinks} cta="Consultar" />

  <!-- ── Encabezado editorial ── -->
  <section class="relative overflow-hidden bg-brand-950 py-24 md:py-32">
    <div class="absolute inset-0" data-parallax="0.08">
      <Foto
        src={fotoPortada}
        alt=""
        sizes="100vw"
        widths={[900, 1400, 2000]}
        prioridad
        class="h-[118%] object-cover opacity-20"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/80 to-brand-950"></div>

    <div class="container-wide relative" data-hero-title>
      <div class="flex items-center gap-4">
        <span class="h-px w-10 bg-accent-400/70" aria-hidden="true"></span>
        <span class="micro text-accent-300">Catálogo</span>
      </div>
      <h1 class="type-hero mt-7 text-white">
        Todas<br /><em class="font-normal text-accent-200 italic">nuestras piezas</em>
      </h1>
      <p class="mt-8 max-w-lg text-[0.95rem] leading-[1.9] font-light text-brand-200">
        Filtra por tipo de pieza, material o rango de precio. Cada ficha tiene fotos, especificaciones
        y un botón para consultar directo por WhatsApp con la referencia lista.
      </p>
    </div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-accent-500/40 to-transparent" aria-hidden="true"></div>
  </section>

  <!-- ── Filtros: barra fina y pegajosa, sin botones genéricos ── -->
  <!-- Se vuelve pegajosa solo en pantallas altas: en móvil ocuparía media pantalla -->
  <section class="z-30 border-b border-brand-200 bg-surface/95 backdrop-blur-md lg:sticky lg:top-16" id="filtros">
    <div class="container-wide divide-y divide-brand-100">
      {[
        { nombre: 'categoria', label: 'Pieza', opciones: categorias, aria: 'Filtrar por categoría' },
        { nombre: 'material', label: 'Material', opciones: materiales, aria: 'Filtrar por material' },
        { nombre: 'precio', label: 'Precio', opciones: precios, aria: 'Filtrar por precio' },
      ].map((grupo) => (
        <div
          class="flex flex-wrap items-center gap-x-7 gap-y-2 py-3.5"
          data-filtro={grupo.nombre}
          role="group"
          aria-label={grupo.aria}
        >
          <span class="micro-sm w-16 shrink-0 text-brand-500">{grupo.label}</span>
          {grupo.opciones.map((o, i) => (
            <button type="button" class="filtro-btn" data-valor={o.valor} aria-pressed={i === 0 ? 'true' : 'false'}>
              {o.label}
            </button>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ── Grid editorial: la pieza destacada ocupa un mosaico 2×2 ── -->
  <section class="py-16 md:py-24">
    <div class="container-wide">
      <p class="micro-sm mb-10 text-brand-500" id="contador-resultados" aria-live="polite">
        Mostrando {piezas.length} piezas
      </p>

      <div
        class="grid auto-rows-auto grid-flow-dense gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3"
        id="grid-piezas"
        data-reveal-group
      >
        {piezas.map((pieza) => (
          <PiezaCard
            pieza={pieza}
            variante={pieza.data.slug === piezaMosaico ? 'destacada' : 'normal'}
            class={pieza.data.slug === piezaMosaico ? 'sm:col-span-2 lg:row-span-2' : ''}
          />
        ))}
      </div>

      <!-- Estado vacío -->
      <div id="sin-resultados" class="hidden border border-brand-200 px-6 py-20 text-center">
        <p class="type-sub text-brand-950">No encontramos piezas con esos filtros</p>
        <p class="mx-auto mt-5 max-w-md text-[0.9rem] leading-[1.9] font-light text-brand-500">
          Prueba con otra combinación, o cuéntanos qué buscas por WhatsApp: muchas de nuestras piezas se hacen por encargo.
        </p>
        <button type="button" id="limpiar-filtros" class="btn btn-outline mt-10">Limpiar filtros</button>
      </div>
    </div>
  </section>

  <CTA
    titulo="¿No encuentras lo que buscas?"
    descripcion="Muchas piezas se fabrican por encargo. Cuéntanos tu idea y te cotizamos sin compromiso."
    botonTexto="Pedir una pieza a la medida"
    mensaje={`Hola, vengo del catálogo de ${NEGOCIO.nombre}. Quiero cotizar una pieza a la medida.`}
  />

  <Footer links={navLinks} />
  <WhatsAppFlotante mensaje={`Hola, vengo del catálogo de ${NEGOCIO.nombre} y quiero asesoría para elegir una joya.`} />
</BaseLayout>

<style>
  /* Filtros como texto con hairline: lenguaje de vitrina, no de app */
  .filtro-btn {
    position: relative;
    border: 0;
    padding: 0.35rem 0;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 300;
    letter-spacing: 0.04em;
    color: var(--color-brand-500);
    background: transparent;
    cursor: pointer;
    transition: color 0.5s var(--ease-silk);
  }
  .filtro-btn::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--color-accent-500);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.5s var(--ease-silk);
  }
  .filtro-btn:hover {
    color: var(--color-brand-900);
  }
  .filtro-btn:hover::after {
    transform: scaleX(1);
  }
  .filtro-btn[aria-pressed='true'] {
    color: var(--color-brand-950);
  }
  .filtro-btn[aria-pressed='true']::after {
    transform: scaleX(1);
  }
</style>

<script>
  // ── Filtros del catálogo (vanilla TS sobre data-attributes) ──
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-pieza]'));
  const sinResultados = document.getElementById('sin-resultados');
  const contador = document.getElementById('contador-resultados');
  const grupos = Array.from(document.querySelectorAll<HTMLElement>('[data-filtro]'));

  const estado: Record<string, string> = {
    categoria: 'todas',
    material: 'todos',
    precio: 'todos',
  };

  function enRango(precio: number, rango: string): boolean {
    const [min, max] = rango.split('-');
    return precio >= Number(min || 0) && (max === '' || precio < Number(max));
  }

  // Transición suave al filtrar (Web Animations API, sin dependencias).
  const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function animarEntrada(): void {
    if (menosMovimiento) return;
    cards
      .filter((c) => !c.classList.contains('hidden'))
      .forEach((c, i) => {
        c.animate(
          [
            { opacity: 0, transform: 'translateY(14px)' },
            { opacity: 1, transform: 'translateY(0)' },
          ],
          {
            duration: 520,
            delay: Math.min(i * 40, 320),
            easing: 'cubic-bezier(.22,.61,.36,1)',
            fill: 'backwards',
          },
        );
      });
  }

  function aplicarFiltros(): void {
    let visibles = 0;
    for (const card of cards) {
      const okCategoria = estado.categoria === 'todas' || card.dataset.categoria === estado.categoria;
      const okMaterial = estado.material === 'todos' || card.dataset.material === estado.material;
      let okPrecio = true;
      if (estado.precio !== 'todos') {
        // Las piezas sin precio publicado ("Consultar precio") solo aparecen con el filtro "Todos".
        const precio = card.dataset.precio ? Number(card.dataset.precio) : NaN;
        okPrecio = !Number.isNaN(precio) && enRango(precio, estado.precio);
      }
      const visible = okCategoria && okMaterial && okPrecio;
      card.classList.toggle('hidden', !visible);
      if (visible) visibles++;
    }
    sinResultados?.classList.toggle('hidden', visibles > 0);
    if (contador) {
      contador.textContent =
        visibles === 1 ? 'Mostrando 1 pieza' : `Mostrando ${visibles} piezas`;
    }
  }

  function seleccionar(grupo: HTMLElement, valor: string): void {
    const nombre = grupo.dataset.filtro!;
    const botones = grupo.querySelectorAll<HTMLButtonElement>('.filtro-btn');
    let encontrado = false;
    botones.forEach((b) => {
      const activo = b.dataset.valor === valor;
      b.setAttribute('aria-pressed', String(activo));
      if (activo) encontrado = true;
    });
    if (!encontrado) return; // valor inválido: no cambia el estado
    estado[nombre] = valor;
  }

  grupos.forEach((grupo) => {
    grupo.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filtro-btn');
      if (!btn) return;
      seleccionar(grupo, btn.dataset.valor!);
      aplicarFiltros();
      animarEntrada();
    });
  });

  document.getElementById('limpiar-filtros')?.addEventListener('click', () => {
    grupos.forEach((grupo) => {
      const primero = grupo.querySelector<HTMLButtonElement>('.filtro-btn');
      if (primero) seleccionar(grupo, primero.dataset.valor!);
    });
    aplicarFiltros();
    animarEntrada();
  });

  // Preselección vía URL: /catalogo?categoria=anillos&material=oro
  const params = new URLSearchParams(window.location.search);
  let preseleccion = false;
  for (const nombre of ['categoria', 'material', 'precio']) {
    const valor = params.get(nombre);
    if (!valor) continue;
    const grupo = grupos.find((g) => g.dataset.filtro === nombre);
    if (grupo) {
      seleccionar(grupo, valor);
      preseleccion = true;
    }
  }
  if (preseleccion) aplicarFiltros();
</script>
