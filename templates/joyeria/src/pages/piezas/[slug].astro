---
// Ficha de pieza: galería con lightbox, especificaciones, precio y
// CTA de WhatsApp con mensaje prellenado (nombre + referencia + URL).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PiezaCard from '../../components/PiezaCard.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFlotante from '../../components/WhatsAppFlotante.astro';
import { NEGOCIO, waLink, precioCOP } from '../../scripts/site';
import Foto from '../../components/Foto.astro';

export async function getStaticPaths() {
  const piezas = await getCollection('piezas');
  return piezas.map((pieza) => ({
    params: { slug: pieza.data.slug },
    props: { pieza, todas: piezas },
  }));
}

const { pieza, todas } = Astro.props;
const d = pieza.data;

const disponible = d.disponibilidad === 'disponible';
const precioVisible = d.precio != null && !d.ocultarPrecio;
const urlPieza = new URL(`/piezas/${d.slug}/`, Astro.site).href;

const mensajeWhatsApp = `Hola, vengo de la página de ${NEGOCIO.nombre}. Me interesa la pieza "${d.nombre}" (Ref. ${d.referencia}): ${urlPieza} — ¿me pueden dar más información?`;

const especificaciones = [
  { label: 'Referencia', valor: d.referencia },
  { label: 'Material', valor: d.material },
  { label: 'Piedras', valor: d.piedras },
  { label: 'Peso', valor: d.peso },
  { label: 'Tallas', valor: d.tallas },
].filter((e) => e.valor);

const relacionadas = todas
  .filter((p) => p.data.slug !== d.slug && p.data.categoria === d.categoria)
  .slice(0, 3);

const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Catálogo', href: '/catalogo' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'Contacto', href: '/#contacto' },
];

// Datos estructurados del producto (schema.org/Product)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.nombre,
  sku: d.referencia,
  image: d.fotos.map((f) => new URL(f.src, Astro.site).href),
  description: d.descripcion,
  material: d.material,
  url: urlPieza,
  brand: { '@type': 'Brand', name: NEGOCIO.nombre },
  ...(precioVisible && {
    offers: {
      '@type': 'Offer',
      priceCurrency: 'COP',
      price: d.precio,
      availability: disponible ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
      url: urlPieza,
    },
  }),
};
---

<BaseLayout title={d.nombre} description={d.descripcion} image={d.fotos[0].src}>
  <!-- JSON-LD del producto (válido dentro de <body>) -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <Header links={navLinks} cta="Consultar" />

  <section class="py-10 md:py-16">
    <div class="container-wide">
      <a href="/catalogo" class="micro-sm inline-flex items-center gap-2.5 text-brand-500 transition-colors duration-500 hover:text-accent-700">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Volver al catálogo
      </a>

      <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- ── Galería: protagonista, ratio vertical editorial ── -->
        <div class="lg:col-span-7" id="galeria" data-fotos={JSON.stringify(d.fotos.map((f) => f.src))}>
          <button
            type="button"
            id="galeria-abrir"
            class="group relative block w-full cursor-zoom-in overflow-hidden bg-brand-100"
            aria-label={`Ampliar foto de ${d.nombre}`}
          >
            <Foto
              src={d.fotos[0]}
              alt={d.nombre}
              ratio="4/5"
              sizes="(max-width: 1024px) 100vw, 58vw"
              prioridad
              class="transition-transform duration-[900ms] ease-[cubic-bezier(.22,.61,.36,1)] group-hover:scale-[1.04]"
            />
            <span class="micro-sm absolute right-5 bottom-5 inline-flex items-center gap-2 bg-brand-950/70 px-3 py-2 text-white opacity-0 backdrop-blur-sm transition-opacity duration-500 group-hover:opacity-100">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
              Ampliar
            </span>
          </button>

          {d.fotos.length > 1 && (
            <div class="mt-4 grid grid-cols-5 gap-4">
              {d.fotos.map((foto, i) => (
                <button
                  type="button"
                  class="galeria-miniatura overflow-hidden border transition-all duration-500 ease-[cubic-bezier(.22,.61,.36,1)] data-[activa=true]:border-accent-500 data-[activa=false]:border-brand-200 data-[activa=false]:opacity-55 hover:opacity-100"
                  data-index={i}
                  data-activa={i === 0 ? 'true' : 'false'}
                  aria-label={`Ver foto ${i + 1} de ${d.nombre}`}
                >
                  <Foto src={foto} alt="" ratio="4/5" widths={[120, 240]} sizes="120px" />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- ── Información: columna estrecha, sticky, jerarquía marcada ── -->
        <div class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start">
          <div class="flex items-center gap-4">
            <span class="micro text-accent-700">{d.categoria} · {d.material}</span>
            <span class="h-px flex-1 bg-brand-200" aria-hidden="true"></span>
          </div>

          <h1 class="type-section mt-6 text-brand-950">{d.nombre}</h1>

          <!-- Precio: la cifra manda, el estado la acompaña en micro -->
          <div class="mt-9 flex flex-wrap items-baseline gap-x-6 gap-y-3 border-y border-brand-200 py-7">
            <p class="precio font-display text-4xl font-light text-brand-950">
              {precioVisible ? precioCOP(d.precio!) : 'Consultar precio'}
            </p>
            <span class="micro-sm inline-flex items-center gap-2 text-brand-500">
              <span
                class={`h-1.5 w-1.5 rounded-full ${disponible ? 'bg-green-600' : 'bg-accent-500'}`}
                aria-hidden="true"
              ></span>
              {disponible ? 'Disponible' : 'Por encargo'}
            </span>
          </div>

          <p class="mt-8 text-[0.92rem] leading-[1.9] font-light text-brand-600">{d.descripcion}</p>

          <!-- Especificaciones: tabla de hairlines -->
          <dl class="mt-10">
            {especificaciones.map((e) => (
              <div class="grid grid-cols-[5.5rem_1fr] items-baseline gap-5 border-t border-brand-200 py-4 last:border-b sm:grid-cols-[7rem_1fr] sm:gap-6">
                <dt class="micro-sm text-brand-500">{e.label}</dt>
                <dd class="text-[0.88rem] font-light text-brand-800">{e.valor}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-10 flex flex-col gap-4 sm:flex-row">
            <a href={waLink(mensajeWhatsApp)} target="_blank" rel="noopener" class="btn btn-whatsapp flex-1">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.668-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              Consultar por WhatsApp
            </a>
            <a href="/catalogo" class="btn btn-outline">Seguir viendo</a>
          </div>

          <p class="mt-6 text-xs leading-[1.8] font-light text-brand-500">
            Al escribirnos se abre WhatsApp con la referencia de esta pieza lista para enviar.
            {disponible
              ? 'Te confirmamos talla, precio final y entrega en minutos.'
              : 'Las piezas por encargo tardan entre 2 y 4 semanas; te confirmamos tiempos y cotización.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  {relacionadas.length > 0 && (
    <section class="bg-paper py-24 md:py-32">
      <div class="container-wide">
        <div class="flex items-center gap-4" data-reveal>
          <span class="micro text-accent-700">Del mismo cajón</span>
          <span class="h-px flex-1 bg-brand-200" aria-hidden="true"></span>
        </div>
        <h2 class="type-section mt-6 text-brand-950" data-reveal>
          También <em class="font-normal text-accent-600 italic">te puede gustar</em>
        </h2>
        <div class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {relacionadas.map((p) => <PiezaCard pieza={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ── Lightbox ── -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-brand-950/95 p-4"
    role="dialog"
    aria-modal="true"
    aria-label={`Fotos de ${d.nombre}`}
  >
    <button type="button" id="lightbox-cerrar" class="absolute top-4 right-4 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20" aria-label="Cerrar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button type="button" id="lightbox-prev" class="absolute left-3 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 md:left-6" aria-label="Foto anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <img id="lightbox-img" src={d.fotos[0].src} alt={d.nombre} class="max-h-[85vh] max-w-full object-contain" />
    <button type="button" id="lightbox-next" class="absolute right-3 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors duration-500 hover:bg-white/20 md:right-6" aria-label="Foto siguiente">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <p id="lightbox-contador" class="micro-sm absolute bottom-6 text-white/60"></p>
  </div>

  <Footer links={navLinks} />
  <WhatsAppFlotante mensaje={mensajeWhatsApp} />
</BaseLayout>

<script>
  // ── Galería + lightbox (vanilla, sin dependencias) ──
  const galeria = document.getElementById('galeria');
  const fotos: string[] = galeria ? JSON.parse(galeria.dataset.fotos || '[]') : [];
  const principal = document.getElementById('galeria-principal') as HTMLImageElement | null;
  const miniaturas = Array.from(document.querySelectorAll<HTMLButtonElement>('.galeria-miniatura'));

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxContador = document.getElementById('lightbox-contador');

  let actual = 0;

  function mostrar(indice: number): void {
    actual = (indice + fotos.length) % fotos.length;
    if (principal) principal.src = fotos[actual];
    miniaturas.forEach((m) => m.setAttribute('data-activa', String(Number(m.dataset.index) === actual)));
    if (lightboxImg) lightboxImg.src = fotos[actual];
    if (lightboxContador) lightboxContador.textContent = `${actual + 1} / ${fotos.length}`;
  }

  miniaturas.forEach((m) =>
    m.addEventListener('click', () => mostrar(Number(m.dataset.index))),
  );

  function abrirLightbox(): void {
    mostrar(actual);
    lightbox?.classList.remove('hidden');
    lightbox?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function cerrarLightbox(): void {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.getElementById('galeria-abrir')?.addEventListener('click', abrirLightbox);
  document.getElementById('lightbox-cerrar')?.addEventListener('click', cerrarLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => mostrar(actual - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => mostrar(actual + 1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) cerrarLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('hidden')) return;
    if (e.key === 'Escape') cerrarLightbox();
    if (e.key === 'ArrowLeft') mostrar(actual - 1);
    if (e.key === 'ArrowRight') mostrar(actual + 1);
  });
</script>
