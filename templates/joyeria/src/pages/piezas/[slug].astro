---
// Ficha de pieza: la pantalla donde se cierra la venta. Galería con lupa y
// lightbox accesible, columna de compra con confianza explícita junto al
// precio, ficha técnica ampliada, selector de talla y grabado que se
// inyectan en el mensaje de WhatsApp, y piezas relacionadas.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PiezaCard from '../../components/PiezaCard.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFlotante from '../../components/WhatsAppFlotante.astro';
import Galeria from '../../components/Galeria.astro';
import BloqueConfianza from '../../components/BloqueConfianza.astro';
import Icono from '../../components/Icono.astro';
import Pagos from '../../components/Pagos.astro';
import { NEGOCIO, waLink, precioCOP, mensajeConsulta, leyLegible } from '../../scripts/site';
import { NAV } from '../../scripts/navegacion';

export async function getStaticPaths() {
  const piezas = await getCollection('piezas');
  return piezas.map((pieza) => ({
    params: { slug: pieza.data.slug },
    props: { pieza, todas: piezas },
  }));
}

const { pieza, todas } = Astro.props;
const d = pieza.data;

const disponible = d.disponibilidad === 'disponible';
const precioVisible = d.precio != null && !d.ocultarPrecio;
const precioTexto = precioVisible ? precioCOP(d.precio!) : 'Consultar precio';
const urlPieza = new URL(`/piezas/${d.slug}/`, Astro.site).href;

/**
 * Disponibilidad honesta: nada de urgencia inventada. Solo dos mensajes
 * posibles, y ambos son datos reales que ya vienen en el contenido.
 */
const disponibilidadTexto = disponible
  ? d.unidades === 1
    ? 'Pieza única, queda una en vitrina.'
    : d.unidades && d.unidades > 1
      ? `Disponible en tienda · quedan ${d.unidades} piezas.`
      : 'Disponible en tienda.'
  : d.diasEncargo
    ? `Se fabrica por encargo · ${d.diasEncargo} días hábiles.`
    : 'Se fabrica por encargo.';

const especificaciones = [
  { label: 'Referencia', valor: d.referencia },
  { label: 'Ley del metal', valor: leyLegible(d.ley) },
  { label: 'Piedras', valor: d.piedras },
  { label: 'Certificación', valor: d.certificacion },
  { label: 'Peso', valor: d.peso },
  { label: 'Medidas', valor: d.medidas },
  { label: 'Acabado', valor: d.acabado },
  { label: 'Tallas', valor: d.tallas },
].filter((e) => e.valor);

/**
 * `tallas` es texto libre en el modelo de contenido (lo escribe el joyero
 * en Decap), no un array. Aquí solo se convierte en selector cuando es un
 * rango numérico ("5 a 9") o una lista corta ("16,5 y 17,5 cm"): si es una
 * única descripción ("Cadena de 42 cm") no hay nada que elegir, y forzar un
 * selector de una sola opción sería ruido — esa descripción ya queda en la
 * ficha técnica de arriba.
 */
function parseTallas(texto: string): string[] | null {
  const limpio = texto.trim();

  const rango = limpio.match(/^(\d+)\s*a\s*(\d+)$/i);
  if (rango) {
    const inicio = Number(rango[1]);
    const fin = Number(rango[2]);
    if (fin > inicio && fin - inicio <= 20) {
      return Array.from({ length: fin - inicio + 1 }, (_, i) => String(inicio + i));
    }
  }

  if (/\by\b/i.test(limpio)) {
    const unidad = limpio.match(/\b(cm|mm)\s*$/i)?.[1];
    const sinUnidad = limpio.replace(/\s*(cm|mm)\s*$/i, '');
    const partes = sinUnidad
      .split(/\s*,\s*|\s+y\s+/i)
      .map((p) => p.trim())
      .filter(Boolean);
    if (partes.length > 1) return partes.map((p) => (unidad ? `${p} ${unidad}` : p));
  }

  return null;
}

const opcionesTalla = d.tallas ? parseTallas(d.tallas) : null;

// Mensaje inicial (sin talla ni grabado, que se eligen en el navegador): es
// el `href` que ya funciona si por algo el script del CTA no llega a montar.
const mensajeInicial = mensajeConsulta({ pieza: d.nombre, referencia: d.referencia, url: urlPieza });

const relacionadas = todas
  .filter((p) => p.data.slug !== d.slug && p.data.categoria === d.categoria)
  .slice(0, 3);


// ── Datos estructurados: Product enriquecido + BreadcrumbList ──
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.nombre,
  sku: d.referencia,
  image: d.fotos.map((f) => new URL(f.src, Astro.site).href),
  description: d.descripcion,
  material: d.material,
  url: urlPieza,
  brand: { '@type': 'Brand', name: NEGOCIO.nombre },
  ...(d.certificacion && {
    additionalProperty: {
      '@type': 'PropertyValue',
      name: 'Certificación',
      value: d.certificacion,
    },
  }),
  ...(precioVisible && {
    offers: {
      '@type': 'Offer',
      priceCurrency: 'COP',
      price: d.precio,
      availability: disponible ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
      url: urlPieza,
    },
  }),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: new URL('/catalogo', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.nombre, item: urlPieza },
  ],
};
---

<BaseLayout title={d.nombre} description={d.descripcion} image={d.fotos[0].src}>
  <!-- JSON-LD del producto y las migas de pan (válidos dentro de <body>) -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />
  <Header links={NAV} />


  <main id="contenido">
  <section class="py-10 md:py-16">
    <div class="container-wide">
      <a href="/catalogo" class="micro-sm inline-flex items-center gap-2.5 text-brand-500 transition-colors duration-500 hover:text-accent-700">
        <Icono nombre="flecha-izq" tamano={14} />
        Volver al catálogo
      </a>

      <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- ── Galería: protagonista, ratio vertical editorial ── -->
        <div class="lg:col-span-7">
          <Galeria fotos={d.fotos} nombre={d.nombre} slug={d.slug} />
        </div>

        <!-- ── Información: columna estrecha, pegajosa, jerarquía marcada ── -->
        <div class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start">
          <div class="flex flex-wrap items-center gap-3">
            <span class="micro text-accent-700">{d.categoria} · {d.material}</span>
            <span class="badge-ley">{leyLegible(d.ley)}</span>
          </div>

          <h1 class="type-section mt-6 text-brand-950">{d.nombre}</h1>

          <!-- Precio: la cifra manda, el estado y la disponibilidad honesta la acompañan -->
          <div class="mt-9 border-y border-brand-200 py-7">
            <div class="flex flex-wrap items-baseline gap-x-6 gap-y-3">
              <p class="precio font-display text-4xl font-light text-brand-950">{precioTexto}</p>
              <span class="micro-sm inline-flex items-center gap-2 text-brand-500">
                <span
                  class={`h-1.5 w-1.5 rounded-full ${disponible ? 'bg-green-600' : 'bg-accent-500'}`}
                  aria-hidden="true"
                ></span>
                {disponible ? 'Disponible' : 'Por encargo'}
              </span>
            </div>
            <p class="mt-3 text-xs leading-relaxed font-light text-brand-500">{disponibilidadTexto}</p>
          </div>

          <!-- El bloque de confianza va justo debajo del precio a propósito:
               es lo que más pesa en la decisión según la investigación. -->
          <BloqueConfianza />

          <div class="mt-8">
            <Pagos compacto />
          </div>

          <p class="mt-8 text-[0.92rem] leading-[1.9] font-light text-brand-600">{d.descripcion}</p>

          <!-- Ficha técnica ampliada: sustituye al "poder tocar la joya" -->
          <dl class="mt-2">
            {especificaciones.map((e) => (
              <div class="dato-tecnico">
                <dt class="micro-sm text-brand-500">{e.label}</dt>
                <dd class="text-[0.88rem] font-light text-brand-800">{e.valor}</dd>
              </div>
            ))}
          </dl>
          <span class="rule-hair" aria-hidden="true"></span>

          {opcionesTalla && (
            <fieldset class="mt-10 border-0 p-0">
              <div class="flex items-baseline justify-between gap-4">
                <legend class="micro-sm text-brand-500">Talla</legend>
                <a href="/guia-de-tallas" class="link-rule micro-sm inline-flex items-center gap-1.5 text-accent-700">
                  <Icono nombre="regla" tamano={13} />
                  ¿No sabes tu talla?
                </a>
              </div>
              <div class="mt-4 flex flex-wrap gap-2.5" id="grupo-tallas">
                {opcionesTalla.map((op) => (
                  <label class="cursor-pointer">
                    <input type="radio" name="talla" value={op} class="peer sr-only" />
                    <span class="flex h-11 min-w-11 items-center justify-center border border-brand-300 px-3 text-sm font-light text-brand-700 transition-colors duration-300 peer-checked:border-brand-950 peer-checked:bg-brand-950 peer-checked:text-brand-50 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent-600">
                      {op}
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}

          {d.grabable && (
            <div class="mt-10">
              <label for="grabado-input" class="micro-sm text-brand-500">Grabado personalizado (opcional)</label>
              <input
                type="text"
                id="grabado-input"
                maxlength="20"
                placeholder="Ej. Con amor, siempre"
                class="mt-3 w-full border-0 border-b border-brand-300 bg-transparent px-0 py-3 text-sm font-light text-brand-900 outline-none transition-colors duration-500 placeholder:text-brand-400 focus:border-accent-500"
              />
              <p id="grabado-contador" class="mt-2 text-right text-[0.7rem] text-brand-500" aria-live="polite">0/20</p>
            </div>
          )}

          <div
            class="mt-10 flex flex-col gap-4 sm:flex-row"
            id="ficha-cta"
            data-pieza={d.nombre}
            data-referencia={d.referencia}
            data-url={urlPieza}
          >
            <a id="cta-whatsapp" href={waLink(mensajeInicial)} target="_blank" rel="noopener" class="btn btn-whatsapp flex-1">
              <Icono nombre="whatsapp" tamano={18} />
              Consultar por WhatsApp
            </a>
            <a href="/#contacto" class="btn btn-outline">Verla en tienda</a>
          </div>

          <p class="mt-6 text-xs leading-[1.8] font-light text-brand-500">
            Al escribirnos se abre WhatsApp con la referencia de esta pieza lista para enviar
            {opcionesTalla && ', junto con la talla que elijas'}{d.grabable && ' y el grabado si lo pides'}.
            {disponible
              ? ' Te confirmamos disponibilidad y forma de pago en minutos.'
              : ' Te confirmamos tiempos exactos de fabricación y cotización.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  {relacionadas.length > 0 && (
    <section class="bg-paper py-24 md:py-32">
      <div class="container-wide">
        <div class="flex items-center gap-4" data-reveal>
          <span class="micro text-accent-700">Del mismo cajón</span>
          <span class="h-px flex-1 bg-brand-200" aria-hidden="true"></span>
        </div>
        <h2 class="type-section mt-6 text-brand-950" data-reveal>
          También <em class="font-normal text-accent-600 italic">te puede gustar</em>
        </h2>
        <div class="mt-14 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {relacionadas.map((p) => <PiezaCard pieza={p} variante="normal" />)}
        </div>
      </div>
    </section>
  )}
  </main>


  <Footer />
  <WhatsAppFlotante mensaje={mensajeInicial} />
</BaseLayout>

<script>
  // ── CTA de WhatsApp: recalcula el mensaje al elegir talla o escribir el
  // grabado. Ambos se eligen en el navegador, así que el enlace tiene que
  // recomponerse en cliente — no basta con el href que trae el HTML.
  import { waLink, mensajeConsulta } from '../../scripts/site';

  function montarFichaCTA(): void {
    const contenedor = document.getElementById('ficha-cta');
    const enlace = document.getElementById('cta-whatsapp') as HTMLAnchorElement | null;
    if (!contenedor || !enlace) return;

    const pieza = contenedor.dataset.pieza || '';
    const referencia = contenedor.dataset.referencia || '';
    const url = contenedor.dataset.url || '';

    function recalcular(): void {
      const talla = document.querySelector<HTMLInputElement>('input[name="talla"]:checked')?.value;
      const grabadoInput = document.getElementById('grabado-input') as HTMLInputElement | null;
      const grabado = grabadoInput?.value.trim() || undefined;
      enlace!.href = waLink(mensajeConsulta({ pieza, referencia, url, talla, grabado }));
    }

    document.getElementById('grupo-tallas')?.addEventListener('change', recalcular);

    const grabadoInput = document.getElementById('grabado-input') as HTMLInputElement | null;
    const contador = document.getElementById('grabado-contador');
    grabadoInput?.addEventListener('input', () => {
      if (contador) contador.textContent = `${grabadoInput.value.length}/20`;
      recalcular();
    });

    recalcular();
  }

  document.addEventListener('astro:page-load', montarFichaCTA);
</script>
