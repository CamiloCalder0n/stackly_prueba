---
// Portada reconstruida sobre el molde de Figma del cliente: maison editorial
// clara (blanco/crudo + tinta + oro sobrio). Seis secciones en el orden del
// Figma. El cierre del negocio es por WhatsApp (header + botón flotante), así
// que los CTA de contenido llevan al catálogo y a la ficha, no a un carrito
// que no existe.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import Hero from '../components/Hero.astro';
import CategoriaCard from '../components/CategoriaCard.astro';
import PiezaCard from '../components/PiezaCard.astro';
import ShowcaseEditorial from '../components/ShowcaseEditorial.astro';
import Testimonios from '../components/Testimonios.astro';
import InstagramGaleria from '../components/InstagramGaleria.astro';
import Icono from '../components/Icono.astro';
import { NEGOCIO } from '../scripts/site';
import { NAV } from '../scripts/navegacion';

/* ── Selección de fotografía ──────────────────────────────────────────────
   Se re-eligió foto por foto midiendo la luminancia media de las 22
   imágenes de `src/assets/fotos`. El molde de Figma es fotografía de
   estudio CLARA y CÁLIDA (fondos crudo/marfil, luz de día, oro amarillo);
   la selección anterior usaba justo las tres imágenes más oscuras de toda
   la biblioteca para las tarjetas de categoría —luminancia 38, 46 y 13
   sobre 255— y metía plata, perlas y piezas de museo en un negocio que
   vende SOLO oro 18k.

   Ahora las categorías usan las tres fotos claras de oro amarillo que sí
   existen (186, 248 y 89) y el Instagram usa solo oro sobre piel.

   OJO — límite real de la biblioteca: de 22 fotos solo 4 superan 150 de
   luminancia. No hay ninguna que reproduzca el fondo beige de estudio del
   Figma, así que el hero usa la única imagen con modelo + espacio negativo
   a la izquierda (la composición correcta) aunque su clave tonal sea baja.
   Cerrar del todo esta brecha pide fotografía nueva, no código. */
import fotoHero from '../assets/fotos/lifestyle-argollas-oro.jpg';
import fotoAnillos from '../assets/fotos/argollas-oro.jpg';
import fotoAretes from '../assets/fotos/aretes-hoop-oro.jpg';
import fotoCadenas from '../assets/fotos/collar-cadena-oro.jpg';
// Galería de Instagram: oro sobre piel, como el molde. Fuera la plata, las
// perlas y los diamantes sobre negro que había antes (material equivocado).
import ig1 from '../assets/fotos/lifestyle-velo-arete.jpg';
import ig2 from '../assets/fotos/lifestyle-aretes-modelo.jpg';
import ig3 from '../assets/fotos/lifestyle-pulsera-oscuro.jpg';
import ig4 from '../assets/fotos/anillo-solitario-oro.jpg';
import ig5 from '../assets/fotos/anillo-alba-oro.jpg';

const piezas = await getCollection('piezas');
const destacadas = piezas.filter((p) => p.data.destacada).slice(0, 4);

/** Dos piezas reales para el showcase editorial (foto = pieza etiquetada).
    El molde muestra dos primeros planos de modelo, así que se prefiere la
    pieza cuya foto principal ES un plano de modelo (`pulsera-eslabones`). */
const porSlug = (slug: string) => piezas.find((p) => p.data.slug === slug)!;
const showcase = [porSlug('pulsera-eslabones'), porSlug('collar-cadena-de-luz')];

/** Tarjetas de categoría → catálogo filtrado.
    "Cadenas y Pulsos" agrupa cadenas/collares, que en el schema es `collares`. */
const categorias = [
  {
    nombre: 'Anillos',
    descripcion: 'Elegancia que perdura',
    href: '/catalogo?categoria=anillos',
    imagen: fotoAnillos,
    alt: 'Argollas de matrimonio en oro de 18k sobre lino crudo',
  },
  {
    nombre: 'Aretes',
    descripcion: 'Detalles que elevan tu estilo',
    href: '/catalogo?categoria=aretes',
    imagen: fotoAretes,
    alt: 'Arete argolla en oro de 18k',
  },
  {
    nombre: 'Cadenas y Pulsos',
    descripcion: 'Lujo que te acompaña siempre',
    href: '/catalogo?categoria=collares',
    imagen: fotoCadenas,
    alt: 'Cadena tejida en oro de 18k',
  },
];

const fotosInstagram = [
  { src: ig1, alt: 'Arete en oro de 18k sobre la piel' },
  { src: ig2, alt: 'Modelo con aretes y gargantilla en oro de 18k' },
  { src: ig3, alt: 'Cadena y pulsera en oro de 18k sobre la piel' },
  { src: ig4, alt: 'Anillo solitario en oro de 18k' },
  { src: ig5, alt: 'Anillo en oro de 18k' },
];
---

<BaseLayout>
  <Header links={NAV} />

  <main id="contenido">
    <!-- ── 01 · Hero ── -->
    <Hero
      imagen={fotoHero}
      imagenAlt={`Modelo con argollas, aretes y gargantilla en oro de 18k de ${NEGOCIO.nombre}`}
      titulo="Oro"
      acento="que trasciende tendencias"
      subtitulo="Oro 18k. Atemporal. Colombiano."
      ctaTexto="Explorar colección"
      ctaHref="/catalogo"
    />

    <!-- ── 02 · Explora nuestras categorías ──
         El molde (1:199) pone el titular ENTERO en oro, centrado, a 48px y
         sin cursiva: no es "texto en tinta + palabra dorada en itálica".
         Ese partido en dos tonos era invención nuestra. -->
    <section class="bg-surface py-16 md:py-20" aria-label="Categorías">
      <div class="container-wide">
        <h2 class="type-section text-center text-accent-600" data-reveal>
          Explora nuestras categorías
        </h2>

        <div
          class="mt-12 grid gap-10 sm:grid-cols-2 md:gap-x-14 lg:grid-cols-3"
          data-reveal-group
        >
          {categorias.map((c) => (
            <CategoriaCard
              imagen={c.imagen}
              imagenAlt={c.alt}
              nombre={c.nombre}
              descripcion={c.descripcion}
              href={c.href}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- ── 03 · Joyas que amarás (piezas destacadas) ──
         Sobre blanco, no sobre crudo: en el Figma (1:32) esta sección
         comparte fondo con la de categorías. El rótulo es deliberadamente
         pequeño —Playfair 20px en tinta, a la izquierda— y contrasta con
         los 48px dorados de la sección de arriba. -->
    <section class="bg-surface pt-4 pb-16 md:pt-8 md:pb-20" aria-label="Piezas destacadas">
      <div class="container-wide">
        <div class="flex items-end justify-between gap-6">
          <h2 class="type-rotulo text-brand-950" data-reveal>Joyas que amarás.</h2>
          <a
            href="/catalogo"
            class="link-rule hidden font-display text-[1rem] text-brand-900 hover:text-accent-700 sm:inline-flex"
            data-reveal
          >
            Ver todo
            <Icono nombre="flecha" tamano={14} />
          </a>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-x-8 gap-y-10 md:gap-x-12 lg:grid-cols-4" data-reveal-group>
          {destacadas.map((pieza) => (
            <PiezaCard pieza={pieza} ratio="1/1" mostrarPeso />
          ))}
        </div>
      </div>
    </section>

    <!-- ── 04 · Showcase editorial ── -->
    <ShowcaseEditorial piezas={showcase} />

    <!-- ── 05 · Nuestros clientes ── -->
    <Testimonios
      titulo="Nuestros Clientes"
      descripcion={`Descubre por qué quienes eligen a ${NEGOCIO.nombre} confían en nuestra joyería para acompañar sus momentos más especiales. Cada opinión refleja la elegancia, la calidad y la dedicación de cada pieza en oro de 18k colombiano.`}
      items={[
        {
          nombre: 'Paula M.',
          ciudad: 'Bucaramanga',
          fecha: '22 may 2026',
          estrellas: 5,
          texto:
            'Vi el Solitario Aurora con el precio y la ficha completa en la página. Por WhatsApp me confirmaron talla 6 disponible y lo recogí al día siguiente en Cabecera. Sin sorpresas.',
          detalle: 'Anillo Solitario Aurora, talla 6',
        },
        {
          nombre: 'Camila V.',
          ciudad: 'Floridablanca',
          fecha: '4 abr 2026',
          estrellas: 5,
          texto:
            'Encargamos las Argollas Clásicas con grabado interior. Nos mandaron fotos del avance en el taller y las tuvimos listas en los 15 días hábiles que prometieron.',
          detalle: 'Argollas Clásicas, tallas 10 y 6',
        },
        {
          nombre: 'Luis F.',
          ciudad: 'Girón',
          fecha: '14 feb 2026',
          estrellas: 4,
          texto:
            'Compré la Pulsera Calada del Alba financiada con Addi: la aprobación llegó por WhatsApp en minutos. Llegó con certificado de materiales y garantía escrita.',
          detalle: 'Pulsera Calada del Alba, financiada con Addi',
        },
        {
          nombre: 'Sofía C.',
          ciudad: 'Bucaramanga',
          fecha: '9 ene 2026',
          estrellas: 5,
          texto:
            'Los Aretes Gota de Luz superaron lo que esperaba: acabado impecable y el oro se siente macizo. La asesoría por WhatsApp fue clara y honesta en todo momento.',
          detalle: 'Aretes Gota de Luz',
        },
      ]}
    />

    <!-- ── 06 · Esenciales de Instagram ── -->
    <InstagramGaleria fotos={fotosInstagram} />
  </main>

  <Footer />
  <WhatsAppFlotante
    mensaje={`Hola, vengo de la página de ${NEGOCIO.nombre} y quiero asesoría para elegir una joya.`}
  />
</BaseLayout>
