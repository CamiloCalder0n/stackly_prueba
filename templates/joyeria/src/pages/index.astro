---
// Portada de la plantilla joyería: maison editorial clara que lleva la
// investigación de mercado (13 joyerías colombianas auditadas) a una
// consulta por WhatsApp. Ver CONTRATO.md del rediseño para el porqué de
// cada sección — no son adornos, son respuestas a lo que pide el
// comprador colombiano (ley del metal, garantía, trayectoria, testimonios
// con ciudad, Addi/Sistecrédito).
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import Hero from '../components/Hero.astro';
import FranjaConfianza from '../components/FranjaConfianza.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PiezaCard from '../components/PiezaCard.astro';
import Taller from '../components/Taller.astro';
import Testimonios from '../components/Testimonios.astro';
import ComoCompras from '../components/ComoCompras.astro';
import FAQ from '../components/FAQ.astro';
import Contacto from '../components/Contacto.astro';
import CTA from '../components/CTA.astro';
import Foto from '../components/Foto.astro';
import Icono from '../components/Icono.astro';
import { NEGOCIO, ANOS_OFICIO } from '../scripts/site';
import { NAV, NAV_FOOTER } from '../scripts/navegacion';
import fotoHero from '../assets/fotos/anillos-piedra-crema.jpg';
import fotoHistoria from '../assets/fotos/lifestyle-pulsera-oscuro.jpg';

const colecciones = (await getCollection('colecciones')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const piezasDestacadas = (await getCollection('piezas'))
  .filter((p) => p.data.destacada)
  .slice(0, 4);

/** A qué catálogo filtrado manda cada colección, cuando tiene sentido. */
const ENLACE_COLECCION: Record<string, string> = {
  'Colección Alba': '/catalogo?material=oro%20rosa',
  'Colección Herencia': '/catalogo?categoria=anillos',
  'Colección Luna': '/catalogo?categoria=aretes',
};

const guia = [
  {
    titulo: 'Cuida tus joyas',
    texto:
      'Guárdalas por separado en bolsas de tela, evita el contacto con perfumes y cremas, y límpialas con un paño suave. La limpieza y el pulido profesional de nuestras piezas son gratis de por vida.',
  },
  {
    titulo: 'Conoce tu talla',
    texto:
      'Mide el diámetro interno de un anillo que te quede bien o el contorno de tu dedo con un hilo. Con esa medida en milímetros te confirmamos la talla exacta por WhatsApp.',
    href: '/guia-de-tallas',
  },
  {
    titulo: 'Oro, plata y oro rosa',
    texto:
      'Trabajamos oro de 18k (75% de pureza), plata 950 y oro rosa de 18k. Si ninguna pieza del catálogo es exactamente lo que buscas, la fabricamos a tu medida.',
    href: '/encargos',
  },
];
---

<BaseLayout>
  <Header links={NAV} cta="Consultar" />

  <main id="contenido">
    <!-- ── 01 · Hero claro ── -->
    <Hero
      eyebrow={`Joyería fina en ${NEGOCIO.ciudad}`}
      titulo="Piezas hechas a mano"
      acento="que guardan tu historia"
      subtitulo="Anillos, collares, aretes y pulseras en oro de 18k, plata 950 y oro rosa. Precios visibles en el catálogo y asesoría real por WhatsApp antes de decidir."
      imagen={fotoHero}
      imagenAlt="Anillos en oro fotografiados de cerca sobre fondo crema"
      ctaTexto="Consultar por WhatsApp"
      ctaMensaje={`Hola, vengo de la página de ${NEGOCIO.nombre} y quiero asesoría para elegir una joya.`}
      ctaSecundario={{ label: 'Ver el catálogo', href: '/catalogo' }}
    />

    <!-- ── 02 · Franja de confianza ── -->
    <FranjaConfianza />

    <!-- ── 03 · Colecciones: composición asimétrica, re-tematizada en claro ── -->
    <section class="bg-surface py-24 md:py-40" id="colecciones" aria-label="Colecciones">
      <div class="container-wide">
        <div class="grid items-end gap-10 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <SectionHeading
              numero="01"
              eyebrow="Colecciones"
              titulo="Tres líneas,"
              acento="un mismo taller"
              descripcion="Cada colección nace de un material y una idea. Todas se fabrican a mano en nuestro taller de Bucaramanga."
            />
          </div>
          <div class="lg:col-span-4 lg:col-start-9 lg:pb-3" data-reveal>
            <a href="/catalogo" class="micro link-rule text-brand-700 hover:text-accent-700">
              Ver el catálogo completo
              <Icono nombre="flecha" tamano={14} />
            </a>
          </div>
        </div>

        <span class="rule-hair mt-14 origin-left" data-rule></span>

        <div class="mt-14 grid gap-6 lg:grid-cols-12" data-reveal-group>
          <!-- La primera colección, grande -->
          {colecciones[0] && (
            <a
              href={ENLACE_COLECCION[colecciones[0].data.nombre] ?? '/catalogo'}
              class="group frame-fine block overflow-hidden bg-paper transition-colors duration-500 hover:border-accent-400 lg:col-span-7"
            >
              <Foto
                src={colecciones[0].data.portada}
                alt={colecciones[0].data.nombre}
                ratio="4/5"
                sizes="(max-width: 1024px) 100vw, 58vw"
                class="transition-all duration-[900ms] ease-[cubic-bezier(.22,.61,.36,1)] group-hover:scale-[1.05]"
              />
              <div class="p-8 md:p-10">
                <span class="micro-sm text-accent-700">Colección</span>
                <h3 class="mt-2 font-display text-3xl leading-tight font-light text-brand-950 md:text-4xl">
                  {colecciones[0].data.nombre}
                </h3>
                <p class="mt-3 max-w-md text-[0.85rem] leading-relaxed font-light text-brand-600">
                  {colecciones[0].data.descripcion}
                </p>
                <span class="micro-sm mt-5 inline-flex items-center gap-2 text-brand-500 transition-colors duration-500 group-hover:text-accent-700">
                  Explorar
                  <span class="h-px w-6 bg-current transition-all duration-700 ease-[cubic-bezier(.22,.61,.36,1)] group-hover:w-10" aria-hidden="true"></span>
                </span>
              </div>
            </a>
          )}

          <!-- Las otras dos, apiladas -->
          <div class="flex flex-col gap-6 lg:col-span-5">
            {colecciones.slice(1).map((c) => (
              <a
                href={ENLACE_COLECCION[c.data.nombre] ?? '/catalogo'}
                class="group frame-fine block overflow-hidden bg-paper transition-colors duration-500 hover:border-accent-400"
              >
                <Foto
                  src={c.data.portada}
                  alt={c.data.nombre}
                  ratio="3/2"
                  sizes="(max-width: 1024px) 100vw, 42vw"
                  class="transition-all duration-[900ms] ease-[cubic-bezier(.22,.61,.36,1)] group-hover:scale-[1.05]"
                />
                <div class="p-7">
                  <span class="micro-sm text-accent-700">Colección</span>
                  <h3 class="mt-2 font-display text-2xl leading-tight font-light text-brand-950">
                    {c.data.nombre}
                  </h3>
                  <p class="mt-3 max-w-md text-[0.85rem] leading-relaxed font-light text-brand-600">
                    {c.data.descripcion}
                  </p>
                  <span class="micro-sm mt-5 inline-flex items-center gap-2 text-brand-500 transition-colors duration-500 group-hover:text-accent-700">
                    Explorar
                    <span class="h-px w-6 bg-current transition-all duration-700 ease-[cubic-bezier(.22,.61,.36,1)] group-hover:w-10" aria-hidden="true"></span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── 04 · Piezas destacadas: grid escalonado ── -->
    <section class="bg-paper py-24 md:py-36" id="destacadas" aria-label="Piezas destacadas">
      <div class="container-wide">
        <SectionHeading
          numero="02"
          eyebrow="Piezas destacadas"
          titulo="Las favoritas"
          acento="de la vitrina"
          descripcion="Precios claros y ficha técnica completa en cada pieza. Si algo te gusta, se consulta y se reserva por WhatsApp."
        />

        <div class="mt-16 grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
          {piezasDestacadas.map((pieza, i) => (
            <PiezaCard pieza={pieza} class={i % 2 === 1 ? 'lg:mt-16' : ''} />
          ))}
        </div>

        <div class="mt-20 flex justify-center" data-reveal>
          <a href="/catalogo" class="micro link-rule text-brand-800 hover:text-accent-700">
            Ver todo el catálogo
            <Icono nombre="flecha" tamano={14} />
          </a>
        </div>
      </div>
    </section>

    <!-- ── 05 · El taller, paso a paso ── -->
    <Taller numero="03" />

    <!-- ── 06 · Historia + contadores: el único bloque oscuro de la portada ── -->
    <section class="relative overflow-hidden bg-brand-950" id="historia" aria-label="Nuestra historia">
      <div class="grid lg:grid-cols-2">
        <!-- Fotografía que sangra hasta el borde de la pantalla -->
        <div class="relative min-h-[58vh] overflow-hidden lg:min-h-[88vh]" data-reveal-mask>
          <div class="absolute inset-0" data-parallax="0.1">
            <Foto
              src={fotoHistoria}
              alt={`El taller de ${NEGOCIO.nombre}`}
              sizes="(max-width: 1024px) 100vw, 50vw"
              class="h-[118%] object-cover"
            />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-brand-950/70 via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:via-transparent lg:to-brand-950/60"></div>
        </div>

        <div class="flex items-center px-6 py-24 sm:px-10 lg:py-32 xl:px-20">
          <div class="max-w-xl" data-reveal>
            <div class="flex items-center gap-4">
              <span class="section-num !text-accent-400">04</span>
              <span class="h-px w-8 bg-accent-400/50" aria-hidden="true"></span>
              <span class="micro text-accent-300">Nuestra historia</span>
            </div>

            <h2 class="type-section mt-7 text-white">
              Un taller familiar,<br />
              <em class="font-normal text-accent-200 italic">tres generaciones</em>
            </h2>

            <p class="mt-8 text-[0.95rem] leading-[1.9] font-light text-brand-300">
              {NEGOCIO.nombre} nació como un banco de joyero en el centro de Bucaramanga. Hoy seguimos
              haciendo cada pieza a mano: fundimos, laminamos, engastamos y pulimos en nuestro propio
              taller, con materiales certificados y garantía escrita.
            </p>
            <p class="mt-5 text-[0.95rem] leading-[1.9] font-light text-brand-300">
              Por eso también recibimos encargos: si sueñas una pieza que no existe, la dibujamos
              contigo y la fabricamos a tu medida.
            </p>

            <div class="mt-14 grid grid-cols-3 gap-6 border-t border-white/15 pt-10">
              <div>
                <p class="font-display text-4xl font-light text-accent-300 md:text-5xl"><span data-counter={ANOS_OFICIO}>0</span></p>
                <p class="micro-sm mt-3 text-brand-400">Años de oficio</p>
              </div>
              <div>
                <p class="font-display text-4xl font-light text-accent-300 md:text-5xl"><span data-counter={NEGOCIO.piezasEntregadas}>0</span>+</p>
                <p class="micro-sm mt-3 text-brand-400">Piezas entregadas</p>
              </div>
              <div>
                <p class="font-display text-4xl font-light text-accent-300 md:text-5xl"><span data-counter={NEGOCIO.encargosAMedida}>0</span>+</p>
                <p class="micro-sm mt-3 text-brand-400">Encargos a medida</p>
              </div>
            </div>

            <a href="/encargos" class="btn btn-outline-claro mt-12">
              Cómo funcionan los encargos
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 07 · Testimonios ── -->
    <Testimonios
      numero="05"
      items={[
        {
          nombre: 'Laura Méndez',
          ciudad: 'Bucaramanga',
          texto:
            'Vi el Solitario Aurora en la página con el precio y la ficha completa. Por WhatsApp me confirmaron que en talla 6 había una unidad disponible y al día siguiente lo recogí en la tienda de Cabecera. Costó $3.850.000, tal cual estaba publicado, sin sorpresas.',
          detalle: 'Compró el Anillo Solitario Aurora, talla 6',
        },
        {
          nombre: 'Andrés Rueda',
          ciudad: 'Floridablanca',
          texto:
            'Encargamos las Argollas Clásicas Aurea para la boda: la mía en talla 10 y la de mi esposa en talla 6, con el grabado interior incluido. Nos mandaron fotos del avance en el taller y las tuvimos listas en los 15 días hábiles que nos dijeron por WhatsApp.',
          detalle: 'Encargo de Argollas Clásicas Aurea, talla 10 y 6',
        },
        {
          nombre: 'Carolina Prada',
          ciudad: 'Girón',
          texto:
            'Compré la Pulsera Rosa del Alba financiada con Addi: la aprobación llegó por WhatsApp en menos de diez minutos y terminé pagando los $1.350.000 en cuotas. Llegó con su certificado de materiales y la garantía escrita, tal como lo prometen en la página.',
          detalle: 'Compró la Pulsera Rosa del Alba, financiada con Addi',
        },
      ]}
    />

    <!-- ── 08 · Cómo compras aquí + medios de pago ── -->
    <ComoCompras numero="06" />

    <!-- ── 09 · Guía rápida ── -->
    <section class="py-24 md:py-32" id="guia" aria-label="Guía rápida antes de comprar">
      <div class="container-wide grid gap-14 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <SectionHeading
              numero="07"
              eyebrow="Guía rápida"
              titulo="Antes de"
              acento="elegir tu joya"
              descripcion="Lo esencial sobre materiales, tallas y cuidado, para que compres con confianza."
            />
          </div>
        </div>

        <dl class="lg:col-span-7 lg:col-start-6" data-reveal-group>
          {guia.map((g, i) => {
            const Contenedor = g.href ? 'a' : 'div';
            return (
              <div class="grid gap-4 border-t border-brand-200 py-10 last:border-b sm:grid-cols-[auto_1fr] sm:gap-10">
                <dt class="section-num pt-1">0{i + 1}</dt>
                <dd>
                  <Contenedor
                    href={g.href}
                    class={g.href ? 'group inline-flex items-center gap-3' : undefined}
                  >
                    <h3 class={`type-sub text-brand-950 ${g.href ? 'transition-colors duration-500 group-hover:text-accent-700' : ''}`}>
                      {g.titulo}
                    </h3>
                    {g.href && (
                      <Icono
                        nombre="flecha"
                        tamano={14}
                        class="text-accent-600 transition-transform duration-500 group-hover:translate-x-1"
                      />
                    )}
                  </Contenedor>
                  <p class="mt-4 max-w-lg text-[0.9rem] leading-[1.9] font-light text-brand-600">{g.texto}</p>
                </dd>
              </div>
            );
          })}
        </dl>
      </div>
    </section>

    <!-- ── 10 · FAQ ── -->
    <FAQ
      numero="08"
      items={[
        {
          pregunta: '¿Las piezas tienen garantía?',
          respuesta:
            'Sí. Toda pieza sale con certificado de materiales y garantía escrita de un año que cubre defectos de fabricación, engastes y broches. La limpieza y el pulido de nuestras piezas son gratis de por vida.',
        },
        {
          pregunta: '¿Cómo sé que el oro es de verdad 18k?',
          respuesta:
            'Cada pieza lleva el contraste de ley (750 para oro 18k, 950 para plata) grabado, como exige la norma colombiana, y sale con su certificado de materiales. Si la piedra tiene certificación GIA o IGI, también va incluida.',
        },
        {
          pregunta: '¿Hacen envíos a otras ciudades?',
          respuesta:
            'Hacemos envíos asegurados a toda Colombia con transportadoras especializadas en valores. En Bucaramanga y su área metropolitana la entrega puede ser personal el mismo día.',
        },
        {
          pregunta: '¿Cómo se paga y se reserva una pieza?',
          respuesta:
            'Reservas con el 30% por transferencia, Nequi o en la tienda, y pagas el resto al recibir. También aceptamos Addi y Sistecrédito para diferir a cuotas: la aprobación se hace por WhatsApp y toma minutos. No manejamos pagos dentro de la página: preferimos confirmar cada detalle contigo antes de cerrar la compra.',
        },
        {
          pregunta: '¿Qué pasa si el anillo no me queda?',
          respuesta:
            'El primer ajuste de talla es gratuito dentro de los 30 días siguientes a la compra. Solo necesitas traer la pieza con su certificado.',
        },
      ]}
    />

    <!-- ── Contacto ── -->
    <Contacto
      numero="09"
      titulo="Visita la vitrina"
      descripcion="Estamos en Cabecera, Bucaramanga. Si prefieres, te asesoramos por WhatsApp antes de venir."
    />

    <!-- ── CTA final ── -->
    <CTA
      titulo="¿Viste algo que te encantó?"
      descripcion="Escríbenos por WhatsApp con la referencia de la pieza y te confirmamos disponibilidad, talla y entrega en minutos."
      botonTexto="Consultar una pieza"
      mensaje={`Hola, vengo de la página de ${NEGOCIO.nombre}. Quiero consultar por una pieza del catálogo.`}
    />
  </main>

  <Footer links={NAV_FOOTER} />
  <WhatsAppFlotante mensaje={`Hola, vengo de la página de ${NEGOCIO.nombre} y quiero asesoría para elegir una joya.`} />
</BaseLayout>
