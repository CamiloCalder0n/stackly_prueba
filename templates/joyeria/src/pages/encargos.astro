---
// Cotizador de encargos: asistente de varios pasos, sin backend, que
// termina abriendo WhatsApp con un mensaje estructurado y legible. Guarda
// borrador en localStorage para que nadie pierda lo que llevaba escrito.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import Icono from '../components/Icono.astro';
import { NEGOCIO } from '../scripts/site';
import { NAV } from '../scripts/navegacion';

/** Convierte una opción en un id de HTML válido y estable. */
function slugificar(texto: string): string {
  return texto
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

const OPCIONES_PIEZA = ['Anillo', 'Collar', 'Aretes', 'Pulsera', 'Argollas de matrimonio', 'Otro'];
const OPCIONES_MATERIAL = ['Oro 18k', 'Oro 14k', 'Oro rosa 18k', 'Plata 950', 'No sé, asesórenme'];
const OPCIONES_PIEDRA = ['Sin piedra', 'Diamante', 'Esmeralda colombiana', 'Zafiro', 'Topacio', 'Perla', 'No sé'];
const OPCIONES_PRESUPUESTO = [
  'Menos de $500.000',
  '$500.000 – $1.500.000',
  '$1.500.000 – $3.000.000',
  '$3.000.000 – $6.000.000',
  'Más de $6.000.000',
  'Prefiero que me asesoren',
];

const pasos = [
  { titulo: '¿Qué quieres encargar?', eyebrow: 'Paso 1' },
  { titulo: 'Material y ley', eyebrow: 'Paso 2' },
  { titulo: '¿Lleva piedra?', eyebrow: 'Paso 3' },
  { titulo: 'Presupuesto aproximado', eyebrow: 'Paso 4' },
  { titulo: '¿Para cuándo lo necesitas?', eyebrow: 'Paso 5' },
  { titulo: 'Cuéntanos tu idea', eyebrow: 'Paso 6' },
  { titulo: 'Revisa y envía', eyebrow: 'Último paso' },
];
const TOTAL_PASOS_CONTENIDO = pasos.length - 1; // el último es el resumen
---

<BaseLayout
  title="Encargos"
  description={`Cotiza un encargo a la medida en ${NEGOCIO.nombre}: cuéntanos tu idea en un asistente de un minuto y recíbelo listo para enviar por WhatsApp. Sin registros ni pagos en línea.`}
>
  <Header links={NAV} />


  <main id="contenido">
  <!-- ── Encabezado ── -->
  <section class="border-b border-brand-200 bg-surface py-24 md:py-32">
    <div class="container-wide">
      <div class="flex items-center gap-4">
        <span class="h-px w-10 bg-accent-500/70" aria-hidden="true"></span>
        <span class="micro text-accent-700">Encargos a la medida</span>
      </div>
      <h1 class="type-hero mt-7 max-w-4xl text-brand-950" data-split="hero">
        Tu idea,<br /><em class="font-normal text-accent-600 italic">hecha en el taller</em>
      </h1>
      <p class="mt-8 max-w-lg text-[0.95rem] leading-[1.9] font-light text-brand-600">
        Cuéntanos qué tienes en mente en seis pasos cortos y te llega un mensaje ya armado y
        listo para enviar por WhatsApp. Así funciona un encargo: lo revisamos, te mandamos un
        boceto, cotizamos y, si apruebas, fabricamos. Uno típico tarda entre 2 y 4 semanas.
      </p>
    </div>
  </section>

  <!-- ── Asistente ── -->
  <section class="py-20 md:py-28" id="asistente">
    <div class="container-site">
      <div class="mx-auto max-w-2xl">
        <!-- Aviso de borrador guardado -->
        <div id="banner-borrador" class="mb-10 flex flex-col gap-4 border border-accent-400 bg-accent-50/50 p-6 sm:flex-row sm:items-center sm:justify-between" hidden>
          <p id="banner-borrador-texto" class="text-[0.85rem] leading-relaxed font-light text-brand-800"></p>
          <div class="flex shrink-0 gap-3">
            <button type="button" id="banner-continuar" class="btn btn-outline !px-4 !py-2 !text-[0.65rem]">Continuar</button>
            <button type="button" id="banner-nuevo" class="btn btn-outline !px-4 !py-2 !text-[0.65rem]">Empezar de nuevo</button>
          </div>
        </div>

        <!-- Barra de progreso -->
        <div class="mb-12">
          <div class="flex items-center justify-between">
            <p id="paso-texto" class="micro-sm text-brand-500">Paso 1 de {TOTAL_PASOS_CONTENIDO}</p>
            <p id="paso-titulo-corto" class="micro-sm text-accent-700"></p>
          </div>
          <div class="mt-3 h-px w-full bg-brand-200" role="presentation">
            <div id="barra-progreso" class="h-px bg-accent-500 transition-[width] duration-500 ease-[cubic-bezier(.22,.61,.36,1)]" style="width: 14.28%"></div>
          </div>
        </div>

        <!-- Anuncio para lectores de pantalla: el cambio de paso no recarga la página -->
        <p id="anuncio-paso" class="sr-only" aria-live="polite"></p>

        <form id="asistente-encargo" novalidate>
          <!-- Paso 1 · Tipo de pieza -->
          <fieldset id="paso-1" data-paso="0" tabindex="-1">
            <legend class="type-sub text-brand-950">¿Qué quieres encargar?</legend>
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
              {OPCIONES_PIEZA.map((op) => {
                const id = `pieza-${slugificar(op)}`;
                return (
                  <div class="opcion">
                    <input type="radio" id={id} name="tipoPieza" value={op} class="peer sr-only" />
                    <label for={id} class="opcion-label">{op}</label>
                  </div>
                );
              })}
            </div>
            <div id="tipo-otro-envoltura" class="mt-6" hidden>
              <label for="tipo-otro-detalle" class="micro-sm mb-2 block text-brand-500">¿Qué pieza es?</label>
              <input
                id="tipo-otro-detalle"
                name="tipoOtroDetalle"
                type="text"
                class="w-full border-0 border-b border-brand-300 bg-transparent px-0 py-3 text-sm font-light text-brand-900 outline-none transition-colors duration-500 placeholder:text-brand-400 focus:border-accent-500"
                placeholder="Ej. Dije, tobillera, prendedor…"
              />
            </div>
            <p id="error-0" class="campo-error mt-4" role="alert" hidden></p>
          </fieldset>

          <!-- Paso 2 · Material y ley -->
          <fieldset id="paso-2" data-paso="1" tabindex="-1" hidden>
            <legend class="type-sub text-brand-950">¿En qué material la imaginas?</legend>
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
              {OPCIONES_MATERIAL.map((op) => {
                const id = `material-${slugificar(op)}`;
                return (
                  <div class="opcion">
                    <input type="radio" id={id} name="material" value={op} class="peer sr-only" />
                    <label for={id} class="opcion-label">{op}</label>
                  </div>
                );
              })}
            </div>
            <p id="error-1" class="campo-error mt-4" role="alert" hidden></p>
          </fieldset>

          <!-- Paso 3 · Piedra -->
          <fieldset id="paso-3" data-paso="2" tabindex="-1" hidden>
            <legend class="type-sub text-brand-950">¿Lleva piedra?</legend>
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
              {OPCIONES_PIEDRA.map((op) => {
                const id = `piedra-${slugificar(op)}`;
                return (
                  <div class="opcion">
                    <input type="radio" id={id} name="piedra" value={op} class="peer sr-only" />
                    <label for={id} class="opcion-label">{op}</label>
                  </div>
                );
              })}
            </div>
            <p id="error-2" class="campo-error mt-4" role="alert" hidden></p>
          </fieldset>

          <!-- Paso 4 · Presupuesto -->
          <fieldset id="paso-4" data-paso="3" tabindex="-1" hidden>
            <legend class="type-sub text-brand-950">¿Cuál es tu presupuesto aproximado?</legend>
            <p class="mt-3 text-[0.85rem] font-light text-brand-500">
              Es solo una referencia para orientar la propuesta; el precio final depende del diseño.
            </p>
            <div class="mt-8 grid gap-3">
              {OPCIONES_PRESUPUESTO.map((op) => {
                const id = `presupuesto-${slugificar(op)}`;
                return (
                  <div class="opcion">
                    <input type="radio" id={id} name="presupuesto" value={op} class="peer sr-only" />
                    <label for={id} class="opcion-label">{op}</label>
                  </div>
                );
              })}
            </div>
            <p id="error-3" class="campo-error mt-4" role="alert" hidden></p>
          </fieldset>

          <!-- Paso 5 · Para cuándo -->
          <fieldset id="paso-5" data-paso="4" tabindex="-1" hidden>
            <legend class="type-sub text-brand-950">¿Para cuándo lo necesitas?</legend>
            <p class="mt-3 text-[0.85rem] font-light text-brand-500">
              Un encargo típico tarda entre 2 y 4 semanas: boceto, cotización, aprobación y
              fabricación. Si tienes una fecha límite, dínosla para confirmarte si alcanza.
            </p>
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
              <div class="opcion">
                <input type="radio" id="tiempo-sin-afan" name="tiempo" value="sin-afan" class="peer sr-only" />
                <label for="tiempo-sin-afan" class="opcion-label">Sin afán, cuando esté listo</label>
              </div>
              <div class="opcion">
                <input type="radio" id="tiempo-fecha" name="tiempo" value="fecha" class="peer sr-only" />
                <label for="tiempo-fecha" class="opcion-label">Tengo una fecha en mente</label>
              </div>
            </div>
            <div id="fecha-envoltura" class="mt-6" hidden>
              <label for="fecha-limite" class="micro-sm mb-2 block text-brand-500">Fecha límite</label>
              <input
                id="fecha-limite"
                name="fechaLimite"
                type="date"
                class="w-full border-0 border-b border-brand-300 bg-transparent px-0 py-3 text-sm font-light text-brand-900 outline-none transition-colors duration-500 focus:border-accent-500"
              />
            </div>
            <p id="error-4" class="campo-error mt-4" role="alert" hidden></p>
          </fieldset>

          <!-- Paso 6 · Descripción libre -->
          <fieldset id="paso-6" data-paso="5" tabindex="-1" hidden>
            <legend class="type-sub text-brand-950">Cuéntanos tu idea</legend>
            <div class="mt-8 space-y-8">
              <div>
                <label for="idea" class="micro-sm mb-2 block text-brand-500">
                  Describe la pieza que imaginas
                </label>
                <textarea
                  id="idea"
                  name="idea"
                  rows="4"
                  class="w-full border border-brand-300 bg-transparent px-4 py-3 text-sm leading-relaxed font-light text-brand-900 outline-none transition-colors duration-500 placeholder:text-brand-400 focus:border-accent-500"
                  placeholder="Ej. Un anillo delgado con una línea de diamantes pequeños, para uso diario."
                ></textarea>
                <p id="error-5" class="campo-error mt-3" role="alert" hidden></p>
              </div>
              <div>
                <label for="inspiracion" class="micro-sm mb-2 block text-brand-500">
                  ¿De dónde viene la inspiración? <span class="text-brand-400 normal-case">(opcional)</span>
                </label>
                <textarea
                  id="inspiracion"
                  name="inspiracion"
                  rows="3"
                  class="w-full border border-brand-300 bg-transparent px-4 py-3 text-sm leading-relaxed font-light text-brand-900 outline-none transition-colors duration-500 placeholder:text-brand-400 focus:border-accent-500"
                  placeholder="Una foto que viste, una pieza de familia, un lugar…"
                ></textarea>
              </div>
              <div>
                <label for="nombre" class="micro-sm mb-2 block text-brand-500">
                  Tu nombre <span class="text-brand-400 normal-case">(opcional, para dirigirnos a ti)</span>
                </label>
                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  class="w-full border-0 border-b border-brand-300 bg-transparent px-0 py-3 text-sm font-light text-brand-900 outline-none transition-colors duration-500 placeholder:text-brand-400 focus:border-accent-500"
                  placeholder="Ej. Camila Rueda"
                />
              </div>
            </div>
          </fieldset>

          <!-- Paso 7 · Resumen -->
          <div id="paso-7" data-paso="6" tabindex="-1" hidden>
            <h2 class="type-sub text-brand-950">Revisa antes de enviar</h2>
            <p class="mt-3 text-[0.85rem] leading-relaxed font-light text-brand-500">
              Así llega tu mensaje a nuestro WhatsApp. Puedes volver a cualquier paso para
              corregir algo.
            </p>
            <dl id="resumen-contenido" class="mt-8 divide-y divide-brand-200 border-t border-b border-brand-200"></dl>
            <p class="mt-6 text-xs leading-[1.8] font-light text-brand-500">
              Al enviar se abre WhatsApp con este mensaje ya escrito. Lo revisamos, te mandamos
              un boceto y una cotización; si apruebas, fabricamos. Un encargo típico tarda entre
              2 y 4 semanas.
            </p>
          </div>

          <!-- Navegación -->
          <div class="mt-12 flex items-center justify-between gap-4 border-t border-brand-200 pt-8">
            <button type="button" id="boton-atras" class="btn btn-outline" hidden>
              <Icono nombre="flecha-izq" tamano={14} />
              Atrás
            </button>
            <div class="ml-auto flex gap-3">
              <button type="button" id="boton-continuar" class="btn btn-primary">
                Continuar
                <Icono nombre="flecha" tamano={14} />
              </button>
              <button type="submit" id="boton-enviar" class="btn btn-whatsapp" hidden>
                <Icono nombre="whatsapp" tamano={16} />
                Enviar por WhatsApp
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
  </main>


  <Footer />
  <WhatsAppFlotante mensaje={`Hola, vengo de la página de encargos de ${NEGOCIO.nombre} y tengo una duda antes de cotizar.`} />
</BaseLayout>

<style>
  .opcion {
    position: relative;
  }
  .opcion-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--color-brand-300);
    padding: 0.9rem 1.1rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--color-brand-800);
    cursor: pointer;
    transition: border-color 0.4s var(--ease-silk), background-color 0.4s var(--ease-silk),
      color 0.4s var(--ease-silk);
  }
  .opcion-label::before {
    content: '';
    flex-shrink: 0;
    width: 0.9rem;
    height: 0.9rem;
    border: 1px solid var(--color-brand-400);
    border-radius: 999px;
    transition: border-color 0.4s var(--ease-silk);
  }
  .opcion-label:hover {
    border-color: var(--color-brand-500);
  }
  .peer:checked + .opcion-label {
    border-color: var(--color-accent-500);
    background: var(--color-accent-50);
    color: var(--color-brand-950);
  }
  .peer:checked + .opcion-label::before {
    border-color: var(--color-accent-600);
    background: radial-gradient(circle, var(--color-accent-600) 44%, transparent 48%);
  }
  .peer:focus-visible + .opcion-label {
    outline: 2px solid var(--color-accent-600);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .campo-error {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 400;
    color: #b3431f;
  }

  #resumen-contenido dt {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-brand-500);
  }
  #resumen-contenido dd {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--color-brand-900);
    white-space: pre-line;
  }
</style>

<script>
  /* ── Asistente de encargos ──────────────────────────────────────────
     Sin backend: todo vive en el DOM y en localStorage. Los scripts de
     componente no se re-ejecutan tras una navegación del ClientRouter,
     así que el montaje va colgado de `astro:page-load` (dispara también
     en la carga inicial). */
  import { NEGOCIO, waLink } from '../scripts/site';

  const CLAVE_BORRADOR = 'aurea-encargo-borrador';

  const TITULOS = [
    'Tipo de pieza',
    'Material y ley',
    'Piedra',
    'Presupuesto',
    'Para cuándo',
    'Tu idea',
  ];
  // Las constantes de la frontmatter de Astro no llegan a este módulo del
  // navegador, así que el total de pasos se deriva aquí, no se reimporta.
  const TOTAL_PASOS_CONTENIDO = TITULOS.length;

  function montar(): void {
    const form = document.getElementById('asistente-encargo') as HTMLFormElement | null;
    if (!form) return;

    // Todos los pasos, incluido el resumen, llevan `data-paso` y viven dentro
    // del <form>, así que una sola consulta los recoge. Se ordena por el
    // atributo para no depender del orden del DOM.
    const pasosEl = Array.from(form.querySelectorAll<HTMLElement>('[data-paso]')).sort(
      (a, b) => Number(a.dataset.paso) - Number(b.dataset.paso),
    );
    const ULTIMO_INDICE = pasosEl.length - 1;

    const botonAtras = document.getElementById('boton-atras') as HTMLButtonElement | null;
    const botonContinuar = document.getElementById('boton-continuar') as HTMLButtonElement | null;
    const botonEnviar = document.getElementById('boton-enviar') as HTMLButtonElement | null;
    const barraProgreso = document.getElementById('barra-progreso');
    const pasoTexto = document.getElementById('paso-texto');
    const pasoTituloCorto = document.getElementById('paso-titulo-corto');
    const anuncio = document.getElementById('anuncio-paso');
    const resumenContenido = document.getElementById('resumen-contenido');

    const otroEnvoltura = document.getElementById('tipo-otro-envoltura');
    const otroDetalle = document.getElementById('tipo-otro-detalle') as HTMLInputElement | null;
    const fechaEnvoltura = document.getElementById('fecha-envoltura');
    const fechaLimite = document.getElementById('fecha-limite') as HTMLInputElement | null;

    const bannerBorrador = document.getElementById('banner-borrador');
    const bannerTexto = document.getElementById('banner-borrador-texto');
    const bannerContinuar = document.getElementById('banner-continuar');
    const bannerNuevo = document.getElementById('banner-nuevo');

    if (
      !botonAtras || !botonContinuar || !botonEnviar || !barraProgreso || !pasoTexto ||
      !anuncio || !resumenContenido || !otroEnvoltura || !otroDetalle || !fechaEnvoltura || !fechaLimite
    ) {
      return;
    }

    let pasoActual = 0;

    function valorRadio(nombre: string): string {
      const el = form!.querySelector<HTMLInputElement>(`input[name="${nombre}"]:checked`);
      return el ? el.value : '';
    }

    function actualizarCondicionales(): void {
      otroEnvoltura!.hidden = valorRadio('tipoPieza') !== 'Otro';
      fechaEnvoltura!.hidden = valorRadio('tiempo') !== 'fecha';
    }

    function ocultarError(indice: number): void {
      const error = document.getElementById(`error-${indice}`);
      if (error) {
        error.hidden = true;
        error.textContent = '';
      }
    }

    function marcarError(indice: number, mensaje: string, focoId?: string): boolean {
      const error = document.getElementById(`error-${indice}`);
      if (error) {
        error.textContent = mensaje;
        error.hidden = false;
      }
      const contenedor = pasosEl[indice];
      const foco =
        (focoId && document.getElementById(focoId)) ||
        contenedor.querySelector<HTMLElement>('input:not([type="hidden"]), textarea');
      if (focoId) {
        document.getElementById(focoId)?.setAttribute('aria-invalid', 'true');
        document.getElementById(focoId)?.setAttribute('aria-describedby', `error-${indice}`);
      }
      foco?.focus();
      return false;
    }

    function validarPaso(indice: number): boolean {
      ocultarError(indice);
      switch (indice) {
        case 0: {
          const valor = valorRadio('tipoPieza');
          if (!valor) return marcarError(0, 'Elige qué quieres encargar para continuar.');
          if (valor === 'Otro' && !otroDetalle!.value.trim()) {
            return marcarError(0, 'Cuéntanos qué pieza es.', 'tipo-otro-detalle');
          }
          return true;
        }
        case 1:
          return valorRadio('material') ? true : marcarError(1, 'Elige un material para continuar.');
        case 2:
          return valorRadio('piedra') ? true : marcarError(2, 'Elige una opción de piedra para continuar.');
        case 3:
          return valorRadio('presupuesto')
            ? true
            : marcarError(3, 'Elige un rango de presupuesto para continuar.');
        case 4: {
          const tiempo = valorRadio('tiempo');
          if (!tiempo) return marcarError(4, 'Elige si tienes una fecha límite.');
          if (tiempo === 'fecha' && !fechaLimite!.value) {
            return marcarError(4, 'Elige la fecha que tienes en mente.', 'fecha-limite');
          }
          return true;
        }
        case 5: {
          const idea = document.getElementById('idea') as HTMLTextAreaElement | null;
          if (!idea || !idea.value.trim()) {
            return marcarError(5, 'Cuéntanos tu idea, aunque sea en pocas palabras.', 'idea');
          }
          return true;
        }
        default:
          return true;
      }
    }

    function formatearFecha(iso: string): string {
      const [anio, mes, dia] = iso.split('-').map(Number);
      if (!anio || !mes || !dia) return iso;
      return new Date(anio, mes - 1, dia).toLocaleDateString('es-CO', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
      });
    }

    function leerValores(): Record<string, string> {
      const datos = new FormData(form!);
      const valores: Record<string, string> = {};
      datos.forEach((valor, clave) => {
        valores[clave] = String(valor);
      });
      return valores;
    }

    function actualizarResumen(): void {
      const v = leerValores();
      const filas: { titulo: string; valor: string; paso: number }[] = [
        {
          titulo: 'Pieza',
          valor: v.tipoPieza === 'Otro' ? v.tipoOtroDetalle || 'Otro' : v.tipoPieza || '—',
          paso: 0,
        },
        { titulo: 'Material', valor: v.material || '—', paso: 1 },
        { titulo: 'Piedra', valor: v.piedra || '—', paso: 2 },
        { titulo: 'Presupuesto', valor: v.presupuesto || '—', paso: 3 },
        {
          titulo: 'Para cuándo',
          valor: v.tiempo === 'fecha' && v.fechaLimite
            ? `Antes del ${formatearFecha(v.fechaLimite)}`
            : 'Sin afán, cuando esté listo',
          paso: 4,
        },
        { titulo: 'Tu idea', valor: v.idea || '—', paso: 5 },
      ];
      if (v.inspiracion) filas.push({ titulo: 'Inspiración', valor: v.inspiracion, paso: 5 });
      if (v.nombre) filas.push({ titulo: 'Nombre', valor: v.nombre, paso: 5 });

      resumenContenido!.innerHTML = '';
      filas.forEach((fila) => {
        const div = document.createElement('div');
        div.className = 'flex items-start justify-between gap-6 py-5';
        const info = document.createElement('div');
        const dt = document.createElement('dt');
        dt.textContent = fila.titulo;
        const dd = document.createElement('dd');
        dd.textContent = fila.valor;
        info.append(dt, dd);
        const editar = document.createElement('button');
        editar.type = 'button';
        editar.className = 'micro-sm shrink-0 text-brand-500 underline decoration-brand-300 underline-offset-4 transition-colors duration-500 hover:text-accent-700';
        editar.textContent = 'Editar';
        editar.addEventListener('click', () => irAPaso(fila.paso));
        div.append(info, editar);
        resumenContenido!.appendChild(div);
      });
    }

    function construirMensaje(): string {
      const v = leerValores();
      const pieza = v.tipoPieza === 'Otro' ? v.tipoOtroDetalle || 'Otro' : v.tipoPieza;
      const tiempo = v.tiempo === 'fecha' && v.fechaLimite
        ? `Antes del ${formatearFecha(v.fechaLimite)}`
        : 'Sin afán, cuando esté listo';

      const lineas = [
        `Hola, vengo de la página de ${NEGOCIO.nombre} y quiero cotizar un encargo.`,
        `Pieza: ${pieza}`,
        `Material: ${v.material}`,
        `Piedra: ${v.piedra}`,
        `Presupuesto: ${v.presupuesto}`,
        `Para cuándo: ${tiempo}`,
        `Idea: ${v.idea}`,
      ];
      if (v.inspiracion) lineas.push(`Inspiración: ${v.inspiracion}`);
      if (v.nombre) lineas.push(`Nombre: ${v.nombre}`);
      return lineas.join('\n');
    }

    function guardarBorrador(): void {
      try {
        localStorage.setItem(
          CLAVE_BORRADOR,
          JSON.stringify({ paso: pasoActual, valores: leerValores(), guardadoEn: new Date().toISOString() }),
        );
      } catch {
        // localStorage puede fallar en navegación privada: no es crítico para el asistente.
      }
    }

    function irAPaso(indice: number): void {
      pasoActual = Math.max(0, Math.min(indice, ULTIMO_INDICE));
      pasosEl.forEach((el, i) => {
        el.hidden = i !== pasoActual;
      });

      const enResumen = pasoActual === ULTIMO_INDICE;
      botonAtras!.hidden = pasoActual === 0;
      botonContinuar!.hidden = enResumen;
      botonEnviar!.hidden = !enResumen;

      const porcentaje = ((pasoActual + 1) / pasosEl.length) * 100;
      barraProgreso!.style.width = `${porcentaje}%`;
      pasoTexto!.textContent = enResumen
        ? 'Revisa antes de enviar'
        : `Paso ${pasoActual + 1} de ${TOTAL_PASOS_CONTENIDO}`;
      if (pasoTituloCorto) pasoTituloCorto.textContent = enResumen ? '' : TITULOS[pasoActual];
      anuncio!.textContent = enResumen
        ? 'Último paso: revisa antes de enviar.'
        : `Paso ${pasoActual + 1} de ${TOTAL_PASOS_CONTENIDO}: ${TITULOS[pasoActual]}`;

      if (enResumen) actualizarResumen();

      const foco = pasosEl[pasoActual];
      foco.focus({ preventScroll: false });

      guardarBorrador();
    }

    function intentarAvanzar(): void {
      if (!validarPaso(pasoActual)) return;
      irAPaso(pasoActual + 1);
    }

    botonContinuar.addEventListener('click', intentarAvanzar);
    botonAtras.addEventListener('click', () => irAPaso(pasoActual - 1));

    // Radios que revelan un campo adicional al elegirse.
    form.addEventListener('change', (e) => {
      const objetivo = e.target as HTMLInputElement;
      if (objetivo.name === 'tipoPieza' || objetivo.name === 'tiempo') actualizarCondicionales();
      guardarBorrador();
    });
    form.addEventListener('input', guardarBorrador);

    // Enter en un campo de texto avanza de paso; en el resumen, envía.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (pasoActual === ULTIMO_INDICE) {
        const mensaje = construirMensaje();
        try {
          localStorage.removeItem(CLAVE_BORRADOR);
        } catch {
          // no crítico
        }
        window.open(waLink(mensaje), '_blank', 'noopener');
      } else {
        intentarAvanzar();
      }
    });

    // ── Borrador guardado ──
    interface Borrador {
      paso: number;
      valores: Record<string, string>;
      guardadoEn: string;
    }

    function restaurarValores(valores: Record<string, string>): void {
      Object.entries(valores).forEach(([clave, valor]) => {
        const radios = form!.querySelectorAll<HTMLInputElement>(`input[type="radio"][name="${clave}"]`);
        if (radios.length) {
          radios.forEach((r) => {
            r.checked = r.value === valor;
          });
          return;
        }
        const campo = form!.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${clave}"]`);
        if (campo) campo.value = valor;
      });
      actualizarCondicionales();
    }

    function hayContenido(valores: Record<string, string>): boolean {
      return Object.values(valores).some((v) => v && v.trim() !== '');
    }

    let borradorGuardado: Borrador | null = null;
    try {
      const crudo = localStorage.getItem(CLAVE_BORRADOR);
      if (crudo) borradorGuardado = JSON.parse(crudo);
    } catch {
      borradorGuardado = null;
    }

    if (borradorGuardado && hayContenido(borradorGuardado.valores) && bannerBorrador && bannerTexto) {
      const fecha = new Date(borradorGuardado.guardadoEn).toLocaleDateString('es-CO', {
        day: 'numeric',
        month: 'long',
      });
      bannerTexto.textContent = `Tienes un borrador de encargo sin terminar del ${fecha}. ¿Quieres continuarlo?`;
      bannerBorrador.hidden = false;

      bannerContinuar?.addEventListener('click', () => {
        restaurarValores(borradorGuardado!.valores);
        bannerBorrador.hidden = true;
        irAPaso(Math.min(borradorGuardado!.paso, ULTIMO_INDICE));
      });
      bannerNuevo?.addEventListener('click', () => {
        try {
          localStorage.removeItem(CLAVE_BORRADOR);
        } catch {
          // no crítico
        }
        form!.reset();
        actualizarCondicionales();
        bannerBorrador.hidden = true;
        irAPaso(0);
      });
    }

    irAPaso(0);
  }

  document.addEventListener('astro:page-load', montar);
</script>
