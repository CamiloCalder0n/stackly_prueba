---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { NEGOCIO } from '../scripts/site';
import horarios from '../data/horarios.json';

interface Props {
  title?: string;
  description?: string;
  /** URL absoluta de imagen para compartir en redes (og:image). */
  image?: string;
}

const {
  title = NEGOCIO.nombre,
  description = NEGOCIO.descripcion,
  image,
} = Astro.props;

const fullTitle = title === NEGOCIO.nombre ? `${NEGOCIO.nombre} — ${NEGOCIO.eslogan}` : `${title} | ${NEGOCIO.nombre}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Horarios (src/data/horarios.json) → schema.org OpeningHoursSpecification
const DIAS_SCHEMA: Record<string, string> = {
  lunes: 'Monday',
  martes: 'Tuesday',
  miercoles: 'Wednesday',
  jueves: 'Thursday',
  viernes: 'Friday',
  sabado: 'Saturday',
  domingo: 'Sunday',
};
const openingHours = Object.entries(horarios)
  .filter(([, h]) => h.abierto)
  .map(([dia, h]) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: DIAS_SCHEMA[dia],
    opens: h.apertura,
    closes: h.cierre,
  }));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NEGOCIO.nombre} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Las tipografías son variables y self-hosted: se declaran en
         global.css, sin peticiones bloqueantes a un CDN externo. -->

    <!-- Datos estructurados: barbería local con horarios -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BarberShop',
        name: NEGOCIO.nombre,
        description: NEGOCIO.descripcion,
        telephone: NEGOCIO.telefono,
        email: NEGOCIO.correo,
        priceRange: '$',
        address: {
          '@type': 'PostalAddress',
          streetAddress: NEGOCIO.direccion,
          addressLocality: NEGOCIO.ciudad,
          addressCountry: 'CO',
        },
        openingHoursSpecification: openingHours,
        sameAs: [NEGOCIO.instagram, NEGOCIO.facebook].filter(Boolean),
      })}
    />

    <!-- Datos estructurados adicionales por página (ej. FAQPage) -->
    <slot name="head" />

    <ClientRouter />
  </head>
  <body>
    <!-- Enlace de salto: obligatorio para navegación por teclado.
         El destino es el landmark `main#contenido` de index.astro. -->
    <a
      href="#contenido"
      class="sr-only text-xs font-semibold tracking-widest uppercase focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-accent-500 focus:px-5 focus:py-3 focus:text-noche"
    >
      Saltar al contenido
    </a>
    <slot />
    <script src="../scripts/animations.ts"></script>
  </body>
</html>
