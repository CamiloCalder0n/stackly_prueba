---
import '../styles/global.css';
import { NEGOCIO } from '../scripts/site';
import horarios from '../data/horarios.json';

interface Props {
  title?: string;
  description?: string;
  /** URL absoluta de imagen para compartir en redes (og:image). */
  image?: string;
}

const {
  title = NEGOCIO.nombre,
  description = NEGOCIO.descripcion,
  image,
} = Astro.props;

const fullTitle = title === NEGOCIO.nombre ? `${NEGOCIO.nombre} — ${NEGOCIO.eslogan}` : `${title} | ${NEGOCIO.nombre}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Horarios (src/data/horarios.json) → schema.org OpeningHoursSpecification
const DIAS_SCHEMA: Record<string, string> = {
  lunes: 'Monday',
  martes: 'Tuesday',
  miercoles: 'Wednesday',
  jueves: 'Thursday',
  viernes: 'Friday',
  sabado: 'Saturday',
  domingo: 'Sunday',
};
const openingHours = Object.entries(horarios)
  .filter(([, h]) => h.abierto)
  .map(([dia, h]) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: DIAS_SCHEMA[dia],
    opens: h.apertura,
    closes: h.cierre,
  }));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Tipografías (cámbialas junto con los tokens en global.css) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Datos estructurados: barbería local con horarios -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BarberShop',
        name: NEGOCIO.nombre,
        description: NEGOCIO.descripcion,
        telephone: NEGOCIO.telefono,
        email: NEGOCIO.correo,
        priceRange: '$',
        address: {
          '@type': 'PostalAddress',
          streetAddress: NEGOCIO.direccion,
          addressLocality: NEGOCIO.ciudad,
          addressCountry: 'CO',
        },
        openingHoursSpecification: openingHours,
        sameAs: [NEGOCIO.instagram, NEGOCIO.facebook].filter(Boolean),
      })}
    />

    <!-- Datos estructurados adicionales por página (ej. FAQPage) -->
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script src="../scripts/animations.ts"></script>
  </body>
</html>
