---
/**
 * Hero editorial de alto contraste.
 * Dirección de arte: fotografía desaturada + viñeteado + grano, tipografía
 * condensada monumental y el ámbar como único color vivo de la composición.
 */
import { waLink, NEGOCIO } from '../scripts/site';

interface Props {
  eyebrow?: string;
  titulo: string;
  subtitulo?: string;
  /** Imagen de fondo (usa /public o URL de Unsplash con ?w=1600&q=80). */
  imagen?: string;
  ctaTexto?: string;
  ctaMensaje?: string;
  /** Si se define, el CTA primario es un ancla interna (ej. "#reservar") en vez de WhatsApp. */
  ctaHref?: string;
  ctaSecundario?: { label: string; href: string };
  /** Año del sello "EST." de la insignia. */
  desde?: string;
}

const {
  eyebrow,
  titulo,
  subtitulo,
  imagen,
  ctaTexto = 'Contáctanos por WhatsApp',
  ctaMensaje = `Hola, vengo de la página de ${NEGOCIO.nombre} y quiero más información.`,
  ctaHref,
  ctaSecundario,
  desde = '2015',
} = Astro.props;

// El título se parte por comas para construir un bloque tipográfico de
// varias líneas: la última se resalta en ámbar.
const lineas = titulo
  .split(/,\s*/)
  .map((l) => l.trim())
  .filter(Boolean);

const datos = [
  { valor: '10+', label: 'Años de oficio' },
  { valor: '4', label: 'Barberos' },
  { valor: '45', label: 'Min. promedio' },
];
---

<section class="grano vineta relative flex min-h-[92vh] items-center overflow-hidden bg-noche">
  {imagen && (
    <div class="absolute inset-0" data-parallax="0.15">
      <img
        src={imagen}
        alt=""
        class="h-[118%] w-full object-cover opacity-65 grayscale contrast-125"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  )}

  <!-- Capas de tratamiento: sombra direccional + tinte cobre + luz superior -->
  <div class="absolute inset-0 bg-gradient-to-r from-noche via-noche/85 to-noche/25"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-noche via-transparent to-noche/70"></div>
  <div class="absolute inset-0 bg-gradient-to-tr from-accent-700/40 via-transparent to-transparent mix-blend-soft-light"></div>

  <!-- Poste de barbero: franja vertical en el borde izquierdo -->
  <div class="poste-barbero absolute inset-y-0 left-0 w-1.5 opacity-80 md:w-2" aria-hidden="true"></div>

  <div class="container-ancho relative z-10 py-28 md:py-32">
    <div class="max-w-4xl" data-hero-title>
      {eyebrow && (
        <span class="micro-label micro-label-linea text-accent-400">{eyebrow}</span>
      )}

      <h1 class="titulo-monumento mt-6 text-white">
        {lineas.map((linea, i) => (
          <span class:list={['block', i === lineas.length - 1 && 'text-accent-500']}>
            {linea}
          </span>
        ))}
      </h1>

      <!-- Regla doble: cierre clásico del bloque de título -->
      <div class="regla-doble mt-8 max-w-md text-accent-500/70" aria-hidden="true"></div>

      {subtitulo && (
        <p class="mt-7 max-w-xl text-base leading-relaxed text-brand-200 md:text-lg">
          {subtitulo}
        </p>
      )}

      <div class="mt-10 flex flex-wrap items-center gap-4">
        {ctaHref ? (
          <a href={ctaHref} class="btn btn-navaja">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            {ctaTexto}
          </a>
        ) : (
          <a href={waLink(ctaMensaje)} target="_blank" rel="noopener" class="btn btn-whatsapp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.668-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
            {ctaTexto}
          </a>
        )}
        {ctaSecundario && (
          <a href={ctaSecundario.href} class="btn btn-fantasma">
            {ctaSecundario.label}
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Insignia EST.: sello de barbería tradicional -->
  <div
    class="absolute top-28 right-6 z-10 hidden text-accent-500/80 lg:block xl:right-12"
    aria-hidden="true"
  >
    <div class="sello -rotate-6">
      <span class="text-[0.55rem] font-medium tracking-[0.35em]">EST.</span>
      <span class="text-2xl font-bold tracking-[0.12em]">{desde}</span>
      <span class="text-[0.5rem] font-light tracking-[0.3em]">Bucaramanga</span>
    </div>
  </div>

  <!-- Pie del hero: datos duros + señal de scroll -->
  <div class="absolute inset-x-0 bottom-0 z-10 border-t border-white/10 bg-noche/60 backdrop-blur-sm">
    <div class="container-ancho flex items-center justify-between gap-6 py-4">
      <dl class="flex flex-wrap items-center gap-x-8 gap-y-2 sm:gap-x-12">
        {datos.map((d) => (
          <div class="flex items-baseline gap-2">
            <dt class="sr-only">{d.label}</dt>
            <dd class="font-display text-xl font-semibold text-accent-500 sm:text-2xl">{d.valor}</dd>
            <span class="text-[0.6rem] font-semibold tracking-[0.2em] text-brand-400 uppercase sm:text-[0.65rem]">
              {d.label}
            </span>
          </div>
        ))}
      </dl>
      <span class="hidden shrink-0 items-center gap-2 text-[0.6rem] font-semibold tracking-[0.25em] text-brand-500 uppercase md:inline-flex">
        Desliza
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
      </span>
    </div>
  </div>
</section>
