---
/**
 * Sección #contacto especializada para barbería:
 * datos + horarios por día (src/data/horarios.json, el mismo JSON que usa
 * el wizard) + mapa embebido. El formulario del base se reemplaza por el
 * mapa: aquí la conversión es la reserva, no el correo.
 *
 * Dirección de arte: los horarios se leen como una tabla impresa
 * (hairlines + guía punteada) y el mapa va desaturado para no romper
 * la paleta negro/ámbar.
 */
import { NEGOCIO, waLink } from '../scripts/site';
import horarios from '../data/horarios.json';

const DIAS_LABEL: Record<string, string> = {
  lunes: 'Lunes',
  martes: 'Martes',
  miercoles: 'Miércoles',
  jueves: 'Jueves',
  viernes: 'Viernes',
  sabado: 'Sábado',
  domingo: 'Domingo',
};

function hora12(hhmm: string): string {
  const [h, m] = hhmm.split(':').map(Number);
  const sufijo = h >= 12 ? 'PM' : 'AM';
  const h12 = h % 12 === 0 ? 12 : h % 12;
  return `${h12}:${String(m).padStart(2, '0')} ${sufijo}`;
}

const filasHorario = Object.entries(horarios).map(([dia, h]) => ({
  dia: DIAS_LABEL[dia],
  texto: h.abierto ? `${hora12(h.apertura)} – ${hora12(h.cierre)}` : 'Cerrado',
  abierto: h.abierto,
}));

const mapaEmbed = `https://www.google.com/maps?q=${encodeURIComponent(`${NEGOCIO.direccion}, ${NEGOCIO.ciudad}`)}&output=embed`;

const datos = [
  { label: 'Dirección', valor: `${NEGOCIO.direccion}, ${NEGOCIO.ciudad}`, href: NEGOCIO.mapsUrl },
  { label: 'Teléfono', valor: NEGOCIO.telefono, href: `tel:${NEGOCIO.telefono.replace(/\s/g, '')}` },
  { label: 'Correo', valor: NEGOCIO.correo, href: `mailto:${NEGOCIO.correo}` },
  { label: 'Instagram', valor: '@barberiaelpatron', href: NEGOCIO.instagram },
];
---

<section class="grano-sutil relative overflow-hidden bg-papel py-24 md:py-28" id="contacto">
  <div class="container-site relative">
    <div class="max-w-2xl" data-reveal>
      <span class="micro-label micro-label-linea">Ubicación y horarios</span>
      <h2 class="titulo-seccion mt-5 text-brand-950">
        Pasa por<br /><span class="text-accent-600">la silla</span>
      </h2>
      <p class="mt-5 max-w-md text-base leading-relaxed text-brand-600">
        Estamos en {NEGOCIO.direccion}, {NEGOCIO.ciudad}. Con cita tienes prioridad; sin cita te
        atendemos según disponibilidad.
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-[1fr_1.1fr]">
      <!-- Datos + horarios por día -->
      <div class="flex flex-col gap-10" data-reveal>
        <dl class="grid gap-x-6 gap-y-5 sm:grid-cols-2">
          {datos.map((fila) => (
            <div class="border-t border-brand-950/15 pt-3.5">
              <dt class="text-[0.62rem] font-bold tracking-[0.22em] text-brand-500 uppercase">
                {fila.label}
              </dt>
              <dd class="mt-1.5">
                {fila.href ? (
                  <a
                    href={fila.href}
                    target={fila.href.startsWith('http') ? '_blank' : undefined}
                    rel={fila.href.startsWith('http') ? 'noopener' : undefined}
                    class="text-sm font-medium text-brand-800 transition-colors hover:text-accent-600"
                  >
                    {fila.valor}
                  </a>
                ) : (
                  <span class="text-sm font-medium text-brand-800">{fila.valor}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>

        <!-- Tabla de horarios: formato de cartel impreso -->
        <div>
          <div class="flex items-baseline justify-between gap-4 border-b border-brand-950/25 pb-2.5">
            <p class="font-display text-lg font-semibold tracking-[0.1em] text-brand-950 uppercase">
              Horario
            </p>
            <span class="text-[0.6rem] font-bold tracking-[0.22em] text-brand-500 uppercase">
              Semana
            </span>
          </div>
          <ul id="tabla-horarios">
            {filasHorario.map((f, i) => (
              <li
                class="flex items-baseline gap-3 border-b border-brand-950/10 py-2.5 text-sm"
                data-dia={(i + 1) % 7}
              >
                <span class="font-display tracking-[0.08em] text-brand-800 uppercase">{f.dia}</span>
                <span class="guia-puntos text-brand-950" aria-hidden="true"></span>
                <span
                  class:list={[
                    'whitespace-nowrap tabular-nums',
                    f.abierto ? 'text-brand-600' : 'font-semibold text-accent-700',
                  ]}
                >
                  {f.texto}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <a
          href={waLink(`Hola, tengo una pregunta sobre ${NEGOCIO.nombre}.`)}
          target="_blank"
          rel="noopener"
          class="btn btn-whatsapp w-full py-3.5 font-display tracking-[0.1em] uppercase"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.668-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          Escribir por WhatsApp
        </a>
      </div>

      <!-- Mapa: desaturado, recupera color al interactuar -->
      <div class="group relative min-h-[26rem] overflow-hidden bg-brand-200" data-reveal>
        <iframe
          src={mapaEmbed}
          title={`Mapa: cómo llegar a ${NEGOCIO.nombre}`}
          class="h-full min-h-[26rem] w-full border-0 grayscale contrast-110 transition-all duration-300 group-hover:grayscale-0 group-focus-within:grayscale-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <!-- Marco interior: encuadra el mapa como una lámina -->
        <span
          class="pointer-events-none absolute inset-0 ring-1 ring-brand-950/15 ring-inset"
          aria-hidden="true"
        >
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  // Resalta el día de hoy en la tabla de horarios (getDay(): 0 = domingo).
  // El orden del JSON arranca en lunes, por eso cada <li> lleva data-dia.
  document
    .querySelectorAll<HTMLElement>(`#tabla-horarios [data-dia="${new Date().getDay()}"]`)
    .forEach((fila) => {
      fila.classList.add('font-bold');
      fila.querySelectorAll('span').forEach((s) => s.classList.add('!text-accent-600'));
    });
</script>
