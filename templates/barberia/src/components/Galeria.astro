---
/**
 * Sección #galeria — mosaico irregular tipo bento (no rejilla uniforme).
 * Fotos demo de Unsplash: reemplázalas por trabajos reales del cliente
 * (es la sección que más vende en una barbería).
 *
 * Cada foto declara su propio `span`: con grid-auto-flow dense las piezas
 * se empaquetan solas aunque cambie el número de imágenes.
 */
import { NEGOCIO } from '../scripts/site';

const fotos = [
  {
    src: 'https://images.unsplash.com/photo-1585747860715-2ba37e788b70?w=1200&q=80',
    alt: 'Interior de la barbería con sillas clásicas',
    span: 'lg:col-span-2 lg:row-span-2',
  },
  {
    src: 'https://images.unsplash.com/photo-1503951914875-452162b0f3f1?w=1200&q=80',
    alt: 'Afeitado clásico con navaja',
    span: 'lg:col-span-1 lg:row-span-1',
  },
  {
    src: 'https://images.unsplash.com/photo-1599351431202-1e0f0137899a?w=1200&q=80',
    alt: 'Fade de precisión con máquina',
    span: 'lg:col-span-1 lg:row-span-2',
  },
  {
    src: 'https://images.unsplash.com/photo-1621605815971-fbc98d665033?w=1200&q=80',
    alt: 'Herramientas del oficio: tijeras y navajas',
    span: 'lg:col-span-1 lg:row-span-1',
  },
  {
    src: 'https://images.unsplash.com/photo-1622286342621-4bd786c2447c?w=1200&q=80',
    alt: 'Corte en proceso, detalle de contorno',
    span: 'lg:col-span-2 lg:row-span-1',
  },
  {
    src: 'https://images.unsplash.com/photo-1512690459411-b9245aed614b?w=1200&q=80',
    alt: 'Barbero perfilando la barba de un cliente',
    span: 'lg:col-span-1 lg:row-span-2',
  },
  {
    src: 'https://images.unsplash.com/photo-1517832606299-7ae9b720a186?w=1200&q=80',
    alt: 'Cliente en la silla durante su ritual',
    span: 'lg:col-span-1 lg:row-span-2',
  },
  {
    src: 'https://images.unsplash.com/photo-1567894340315-735d7c361db0?w=1200&q=80',
    alt: 'Resultado final: corte y barba alineados',
    span: 'lg:col-span-2 lg:row-span-1',
  },
];
---

<section class="grano-sutil relative bg-white py-20 md:py-24" id="galeria">
  <div class="container-ancho relative">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl" data-reveal>
        <span class="micro-label micro-label-linea">Galería</span>
        <h2 class="titulo-seccion mt-5 text-brand-950">
          Cortes que<br /><span class="text-accent-600">hablan solos</span>
        </h2>
      </div>

      <div class="flex flex-col items-start gap-4 sm:items-end" data-reveal>
        <p class="max-w-xs text-sm leading-relaxed text-brand-600 sm:text-right">
          Trabajo real de la silla. Síguenos en Instagram para ver lo último.
        </p>
        {NEGOCIO.instagram && (
          <a
            href={NEGOCIO.instagram}
            target="_blank"
            rel="noopener"
            class="rounded-btn inline-flex items-center gap-2 border-[1.5px] border-brand-950/25 px-5 py-2.5 font-display text-xs font-semibold tracking-[0.16em] text-brand-950 uppercase transition-all duration-200 hover:border-accent-500 hover:bg-accent-500 hover:text-noche"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            @barberiaelpatron
          </a>
        )}
      </div>
    </div>

    <!-- Mosaico irregular: alturas de fila fijas + empaquetado denso -->
    <div
      class="mt-12 grid grid-flow-dense auto-rows-[8.5rem] grid-cols-2 gap-2.5 sm:auto-rows-[10rem] sm:grid-cols-3 lg:auto-rows-[11.5rem] lg:grid-cols-4"
      data-reveal-group
    >
      {fotos.map((foto, i) => (
        <figure
          class:list={[
            'foto-bn-hover group relative overflow-hidden bg-brand-100',
            foto.span,
            // En pantallas pequeñas la primera pieza manda el ritmo
            i === 0 && 'col-span-2 row-span-2 sm:col-span-2 sm:row-span-2',
          ]}
        >
          <img
            src={foto.src}
            alt={foto.alt}
            class="foto-bn h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <!-- Marco interior ámbar al pasar el cursor -->
          <span
            class="pointer-events-none absolute inset-0 ring-inset ring-accent-500/0 transition-all duration-200 group-hover:ring-2 group-hover:ring-accent-500/80"
            aria-hidden="true"
          >
          </span>
        </figure>
      ))}
    </div>
  </div>
</section>
