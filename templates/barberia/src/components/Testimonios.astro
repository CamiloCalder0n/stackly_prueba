---
/**
 * Sección #testimonios — full-bleed oscuro con fotografía de fondo
 * desaturada y viñeteada. Rompe el ritmo de secciones claras y da
 * profundidad: las citas van sobre hairlines, no dentro de cards.
 *
 * `ciudad` es señal de confianza: el benchmark de 13 barberías colombianas
 * no encontró NINGUNA que publicara nombre + ciudad en sus testimonios.
 */
import Foto from './Foto.astro';

interface Testimonio {
  nombre: string;
  ciudad: string;
  texto: string;
  detalle?: string;
}
interface Props {
  titulo?: string;
  eyebrow?: string;
  items: Testimonio[];
  /** Imagen de fondo de la sección (se desatura y oscurece). */
  imagen: ImageMetadata;
}
const {
  titulo = 'Lo que dicen nuestros clientes',
  eyebrow = 'Testimonios',
  items,
  imagen,
} = Astro.props;
---

<section class="grano vineta relative overflow-hidden bg-noche py-28 md:py-36" id="testimonios">
  <!-- Fondo fotográfico con parallax, en blanco y negro -->
  <div class="absolute inset-0" data-parallax="0.12">
    <Foto
      src={imagen}
      alt=""
      widths={[900, 1300, 1800, 2200]}
      sizes="100vw"
      class="h-[116%] object-cover opacity-35 grayscale contrast-125"
    />
  </div>
  <div class="absolute inset-0 bg-noche/62"></div>

  <div class="container-site relative z-10">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <span class="micro-label justify-center text-accent-400">{eyebrow}</span>
      <h2 class="titulo-seccion mt-5 text-white">{titulo}</h2>
      <div class="regla-doble mx-auto mt-8 w-24 text-accent-500" aria-hidden="true"></div>
    </div>

    <!-- Tres citas separadas por hairlines verticales -->
    <div
      class="mt-16 grid gap-y-12 md:grid-cols-3 md:gap-x-0 md:divide-x md:divide-white/12"
      data-reveal-group
    >
      {items.map((t, i) => (
        <figure class="flex flex-col gap-5 md:px-8 md:first:pl-0 md:last:pr-0">
          <span
            class="font-display text-5xl leading-none font-bold text-accent-500/35 tabular-nums"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </span>
          <blockquote class="text-base leading-relaxed text-brand-200 md:text-lg">
            <span class="text-accent-500" aria-hidden="true">«</span>{t.texto}<span
              class="text-accent-500"
              aria-hidden="true">»</span
            >
          </blockquote>
          <figcaption class="mt-auto border-t border-white/12 pt-4">
            <p class="font-display text-base font-semibold tracking-wide text-white uppercase">
              {t.nombre}
            </p>
            <p class="mt-1 text-[0.68rem] font-semibold tracking-[0.2em] text-accent-500/80 uppercase">
              {t.ciudad}
              {t.detalle && <> · {t.detalle}</>}
            </p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
