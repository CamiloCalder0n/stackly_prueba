---
/**
 * Sección #servicios — precios SIEMPRE visibles (posicionamiento Stackly).
 * Cada card lleva un botón "Reservar" que preselecciona el servicio en el
 * wizard (#reservar) vía data-reserva-servicio (lo escucha reserva.ts).
 */
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import { precioCOP } from '../scripts/site';

const servicios = (await getCollection('servicios'))
  .map((e) => ({ id: e.id, ...e.data }))
  .sort((a, b) => a.orden - b.orden);
---

<section class="py-20" id="servicios">
  <div class="container-site">
    <SectionHeading
      eyebrow="Servicios y precios"
      titulo="Precios claros, sin sorpresas"
      descripcion="Lo que ves es lo que pagas. Elige tu servicio y resérvalo con barbero y hora definidos."
    />

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {servicios.map((s) => (
        <article class="rounded-card flex flex-col border border-brand-200 bg-white p-6 transition-shadow hover:shadow-lg">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-display text-xl font-semibold tracking-wide text-brand-950 uppercase">{s.nombre}</h3>
            <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-brand-100 px-2.5 py-1 text-xs font-semibold text-brand-600">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {s.duracion} min
            </span>
          </div>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-brand-600">{s.descripcion}</p>
          <div class="mt-5 flex items-center justify-between gap-4 border-t border-brand-100 pt-4">
            <span class="font-display text-2xl font-bold text-accent-600">{precioCOP(s.precio)}</span>
            <a href="#reservar" class="btn btn-primary !py-2 text-sm" data-reserva-servicio={s.id}>
              Reservar
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
