---
/**
 * Sección #servicios — precios SIEMPRE visibles (posicionamiento Stackly).
 * Formato de CARTA impresa: numeración correlativa (01, 02…), guía punteada
 * entre servicio y precio y hairlines en vez de cards uniformes.
 *
 * Cada fila lleva un botón "Reservar" que preselecciona el servicio en el
 * wizard (#reservar) vía data-reserva-servicio (lo escucha reserva.ts).
 */
import { getCollection } from 'astro:content';
import { precioCOP } from '../scripts/site';

const servicios = (await getCollection('servicios'))
  .map((e) => ({ id: e.id, ...e.data }))
  .sort((a, b) => a.orden - b.orden);
---

<section class="grano-sutil relative overflow-hidden bg-papel py-24 md:py-36" id="servicios">
  <!-- Franja de poste de barbero en el borde superior -->
  <div class="poste-barbero absolute inset-x-0 top-0 h-1 opacity-70" aria-hidden="true"></div>

  <div class="container-site relative">
    <!-- Encabezado: micro-label + titular monumental + sello lateral -->
    <div class="flex flex-wrap items-end justify-between gap-8" data-reveal>
      <div class="max-w-xl">
        <span class="micro-label micro-label-linea">La carta</span>
        <h2 class="titulo-seccion mt-5 text-brand-950">
          Precios claros,<br /><span class="text-accent-600">sin sorpresas</span>
        </h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-brand-600">
          Lo que ves es lo que pagas. Elige tu servicio y resérvalo con barbero y hora definidos.
        </p>
      </div>

      <div class="hidden shrink-0 text-brand-950/25 sm:block" aria-hidden="true">
        <div class="sello rotate-3">
          <span class="text-[0.5rem] font-medium tracking-[0.3em]">Tarifas</span>
          <span class="text-lg font-bold tracking-[0.1em]">{new Date().getFullYear()}</span>
          <span class="text-[0.45rem] font-light tracking-[0.25em]">IVA incluido</span>
        </div>
      </div>
    </div>

    <!-- Carta de servicios -->
    <ul class="mt-14 border-t border-brand-950/15" data-reveal-group>
      {servicios.map((s, i) => (
        <li class="group border-b border-brand-950/15">
          <div class="flex flex-wrap items-start gap-x-5 gap-y-4 py-7 transition-transform duration-200 ease-out group-hover:translate-x-1.5 md:flex-nowrap md:py-8">
            <!-- Numeración correlativa: código de barbería tradicional -->
            <span
              class="font-display text-3xl font-semibold tabular-nums text-brand-950/20 transition-colors duration-200 group-hover:text-accent-500 md:text-4xl"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>

            <div class="min-w-0 flex-1">
              <!-- Nombre ···· precio, con guía punteada -->
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h3 class="font-display text-2xl font-semibold tracking-wide text-brand-950 uppercase transition-colors duration-200 group-hover:text-accent-700 md:text-3xl">
                  {s.nombre}
                </h3>
                <span class="guia-puntos hidden text-brand-950 sm:block" aria-hidden="true"></span>
                <span class="font-display text-2xl font-bold whitespace-nowrap tabular-nums text-accent-600 md:text-3xl">
                  {precioCOP(s.precio)}
                </span>
              </div>

              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-brand-600">
                <span class="font-semibold tracking-[0.15em] text-brand-500 uppercase">
                  {s.duracion} min
                </span>
                <span class="mx-2 text-brand-400" aria-hidden="true">·</span>
                {s.descripcion}
              </p>
            </div>

            <!-- Preselecciona el servicio en el wizard (reserva.ts) -->
            <a
              href="#reservar"
              data-reserva-servicio={s.id}
              class="rounded-btn inline-flex w-full shrink-0 items-center justify-center gap-2 self-center border-[1.5px] border-brand-950/25 px-5 py-3 font-display text-xs font-semibold tracking-[0.16em] text-brand-950 uppercase transition-all duration-200 hover:border-accent-500 hover:bg-accent-500 hover:text-noche sm:w-auto sm:py-2.5"
            >
              Reservar
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              <span class="sr-only">{s.nombre}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>

    <!-- Pie de carta: nota + hairline doble -->
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4" data-reveal>
      <p class="flex items-center gap-2.5 text-xs tracking-wide text-brand-500">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-accent-600" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        Pagas en la barbería. Efectivo, tarjeta, Nequi y Daviplata.
      </p>
      <div class="regla-doble w-full max-w-[10rem] text-brand-950" aria-hidden="true"></div>
    </div>
  </div>
</section>
