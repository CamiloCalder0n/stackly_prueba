---
/**
 * Barra sticky "Reservar" solo en móvil: mantiene la conversión a un tap
 * mientras el usuario navega. Se oculta cuando el wizard (#reservar) está
 * en pantalla para no estorbar.
 */
---

<div
  id="sticky-reserva"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-brand-950/95 p-3 backdrop-blur-md transition-transform duration-300 md:hidden"
>
  <a href="#reservar" class="btn btn-primary w-full">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    Reserva tu cita
  </a>
</div>

<script>
  // Oculta la barra cuando la sección de reserva está visible
  const barra = document.getElementById('sticky-reserva');
  const seccion = document.getElementById('reservar');

  if (barra && seccion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entrada]) => {
        barra.classList.toggle('translate-y-full', entrada.isIntersecting);
      },
      { threshold: 0.15 },
    );
    observer.observe(seccion);
  }
</script>
