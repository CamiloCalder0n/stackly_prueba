---
/**
 * Barra sticky "Reservar" solo en móvil: mantiene la conversión a un tap
 * mientras el usuario navega. Se oculta cuando el wizard (#reservar) está
 * en pantalla para no estorbar.
 */
import { getCollection } from 'astro:content';
import { precioCOP } from '../scripts/site';

// El "desde" sale del servicio más barato: nunca queda desactualizado.
const precios = (await getCollection('servicios')).map((e) => e.data.precio);
const desde = precios.length ? precioCOP(Math.min(...precios)) : null;
---

<div
  id="sticky-reserva"
  class="fixed inset-x-0 bottom-0 z-40 bg-noche/95 backdrop-blur-md transition-transform duration-300 lg:hidden"
>
  <!-- Franja de poste de barbero como borde superior -->
  <div class="poste-barbero h-[3px] opacity-90" aria-hidden="true"></div>

  <div class="flex items-center gap-3 px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]">
    <div class="min-w-0 flex-1">
      <p class="font-display text-sm font-semibold tracking-[0.1em] text-white uppercase">
        Tu silla te espera
      </p>
      <p class="mt-0.5 truncate text-[0.62rem] font-semibold tracking-[0.18em] text-accent-500 uppercase">
        {desde && <>Desde {desde} · </>}Sin pagos previos
      </p>
    </div>
    <a
      href="#reservar"
      class="rounded-btn inline-flex min-h-[44px] shrink-0 items-center gap-2 bg-accent-500 px-5 py-3 font-display text-xs font-semibold tracking-[0.14em] text-noche uppercase transition-colors duration-200 hover:bg-accent-400"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      Reservar
    </a>
  </div>
</div>

<script>
  // Oculta la barra cuando la sección de reserva está visible
  const barra = document.getElementById('sticky-reserva');
  const seccion = document.getElementById('reservar');

  if (barra && seccion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entrada]) => {
        barra.classList.toggle('translate-y-full', entrada.isIntersecting);
      },
      { threshold: 0.15 },
    );
    observer.observe(seccion);
  }
</script>
