---
/**
 * Franja tipográfica en movimiento entre secciones.
 * Rompe el ritmo vertical con un bloque compacto y de color pleno.
 * El contenido se duplica para que el bucle sea continuo; la animación
 * se detiene con prefers-reduced-motion (ver global.css).
 */
interface Props {
  items?: string[];
  /** 'ambar' = banda ámbar sobre negro · 'noche' = banda negra sobre ámbar. */
  tono?: 'ambar' | 'noche';
}

const {
  items = [
    'Corte clásico',
    'Barba con navaja',
    'Toalla caliente',
    'Fade de precisión',
    'Ritual El Patrón',
    'Sin filas',
  ],
  tono = 'ambar',
} = Astro.props;

const ambar = tono === 'ambar';
// Se recorre dos veces: la animación desplaza -50% y el bucle no salta.
const secuencia = [...items, ...items];
---

<div
  class:list={[
    'relative overflow-hidden py-3.5',
    ambar ? 'bg-accent-500 text-noche' : 'bg-noche text-accent-500',
  ]}
  aria-hidden="true"
>
  <div class="marquesina">
    {secuencia.map((item) => (
      <span class="flex shrink-0 items-center gap-8 px-8">
        <span class="font-display text-sm font-semibold tracking-[0.22em] whitespace-nowrap uppercase md:text-base">
          {item}
        </span>
        <!-- Separador: tijera estilizada como viñeta -->
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-60"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
      </span>
    ))}
  </div>
</div>
