---
/**
 * Sección #reservar — wizard de reserva en 3 pasos sin backend.
 * La interacción vive en src/scripts/reserva.ts; aquí solo se renderizan
 * las opciones (servicios y barberos de las colecciones) y se serializan
 * los datos que el script necesita.
 */
import { getCollection } from 'astro:content';
import { precioCOP } from '../scripts/site';

const servicios = (await getCollection('servicios'))
  .map((e) => ({ id: e.id, ...e.data }))
  .sort((a, b) => a.orden - b.orden);

const barberos = (await getCollection('barberos'))
  .filter((e) => e.data.activo)
  .map((e) => ({ id: e.id, ...e.data }));

// Solo lo que el script necesita para armar el mensaje
const datosWizard = {
  servicios: servicios.map(({ id, nombre, duracion, precio }) => ({ id, nombre, duracion, precio })),
  barberos: barberos.map(({ id, nombre }) => ({ id, nombre })),
};

const pasos = ['Servicio', 'Barbero', 'Fecha y hora'];
---

<section class="bg-brand-950 py-20" id="reservar">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <span class="eyebrow">Reserva en línea</span>
      <h2 class="mt-2 text-3xl font-bold text-white md:text-4xl">Reserva tu cita en 3 pasos</h2>
      <p class="mt-4 text-base leading-relaxed text-brand-300">
        Elige servicio, barbero y hora. Al final se abre WhatsApp con tu reserva lista para enviar:
        sin apps, sin registros y sin pagos por adelantado.
      </p>
    </div>

    <div id="reserva-wizard" class="rounded-card mx-auto mt-12 max-w-3xl bg-white p-6 shadow-xl md:p-10" data-reveal>
      <!-- Indicador de pasos -->
      <ol class="flex items-center justify-center gap-1 sm:gap-2" aria-label="Progreso de la reserva">
        {pasos.map((label, i) => (
          <li class="flex items-center gap-1 sm:gap-2">
            <button type="button" class="reserva-indicador" data-indicador={i + 1}>
              <span class="reserva-indicador-num" aria-hidden="true">{i + 1}</span>
              <span class="hidden text-sm font-semibold sm:inline">{label}</span>
            </button>
            {i < pasos.length - 1 && <span class="h-px w-4 bg-brand-200 sm:w-8" aria-hidden="true"></span>}
          </li>
        ))}
      </ol>

      <!-- PASO 1: servicio -->
      <div data-paso="1" class="mt-8">
        <p class="text-sm font-semibold text-brand-800">¿Qué te vas a hacer?</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {servicios.map((s) => (
            <button type="button" class="reserva-opcion" data-servicio-opcion={s.id} aria-pressed="false">
              <span class="flex items-baseline justify-between gap-3">
                <span class="font-display text-base font-semibold tracking-wide text-brand-950 uppercase">{s.nombre}</span>
                <span class="font-bold whitespace-nowrap text-accent-600">{precioCOP(s.precio)}</span>
              </span>
              <span class="mt-1 block text-xs text-brand-500">{s.duracion} min · {s.descripcion}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- PASO 2: barbero -->
      <div data-paso="2" class="mt-8 hidden">
        <div class="flex items-center justify-between gap-4">
          <p class="text-sm font-semibold text-brand-800">¿Con quién?</p>
          <button type="button" class="text-xs font-semibold text-accent-600 hover:text-accent-700" data-ir-paso="1">← Cambiar servicio</button>
        </div>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <button type="button" class="reserva-opcion flex items-center gap-4" data-barbero-opcion="cualquiera" aria-pressed="false">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-100 text-brand-500" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <span>
              <span class="block font-display text-base font-semibold tracking-wide text-brand-950 uppercase">Cualquiera</span>
              <span class="block text-xs text-brand-500">El primer barbero disponible</span>
            </span>
          </button>
          {barberos.map((b) => (
            <button type="button" class="reserva-opcion flex items-center gap-4" data-barbero-opcion={b.id} aria-pressed="false">
              <img src={b.foto} alt={`Foto de ${b.nombre}`} class="h-12 w-12 shrink-0 rounded-full object-cover" loading="lazy" />
              <span>
                <span class="block font-display text-base font-semibold tracking-wide text-brand-950 uppercase">{b.nombre}</span>
                <span class="block text-xs text-brand-500">{b.especialidad}</span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <!-- PASO 3: fecha, hora y nombre -->
      <div data-paso="3" class="mt-8 hidden">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p id="reserva-resumen" class="rounded-btn bg-brand-50 px-3 py-2 text-xs font-medium text-brand-700"></p>
          <button type="button" class="text-xs font-semibold text-accent-600 hover:text-accent-700" data-ir-paso="2">← Cambiar barbero</button>
        </div>

        <p class="mt-6 text-sm font-semibold text-brand-800">Elige el día <span class="font-normal text-brand-400">(próximos 14 días)</span></p>
        <div id="reserva-fechas" class="mt-3 flex gap-2 overflow-x-auto pb-2"></div>

        <p class="mt-5 text-sm font-semibold text-brand-800">Elige la hora</p>
        <div id="reserva-franjas" class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-5"></div>

        <div class="mt-6">
          <label for="reserva-nombre" class="mb-1.5 block text-sm font-semibold text-brand-800">Tu nombre</label>
          <input
            id="reserva-nombre"
            type="text"
            autocomplete="name"
            placeholder="¿A nombre de quién agendamos?"
            class="w-full rounded-btn border border-brand-200 px-4 py-2.5 text-sm outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-100"
          />
        </div>

        <button type="button" id="reserva-confirmar" class="btn btn-whatsapp mt-5 w-full disabled:cursor-not-allowed disabled:opacity-40" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.074-.149-.668-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          Confirmar por WhatsApp
        </button>
        <p class="mt-3 text-center text-xs text-brand-400">
          Se abre WhatsApp con tu reserva lista para enviar. Pagas en la barbería.
        </p>
      </div>
    </div>
  </div>

  <!-- Datos para el script del wizard (src/scripts/reserva.ts) -->
  <script type="application/json" id="reserva-data" set:html={JSON.stringify(datosWizard)} />
</section>

<script src="../scripts/reserva.ts"></script>

<style is:global>
  /* Opciones grandes del wizard (servicio / barbero) */
  .reserva-opcion {
    text-align: left;
    border: 1.5px solid var(--color-brand-200);
    border-radius: var(--radius-card);
    padding: 0.875rem 1rem;
    background: #fff;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, transform 0.15s ease;
  }
  .reserva-opcion:hover {
    border-color: var(--color-accent-500);
    transform: translateY(-1px);
  }
  .reserva-opcion.activo {
    border-color: var(--color-accent-500);
    background: var(--color-accent-50);
    box-shadow: 0 0 0 1px var(--color-accent-500);
  }

  /* Chips de fecha y franja horaria (los genera reserva.ts) */
  .reserva-chip {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid var(--color-brand-200);
    border-radius: var(--radius-btn);
    padding: 0.5rem 0.75rem;
    background: #fff;
    font-size: 0.85rem;
    color: var(--color-brand-800);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .reserva-chip:hover {
    border-color: var(--color-accent-500);
  }
  .reserva-chip.activo {
    border-color: var(--color-accent-500);
    background: var(--color-accent-500);
    color: var(--color-brand-950);
    font-weight: 600;
  }

  /* Indicador de pasos */
  .reserva-indicador {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-brand-400);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0.25rem;
  }
  .reserva-indicador-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 9999px;
    border: 1.5px solid var(--color-brand-200);
    font-size: 0.8rem;
    font-weight: 700;
    transition: all 0.2s ease;
  }
  .reserva-indicador.activo {
    color: var(--color-brand-950);
  }
  .reserva-indicador.activo .reserva-indicador-num {
    border-color: var(--color-accent-500);
    background: var(--color-accent-500);
    color: var(--color-brand-950);
  }
  .reserva-indicador.hecho {
    color: var(--color-brand-700);
  }
  .reserva-indicador.hecho .reserva-indicador-num {
    border-color: var(--color-accent-500);
    color: var(--color-accent-600);
  }
</style>
