---
/**
 * Pie de página: cierre editorial con monograma, sello EST. y
 * franja de poste de barbero como remate inferior.
 */
import { NEGOCIO } from '../scripts/site';

interface Props {
  links?: { label: string; href: string }[];
  desde?: string;
}
const { links = [], desde = '2015' } = Astro.props;
const year = new Date().getFullYear();

const monograma = NEGOCIO.nombre
  .split(' ')
  .filter((p) => p.length > 2)
  .map((p) => p[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<footer class="grano relative overflow-hidden bg-noche text-brand-400">
  <div class="container-ancho relative grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr] md:py-20">
    <div>
      <div class="flex items-center gap-3">
        <span
          class="flex h-11 w-11 shrink-0 items-center justify-center bg-accent-500 font-display text-lg font-bold text-noche"
          aria-hidden="true"
        >
          {monograma}
        </span>
        <span class="leading-none">
          <span class="block font-display text-xl font-semibold tracking-[0.08em] text-white uppercase">
            {NEGOCIO.nombre}
          </span>
          <span class="mt-1.5 block text-[0.55rem] font-semibold tracking-[0.3em] text-accent-500/90 uppercase">
            Est. {desde} · {NEGOCIO.ciudad}
          </span>
        </span>
      </div>

      <p class="mt-6 max-w-xs text-sm leading-relaxed text-brand-400">{NEGOCIO.eslogan}</p>

      <div class="mt-6 flex gap-3">
        {NEGOCIO.instagram && (
          <a
            href={NEGOCIO.instagram}
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
            class="flex h-10 w-10 items-center justify-center rounded-sm border border-white/12 text-brand-300 transition-colors duration-200 hover:border-accent-500 hover:text-accent-500"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        )}
        {NEGOCIO.facebook && (
          <a
            href={NEGOCIO.facebook}
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
            class="flex h-10 w-10 items-center justify-center rounded-sm border border-white/12 text-brand-300 transition-colors duration-200 hover:border-accent-500 hover:text-accent-500"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        )}
      </div>
    </div>

    {links.length > 0 && (
      <nav aria-label="Enlaces del pie de página">
        <p class="text-[0.6rem] font-bold tracking-[0.26em] text-accent-500/80 uppercase">Navegación</p>
        <ul class="mt-5 space-y-3">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class="font-display text-sm tracking-[0.1em] text-brand-300 uppercase transition-colors duration-200 hover:text-white"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div>
      <p class="text-[0.6rem] font-bold tracking-[0.26em] text-accent-500/80 uppercase">Contacto</p>
      <ul class="mt-5 space-y-3 text-sm">
        <li>{NEGOCIO.direccion}, {NEGOCIO.ciudad}</li>
        <li class="text-brand-500">{NEGOCIO.horario}</li>
        <li>
          <a href={`tel:${NEGOCIO.telefono.replace(/\s/g, '')}`} class="transition-colors duration-200 hover:text-white">
            {NEGOCIO.telefono}
          </a>
        </li>
        <li>
          <a href={`mailto:${NEGOCIO.correo}`} class="transition-colors duration-200 hover:text-white">
            {NEGOCIO.correo}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div
      class="container-ancho flex flex-col items-center justify-between gap-2 py-6 text-[0.7rem] tracking-wide text-brand-500 sm:flex-row"
    >
      <p>© {year} {NEGOCIO.nombre}. Todos los derechos reservados.</p>
      <p>
        Hecho por
        <a href="https://stackly.co" class="font-semibold text-brand-400 transition-colors duration-200 hover:text-accent-500">
          Stackly
        </a>
      </p>
    </div>
  </div>

  <!-- Remate: poste de barbero a lo ancho -->
  <div class="poste-barbero h-1.5 opacity-90" aria-hidden="true"></div>
</footer>
