---
/**
 * Sección #equipo — un card por barbero (colección `barberos`, solo activos).
 * Reservar con un barbero específico baja el no-show: el cliente sabe con
 * quién queda y el barbero sabe quién le llega.
 */
import { getCollection } from 'astro:content';

const barberos = (await getCollection('barberos'))
  .filter((e) => e.data.activo)
  .map((e) => ({ id: e.id, ...e.data }));
---

<section class="bg-brand-950 py-20" id="equipo">
  <div class="container-site">
    <div class="max-w-2xl" data-reveal>
      <span class="eyebrow">El equipo</span>
      <h2 class="mt-2 text-3xl font-bold text-white md:text-4xl">Barberos con oficio</h2>
      <p class="mt-4 text-base leading-relaxed text-brand-300">
        Elige a tu barbero de confianza o déjate sorprender: todos dominan la silla.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
      {barberos.map((b) => (
        <article class="rounded-card group overflow-hidden bg-brand-900 ring-1 ring-white/10">
          <div class="aspect-[4/5] overflow-hidden">
            <img
              src={b.foto}
              alt={`${b.nombre}, barbero de Barbería El Patrón`}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="p-5">
            <h3 class="font-display text-lg font-semibold tracking-wide text-white uppercase">{b.nombre}</h3>
            <p class="mt-1 text-sm text-brand-400">{b.especialidad}</p>
            <div class="mt-4 flex items-center justify-between gap-3">
              {b.instagram && (
                <a
                  href={b.instagram}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Instagram de ${b.nombre}`}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-300 transition-colors hover:text-accent-400"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                  Instagram
                </a>
              )}
              <a href="#reservar" class="text-xs font-bold text-accent-500 uppercase hover:text-accent-400">
                Reservar →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
